# Vigil backend configuration.
# Copy this file to .env and set the values that have no safe default.
# Settings load from the environment and from .env in the current directory.

# --- Application ---
APP_NAME=Vigil
APP_ENV=development          # development | staging | production | test
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vigil
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Security ---
# Required. Generate with: openssl rand -hex 32
# A production boot refuses the public default and this placeholder.
SECRET_KEY=CHANGEME-generate-with-openssl-rand-hex-32
PAIRING_CODE_TTL_SECONDS=300
DEVICE_TOKEN_SECRET=CHANGEME-device-token-secret
CORS_ORIGINS=["http://localhost:5173"]

# --- Tier 1: Jev triage classifier ---
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-classifier-v1

# --- Tier 2: fast model (triage metadata, compaction summary) ---
FAST_LLM_BASE_URL=https://api.openai.com/v1
FAST_LLM_API_KEY=
FAST_LLM_MODEL=gpt-4o-mini

# --- Tier 3: reasoning model (tool loop) ---
REASONING_LLM_BASE_URL=https://api.openai.com/v1
REASONING_LLM_API_KEY=
REASONING_LLM_MODEL=gpt-4o

# --- Local embedding model (bge-small-en-v1.5, int8 ONNX, 384 dimensions) ---
# The embedding path is local. It calls no API.
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_ARTIFACT_REPO=Xenova/bge-small-en-v1.5
EMBEDDING_ARTIFACT_REVISION=ea104dacec62c0de699686887e3f920caeb4f3e3
EMBEDDING_ARTIFACT_FILE=onnx/model_int8.onnx
EMBEDDING_TOKENIZER_FILE=tokenizer.json
EMBEDDING_MODEL_DIR=~/.cache/vigil/embedding
EMBEDDING_MAX_TOKENS=512
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMBEDDING_IDLE_UNLOAD_SECONDS=300
EMBEDDING_INTRA_OP_THREADS=2
EMBEDDING_MAX_BATCH=4
EMBEDDING_MAX_BATCH_TOKENS=1024
EMBEDDING_ENCODE_SUBPROCESS=true

# --- Memory retrieval (cosine similarity with exponential time decay) ---
MEMORY_RETRIEVAL_HALF_LIFE_DAYS=30.0
MEMORY_RETRIEVAL_FLOOR=0.35
MEMORY_RETRIEVAL_OVERRIDE_THRESHOLD=0.65
MEMORY_RETRIEVAL_MIN_SIMILARITY=0.25
MEMORY_RETRIEVAL_CANDIDATE_K=50
MEMORY_RETRIEVAL_TOP_N=8
MEMORY_RETRIEVAL_EF_SEARCH=200
MEMORY_RETRIEVAL_ITERATIVE_SCAN=relaxed_order   # off | relaxed_order | strict_order

# --- Docker sandbox runner ---
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=vigil-sandbox:latest
WORKSPACE_BASE_PATH=/var/vigil/workspaces

# --- Logging ---
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | console

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_HEADER_NAME=Idempotency-Key

# --- Background jobs and worker ---
JOB_POLL_INTERVAL_SECONDS=5
JOB_LOCK_TIMEOUT_SECONDS=300

# --- Notifications ---
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=vigil-notifications
NTFY_AUTH_TOKEN=
