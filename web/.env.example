# Base path for the FastAPI backend. Defaults to the dev-server proxy in vite.config.ts.
VITE_API_BASE=/api/v1

# Dev proxy target. Only read by vite.config.ts, never shipped to the bundle.
VITE_API_PROXY=http://127.0.0.1:8000

# Build-time switch for fixture-backed simulation. Must be "1" or absent, never set at runtime.
# VITE_VIGIL_MOCK=1
