eded=_as_probability(needed, 0.0) if needed is not None else 0.0,\n363:                 user_fact=_as_probability(probabilities.get(\"user_fact\")),\n364:                 bulk=_as_probability(probabilities.get(\"bulk\")),\n365:                 verdict=decide_verdict(probabilities),\n366:             )\n367: \n368:     unscored = frozenset(unit.unit_id for unit in units if unit.unit_id not in scores)\n369:     return Tier1Result(\n370:         scores=scores,"}
