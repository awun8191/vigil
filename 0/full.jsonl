   return model\n167:         model = UserModel(id=user_id, display_name=display_name, settings={})\n168:         self.session.add(model)\n169:         await self.session.flush()\n170:         return model\n171: \n172:     async def get_device_by_token_hash(self, token_hash: str) -> DeviceDTO | None:\n173:         result = await self.session.execute(\n174:             select(DeviceModel).where(DeviceModel.token_hash == token_hash)\n175:         )\n176:         model = result.scalars().first()\n177:         if model is None or model.revoked_at is not None:\n178:             return None\n179:         return self._device_dto(model)\n180: \n181:     async def create_device(self, data: DeviceCreateDTO) -> DeviceDTO:\n182:         model = DeviceModel(\n183:             id=uuid4(),\n184:             user_id=data.user_id,\n185:             name=data.name,\n186:             token_hash=data.token_hash,\n187:             push_token=REDACTED,\n188:             last_seen_at=_now(),\n189:             revoked_at=None,\n190:             created_at=_now(),\n191:         )\n192:         self.session.add(model)\n193:         await self.session.flush()\n194:         return self._device_dto(model)\n195: \n196:     async def update_device_last_seen(self, device_id: UUID, seen_at: datetime) -> None:\n197:         await self.session.execute(\n198:             update(DeviceModel).where(DeviceModel.id == device_id).values(last_seen_at=seen_at)\n199:         )\n200: \n201:     async def revoke_device(self, device_id: UUID) -> bool:\n202:         result = await self.session.execute(\n203:             update(DeviceModel)\n204:             .where(DeviceModel.id == device_id, DeviceModel.revoked_at.is_(None))\n205:             .values(revoked_at=_now())\n206:         )\n207:         return int(getattr(result, \"rowcount\", 0) or 0) > 0\n208: \n209:     async def get_or_create_default_user(self, display_name: str = \"Default User\") -> UserDTO:\n210:         return self._user_dto(await self._ensure_user_row(DEFAULT_USER_ID, display_name))\n211: \n212:     async def get_user_by_id(self, user_id: UUID) -> UserDTO | None:\n213:         model = await self.session.get(UserModel, user_id)\n214:         return None if model is None else self._user_dto(model)\n215: \n216:     async def store_pairing_code(self, pairing: PairingCodeDTO) -> None:\n217:         PAIRING_CODES[pairing.code] = pairing\n218: \n219:     async def validate_and_consume_pairing_code(self, code: str) -> PairingCodeDTO | None:\n220:         pairing = PAIRING_CODES.pop(code, None)\n221:         if not pairing:\n222:             return None\n223:         if _now() > pairing.expires_at:\n224:             return None\n225:         return pairing\n226: \n227: \n228: __all__ = [\n229:     \"DEFAULT_USER_ID\",\n230:     \"AuthStore\",\n231:     \"InMemoryAuthStore\",\n232:     \"SqlAuthStore\",\n233: ]"}
