ll);\n81:   const [finalisedRunId, setFinalisedRunId] = useState<string | null>(null);\n82:   const optimisticIdRef = useRef<string | null>(null);\n83:   const sessionIdRef = useRef<string | null>(sessionId);\n84: \n85:   const subscription = useRun(activeRunId);\n86:   const steps = subscription.steps;\n87:   const run = subscription.run;\n88: \n89:   // Live typing text: only concatenate message_delta frames from the current model generation\n90:   // turn (after the latest thought / tool_call / tool_result step), so intermediate narration\n91:   // from earlier tool iterations never gets smashed onto the front of the final reply.\n92:   const streamedText = useMemo(() => {\n93:     let lastBoundary = -1;\n94:     for (let i = steps.length - 1; i >= 0; i -= 1) {\n95:       const t = steps[i]?.event_type;\n96:       if (t && t !== 'message_delta' && t !== 'run_completed' && t !== 'run_failed') {\n97:         lastBoundary = i;\n98:         break;\n99:       }\n100:     }"}
