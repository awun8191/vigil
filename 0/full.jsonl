{"step_index":21,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:45:52Z","content":"Created At: 2026-11-10T17:45:52Z\nCompleted At: 2026-11-10T17:45:52Z\nShowing lines 1-300 of 757\n1: \"\"\"External MCP server client: stdio and SSE transport, handshake, tool discovery.\n2: \n3: The stdio transport speaks a minimal newline-delimited JSON-RPC dialect: one\n4: ``initialize`` request carrying ``protocolVersion``, ``capabilities`` and\n5: ``clientInfo``, the ``notifications/initialized`` notification, then the work\n6: request (``tools/list`` or ``tools/call``). Each message is a single JSON object\n7: per line, matched by ``id``.\n8: \n9: The SSE transport does not do that. It posts one ``tools/list`` or ``tools/call``\n10: request and reads the answer, with no ``initialize`` request and no\n11: ``notifications/initialized`` notification, so a server that enforces the\n12: handshake rejects it. TODO(StreamMCP): open the session (the ``GET`` event\n13: stream), keep the session id it returns, echo that id on every ``POST``, and\n14: send the initialize request and the initialized notification before the work\n15: request.\n16: \n17: Only the background worker calls this module. Request handlers never spawn a\n18: process: registration enqueues a ``discover_mcp_tools`` job and returns\n19: 202, and the worker runs discovery there.\n20: \"\"\"\n21: from __future__ import annotations\n22: \n23: import asyncio\n24: import contextlib\n25: import json\n26: import shlex\n27: from asyncio.subprocess import PIPE\n28: from dataclasses import dataclass, field\n29: from typing import Any\n30: \n31: import httpx\n32: \n33: #: Transports that ``discover_tools`` accepts.\n34: SUPPORTED_TRANSPORTS: tuple[str, ...] = (\"stdio\", \"sse\")\n35: \n36: #: Time limit of one handshake request round trip, in seconds.\n37: HANDSHAKE_TIMEOUT_SECONDS = 10.0\n38: \n39: #: Time limit of the SSE handshake stream, in seconds.\n40: SSE_TIMEOUT_SECONDS = 10.0\n41: \n42: #: Largest single protocol line accepted from a third party server.\n43: MAX_LINE_BYTES = 1_048_576\n44: \n45: #: Protocol version announced in the initialize request.\n46: MCP_PROTOCOL_VERSION = \"2024-11-05\"\n47: \n48: #: Client name announced in ``clientInfo``.\n49: MCP_CLIENT_NAME = \"vigil\"\n50: \n51: #: Client version announced in ``clientInfo``.\n52: MCP_CLIENT_VERSION = \"1.0\"\n53: \n54: #: Trailing bytes of a server's stderr kept for the error message.\n55: STDERR_TAIL_BYTES = 4096\n56: \n57: #: Longest wait for a terminated server to exit before it is killed, in seconds.\n58: STOP_TIMEOUT_SECONDS = 5.0\n59: \n60: #: Longest bounded wait for the stderr drain to reach EOF before the tail is read.\n61: STDERR_DRAIN_JOIN_SECONDS = 0.2\n62: \n63: \n64: class MCPHandshakeError(ValueError):\n65:     \"\"\"A third party MCP server failed the handshake. The message names the reason.\"\"\"\n66: \n67: \n68: class MCPToolCollisionError(ValueError):\n69:     \"\"\"A discovered tool name collides with a built-in tool.\"\"\"\n70: \n71: \n72: @dataclass(frozen=True)\n73: class MCPServerConfig:\n74:     \"\"\"Connection parameters of one third party MCP server.\"\"\"\n75: \n76:     name: str\n77:     transport: str  # \"stdio\" or \"sse\"\n78:     command: str | None = None\n79:     url: str | None = None\n80: \n81: \n82: @dataclass(frozen=True)\n83: class MCPToolDefinition:\n84:     \"\"\"One tool discovered on a third party MCP server.\"\"\"\n85: \n86:     name: str\n87:     description: str = \"\"\n88:     input_schema: dict[str, Any] = field(default_factory=dict)\n89:     level: str = \"external\"\n90: \n91: \n92: def _normalize_tools(raw: Any) -> list[dict[str, Any]]:\n93:     \"\"\"Validate a raw tool list. Every entry needs a non-empty string name.\"\"\"\n94:     if not isinstance(raw, list):\n95:         raise MCPHandshakeError(\n96:             \"handshake failed: the tools/list result holds no tool list\"\n97:         )\n98:     tools: list[dict[str, Any]] = []\n99:     for entry in raw:\n100:         if not isinstance(entry, dict):\n101:             raise MCPHandshakeError(\n102:                 \"handshake failed: a tools/list entry is not an object\"\n103:             )\n104:         name = entry.get(\"name\")\n105:         if not isinstance(name, str) or not name.strip():\n106:             raise MCPHandshakeError(\n107:                 \"handshake failed: a tools/list entry has no name\"\n108:             )\n109:         tools.append(\n110:             {\n111:                 \"name\": name,\n112:                 \"description\": entry.get(\"description\", \"\"),\n113:                 \"input_schema\": entry.get(\"input_schema\", {}),\n114:             }\n115:         )\n116:     return tools\n117: \n118: \n119: class _StderrTail:\n120:     \"\"\"Bounded tail of a server's stderr, kept for the error message only.\"\"\"\n121: \n122:     def __init__(self, limit: int = STDERR_TAIL_BYTES) -> None:\n123:         self._limit = limit\n124:         self._buffer = bytearray()\n125: \n126:     def feed(self, chunk: bytes) -> None:\n127:         self._buffer.extend(chunk)\n128:         excess = len(self._buffer) - self._limit\n129:         if excess > 0:\n130:             del self._buffer[:excess]\n131: \n132:     def text(self) -> str:\n133:         return bytes(self._buffer).decode(\"utf-8\", \"replace\").strip()\n134: \n135: \n136: async def _drain_stderr(\n137:     stream: asyncio.StreamReader | None,\n138:     tail: _StderrTail,\n139: ) -> None:\n140:     \"\"\"Read a server's stderr until EOF so a chatty server never blocks the pipe.\n141: \n142:     A server writing more than one pipe buffer of diagnostics would block on its\n143:     own ``write`` call, never answer the request, and hang the call until the\n144:     timeout. Draining concurrently is the only way to keep the exchange moving.\n145:     \"\"\"\n146:     if stream is None:\n147:         return\n148:     while True:\n149:         chunk = await stream.read(4096)\n150:         if not chunk:\n151:             return\n152:         tail.feed(chunk)\n153: \n154: \n155: def _initialize_params() -> dict[str, Any]:\n156:     \"\"\"Build the initialize params the MCP schema requires.\"\"\"\n157:     return {\n158:         \"protocolVersion\": MCP_PROTOCOL_VERSION,\n159:         \"capabilities\": {},\n160:         \"clientInfo\": {\"name\": MCP_CLIENT_NAME, \"version\": MCP_CLIENT_VERSION},\n161:     }\n162: \n163: \n164: async def _write_message(\n165:     proc: asyncio.subprocess.Process,\n166:     message: dict[str, Any],\n167:     step: str,\n168: ) -> None:\n169:     \"\"\"Write one JSON-RPC line to the server's stdin.\"\"\"\n170:     line = (json.dumps(message) + \"\\n\").encode(\"utf-8\")\n171:     try:\n172:         proc.stdin.write(line)  # type: ignore[union-attr]\n173:         await proc.stdin.drain()  # type: ignore[union-attr]\n174:     except (BrokenPipeError, ConnectionResetError) as exc:\n175:         code = proc.returncode\n176:         raise MCPHandshakeError(\n177:             f\"stdio handshake failed during {step}: \"\n178:             f\"the process exited with code {code}\"\n179:         ) from exc\n180: \n181: \n182: async def _exchange(\n183:     proc: asyncio.subprocess.Process,\n184:     message: dict[str, Any],\n185:     timeout: float,\n186:     step: str,\n187: ) -> dict[str, Any]:\n188:     \"\"\"Send one request line and return the response object with the matching id.\n189: \n190:     A server may interleave notifications (logging, progress) with responses,\n191:     so lines without our id are skipped until the answer arrives. The whole\n192:     wait, not each line, is bounded by ``timeout``.\n193:     \"\"\"\n194:     await _write_message(proc, message, step)\n195:     loop = asyncio.get_running_loop()\n196:     deadline = loop.time() + timeout\n197:     while True:\n198:         remaining = deadline - loop.time()\n199:         if remaining <= 0.0:\n200:             raise MCPHandshakeError(\n201:                 f\"stdio handshake failed during {step}: \"\n202:                 f\"no response within {timeout:g} seconds\"\n203:             )\n204:         try:\n205:             raw = await asyncio.wait_for(proc.stdout.readline(), remaining)  # type: ignore[union-attr]\n206:         except TimeoutError as exc:\n207:             raise MCPHandshakeError(\n208:                 f\"stdio handshake failed during {step}: \"\n209:                 f\"no response within {timeout:g} seconds\"\n210:             ) from exc\n211:         if not raw:\n212:             code = proc.returncode\n213:             raise MCPHandshakeError(\n214:                 f\"stdio handshake failed during {step}: \"\n215:                 f\"the process exited with code {code} before it answered\"\n216:             )\n217:         try:\n218:             response = json.loads(raw.decode(\"utf-8\"))\n219:         except (UnicodeDecodeError, ValueError) as exc:\n220:             raise MCPHandshakeError(\n221:                 f\"stdio handshake failed during {step}: invalid JSON response\"\n222:             ) from exc\n223:         if not isinstance(response, dict):\n224:             raise MCPHandshakeError(\n225:                 f\"stdio handshake failed during {step}: \"\n226:                 \"the response is not an object\"\n227:             )\n228:         if response.get(\"id\") != message[\"id\"]:\n229:             # A notification (no id) or a response to another request.\n230:             continue\n231:         break\n232:     if \"error\" in response:\n233:         raise MCPHandshakeError(\n234:             f\"stdio handshake failed during {step}: \"\n235:             f\"the server returned an error: {response['error']}\"\n236:         )\n237:     result = response.get(\"result\")\n238:     if not isinstance(result, dict):\n239:         raise MCPHandshakeError(\n240:             f\"stdio handshake failed during {step}: the result is not an object\"\n241:         )\n242:     return result\n243: \n244: \n245: async def _handshake(\n246:     proc: asyncio.subprocess.Process,\n247:     timeout: float,\n248: ) -> None:\n249:     \"\"\"Run the schema-correct initialize exchange.\n250: \n251:     The request carries ``protocolVersion``, ``capabilities`` and ``clientInfo``;\n252:     the response is followed by the ``notifications/initialized`` notification\n253:     the schema requires before any other request.\n254:     \"\"\"\n255:     await _exchange(\n256:         proc,\n257:         {\n258:             \"jsonrpc\": \"2.0\",\n259:             \"id\": 1,\n260:             \"method\": \"initialize\",\n261:             \"params\": _initialize_params(),\n262:         },\n263:         timeout,\n264:         \"initialize\",\n265:     )\n266:     await _write_message(\n267:         proc,\n268:         {\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"},\n269:         \"notifications/initialized\",\n270:     )\n271: \n272: \n273: async def _spawn_stdio(\n274:     command: str,\n275: ) -> tuple[asyncio.subprocess.Process, _StderrTail, asyncio.Task[None]]:\n276:     \"\"\"Start a stdio server and drain its stderr concurrently from the first byte.\"\"\"\n277:     try:\n278:         argv = shlex.split(command, posix=True)\n279:     except ValueError as exc:\n280:         raise MCPHandshakeError(\n281:             f\"stdio handshake failed: cannot parse the command: {exc}\"\n282:         ) from exc\n283:     if not argv:\n284:         raise MCPHandshakeError(\"stdio handshake failed: the command is empty\")\n285:     try:\n286:         proc = await asyncio.create_subprocess_exec(\n287:             *argv,\n288:             stdin=PIPE,\n289:             stdout=PIPE,\n290:             stderr=PIPE,\n291:             limit=MAX_LINE_BYTES,\n292:         )\n293:     except (FileNotFoundError, PermissionError, OSError) as exc:\n294:         raise MCPHandshakeError(\n295:             f\"stdio handshake failed: cannot start the process: {exc}\"\n296:         ) from exc\n297:     tail = _StderrTail()\n298:     stderr_task = asyncio.create_task(_drain_stderr(proc.stderr, tail))\n299:     return proc, tail, stderr_task\n300: "}
