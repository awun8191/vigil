{"step_index":369,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:14:19Z","content":"Created At: 2026-11-11T10:14:19Z\nCompleted At: 2026-11-11T10:14:19Z\nShowing lines 631-720 of 941\n631:             stop: Any = getattr(self.sandbox, \"stop_and_remove\", None)\n632:             if callable(stop):\n633:                 try:\n634:                     await stop(container_id)\n635:                 except Exception:  # noqa: BLE001\n636:                     pass\n637: \n638:     async def _create_container(self) -> str:\n639:         \"\"\"Create a live container through the runner spec path when it exists.\"\"\"\n640:         create: Any = getattr(self.sandbox, \"create\", None)\n641:         validate: Any = getattr(self.sandbox, \"validate_spec\", None)\n642:         if callable(create) and callable(validate):\n643:             from src.integrations.sandbox.contract import resolve_image_allowlist\n644: \n645:             image = resolve_image_allowlist(self.settings)[0]\n646:             spec = validate(\n647:                 {\n648:                     \"image\": image,\n649:                     \"command\": [\"sleep\", str(SANDBOX_IDLE_SECONDS)],\n650:                     \"timeout_seconds\": SANDBOX_IDLE_SECONDS,\n651:                 }\n652:             )\n653:             created = await create(spec, str(self.run_id))\n654:             return str(created.container_id)\n655: \n656:         created = await self.sandbox.create_container(\n657:             run_id=str(self.run_id), timeout_seconds=SANDBOX_IDLE_SECONDS\n658:         )\n659:         return str(created.container_id)\n660: \n661:     async def execute(\n662:         self, name: str, arguments: Mapping[str, Any]\n663:     ) -> Mapping[str, Any]:\n664:         \"\"\"Run one local tool in the sandbox and return its result.\"\"\"\n665:         from src.modules.runs.tools import ToolContext, invoke_tool\n666: \n667:         if name in self.HOST_ONLY_TOOLS and self._container_id is None:\n668:             container_id = \"host-only\"\n669:         else:\n670:             container_id = await self.start()\n671:         context = ToolContext(\n672:             runner=self.sandbox,\n673:             container_id=container_id,\n674:             delivery_dir=Path(self.delivery_dir),\n675:         )\n676:         result = await invoke_tool(name, dict(arguments), context)\n677:         if result.ok and result.artifact_ref:\n678:             await self._register_artifact(name, result)\n679:         return result.model_dump()\n680: \n681:     async def execute_external(\n682:         self, name: str, arguments: Mapping[str, Any]\n683:     ) -> Mapping[str, Any]:\n684:         \"\"\"Run one approved external tool.\n685: \n686:         A tool the harness declares itself runs through the harness, so its own\n687:         handler answers. ``ask_user`` is the only such tool today: its contract\n688:         is a pending marker, and sending it to the connector host would run it\n689:         on whichever third party server happened to own the name, or fail\n690:         closed for a name no server owns. Only a name the harness does not\n691:         declare goes to the connector host.\n692:         \"\"\"\n693:         from src.modules.runs.tools import TOOLS\n694: \n695:         if name in TOOLS:\n696:             return await self.execute(name, dict(arguments))\n697:         result = await self.mcp_host.execute_tool(\n698:             self.connector_id, name, dict(arguments)\n699:         )\n700:         return {\n701:             \"ok\": not result.is_error,\n702:             \"content\": result.output,\n703:             \"artifact_ref\": None,\n704:             \"error\": result.output if result.is_error else None,\n705:         }\n706: \n707:     async def _register_artifact(self, tool_name: str, result: Any) -> None:\n708:         \"\"\"Write one artifact row for a file that a tool delivered.\n709: \n710:         Uses ArtifactsService so both database-backed and sessionless runs\n711:         register the artifact with a preview snippet for rich UI rendering.\n712:         \"\"\"\n713:         if not result.artifact_ref:\n714:             return\n715:         from src.modules.artifacts.repository import ArtifactCreateDTO\n716:         from src.modules.artifacts.service import ArtifactsService\n717: \n718:         path = Path(str(result.artifact_ref))\n719:         is_file = path.is_file()\n720:         size_bytes = path.stat().st_size if is_file else 0"}
