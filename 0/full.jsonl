{"step_index":34,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:46:44Z","content":"Created At: 2026-11-10T17:46:44Z\nCompleted At: 2026-11-10T17:46:45Z\nShowing lines 1-77 of 77\n1: import { ChevronDown } from 'lucide-react';\n2: import { AnimatePresence, motion } from 'framer-motion';\n3: import { useState, type ReactNode } from 'react';\n4: \n5: const spring = { type: 'spring' as const, stiffness: 400, damping: 30 };\n6: \n7: interface Props {\n8:   /** Round source avatar, from SourceAvatar. */\n9:   avatar: ReactNode;\n10:   /** Small plain-language line above the description, e.g. \"Email · 2m ago\". */\n11:   meta: ReactNode;\n12:   /** The one description line always visible while closed. */\n13:   title: ReactNode;\n14:   /** Everything the card reveals when opened. */\n15:   children: ReactNode;\n16:   /** Start open; defaults closed like a phone notification stack. */\n17:   defaultOpen?: boolean;\n18:   /** Accessible label for the reveal region. */\n19:   bodyId: string;\n20: }\n21: \n22: /**\n23:  * The standardized card shell every surface reuses: a phone-notification pill that opens downward\n24:  * into its details. Monochrome, sharp-cornered at the shell scale, animated with one spring.\n25:  */\n26: export function NotificationCard({ avatar, meta, title, children, defaultOpen = false, bodyId }: Props) {\n27:   const [open, setOpen] = useState(defaultOpen);\n28: \n29:   return (\n30:     <motion.section layout=\"position\" className=\"card rounded-[18px]\" initial={false}>\n31:       <button\n32:         type=\"button\"\n33:         onClick={() => setOpen((value) => !value)}\n34:         aria-expanded={open}\n35:         aria-controls={open ? bodyId : undefined}\n36:         className=\"flex w-full items-center gap-3.5 px-4 py-3.5 text-left md:px-5\"\n37:       >\n38:         {avatar}\n39:         <span className=\"min-w-0 flex-1\">\n40:           <span className=\"flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--text-muted)]\">\n41:             {meta}\n42:           </span>\n43:           <span className=\"mt-0.5 block truncate text-[15px] font-semibold leading-snug tracking-[-0.01em] text-[var(--text)]\">\n44:             {title}\n45:           </span>\n46:         </span>\n47:         <motion.span\n48:           animate={{ rotate: open ? 180 : 0 }}\n49:           transition={spring}\n50:           className=\"grid h-8 w-8 shrink-0 place-items-center rounded-full text-[var(--text-muted)]\"\n51:         >\n52:           <ChevronDown size={16} strokeWidth={1.5} />\n53:         </motion.span>\n54:       </button>\n55: \n56:       <AnimatePresence initial={false}>\n57:         {open ? (\n58:           <motion.div\n59:             id={bodyId}\n60:             key=\"body\"\n61:             initial={{ height: 0, opacity: 0 }}\n62:             animate={{ height: 'auto', opacity: 1 }}\n63:             exit={{ height: 0, opacity: 0 }}\n64:             transition={{ duration: 0.28, ease: [0.4, 0, 0.2, 1] }}\n65:             className=\"overflow-hidden\"\n66:           >\n67:             <div className=\"border-t border-[var(--border)] px-4 pb-4 pt-4 md:px-5\">\n68:               {children}\n69:             </div>\n70:           </motion.div>\n71:         ) : null}\n72:       </AnimatePresence>\n73:     </motion.section>\n74:   );\n75: }\n76: \n77: export default NotificationCard;"}
{"step_index":35,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:46:45Z","content":"Created At: 2026-11-10T17:46:45Z\nCompleted At: 2026-11-10T17:46:45Z\nShowing lines 1-143 of 143\n1: import { ArrowUpRight, CalendarDays, Eye, Gauge, Hash, Mail, Plus } from 'lucide-react';\n2: import { motion, useReducedMotion } from 'framer-motion';\n3: import type { ComponentType } from 'react';\n4: import { useNavigate } from 'react-router-dom';\n5: import { useConnectors, useLimits } from '@/queries/settings';\n6: \n7: type IconType = ComponentType<{ size?: number; strokeWidth?: number; className?: string }>;\n8: \n9: /** A quiet counterpoint to the briefing spring: slide, settle, then stay still. */\n10: function slideIn(reduced: boolean, delay: number) {\n11:   return {\n12:     initial: reduced ? { opacity: 0 } : { opacity: 0, x: 18 },\n13:     animate: { opacity: 1, x: 0 },\n14:     transition: { duration: reduced ? 0.2 : 0.45, delay, ease: 'easeOut' as const },\n15:   };\n16: }\n17: \n18: const ICONS: Record<string, IconType> = {\n19:   mail: Mail,\n20:   gmail: Mail,\n21:   calendar: CalendarDays,\n22:   slack: Hash,\n23:   drive: Gauge,\n24: };\n25: \n26: function iconFor(connectorId: string): IconType {\n27:   const key = Object.keys(ICONS).find((k) => connectorId.toLowerCase().includes(k));\n28:   return key ? (ICONS[key] as IconType) : Gauge;\n29: }\n30: \n31: /** Backend connector status to a single indicator shade: status is verbal, the dot just marks it. */\n32: function toneFor(status: string): string {\n33:   const s = status.toLowerCase();\n34:   if (s === 'active' || s === 'connected' || s === 'ok') return 'var(--text)';\n35:   if (s === 'error' || s === 'revoked' || s === 'expired') return 'color-mix(in srgb, var(--text) 90%, transparent)';\n36:   return 'color-mix(in srgb, var(--text) 30%, transparent)';\n37: }\n38: \n39: function Stat({ label, value }: { label: string; value: string }) {\n40:   return (\n41:     <div className=\"min-w-0 rounded-lg bg-[color-mix(in_srgb,var(--text)_6%,transparent)] px-3 py-2.5\">\n42:       <div className=\"truncate text-[11px] text-[var(--text-muted)]\">{label}</div>\n43:       <div className=\"mt-0.5 truncate text-[17px] font-semibold tracking-heading\">{value}</div>\n44:     </div>\n45:   );\n46: }\n47: \n48: export function WidgetsRail() {\n49:   const navigate = useNavigate();\n50:   const connectors = useConnectors();\n51:   const limits = useLimits();\n52:   const reduced = useReducedMotion() ?? false;\n53: \n54:   const accounts = connectors.data ?? [];\n55: \n56:   return (\n57:     <aside aria-label=\"Widgets\" className=\"flex flex-col gap-4\">\n58:       <motion.section {...slideIn(reduced, 0.12)} className=\"card rounded-[14px] p-5\">\n59:         <div className=\"flex items-center gap-2 text-sm font-medium\">\n60:           <Gauge size={16} strokeWidth={1.5} className=\"text-[var(--text-muted)]\" />\n61:           Limits\n62:         </div>\n63:         <div className=\"mt-4 grid grid-cols-3 gap-2\">\n64:           <Stat\n65:             label=\"Steps\"\n66:             value={limits.data ? String(limits.data.max_steps_per_run) : '—'}\n67:           />\n68:           <Stat\n69:             label=\"Cost\"\n70:             value={limits.data ? `$${limits.data.max_cost_usd_per_run.toFixed(2)}` : '—'}\n71:           />\n72:           <Stat\n73:             label=\"Timeout\"\n74:             value={limits.data ? `${Math.round(limits.data.run_timeout_seconds / 60)}m` : '—'}\n75:           />\n76:         </div>\n77:       </motion.section>\n78: \n79:       <motion.section {...slideIn(reduced, 0.2)} className=\"card rounded-[14px] p-5\">\n80:         <div className=\"flex items-center justify-between\">\n81:           <div className=\"flex items-center gap-2 text-sm font-medium\">\n82:             <Eye size={16} strokeWidth={1.5} className=\"text-[var(--text-muted)]\" />\n83:             Vigil is watching\n84:           </div>\n85:           <button\n86:             type=\"button\"\n87:             onClick={() => navigate('/agent/settings')}\n88:             className=\"rounded-full px-2 py-1 text-xs font-medium text-[var(--text-muted)] transition-colors hover:text-[var(--text)]\"\n89:           >\n90:             Manage\n91:           </button>\n92:         </div>\n93: \n94:         {accounts.length > 0 ? (\n95:           <ul className=\"mt-3 space-y-1.5\">\n96:             {accounts.map((account) => {\n97:               const Icon = iconFor(account.connector_id);\n98:               return (\n99:                 <li\n100:                   key={account.id}\n101:                   className=\"flex items-center justify-between rounded-lg bg-[color-mix(in_srgb,var(--text)_5%,transparent)] px-3.5 py-2.5\"\n102:                 >\n103:                   <span className=\"flex min-w-0 items-center gap-2.5 text-sm\">\n104:                     <Icon\n105:                       size={16}\n106:                       strokeWidth={1.5}\n107:                       className=\"shrink-0 text-[var(--text-muted)]\"\n108:                     />\n109:                     <span className=\"truncate\">{account.account_label}</span>\n110:                   </span>\n111:                   <span\n112:                     className=\"h-2 w-2 shrink-0 rounded-full\"\n113:                     style={{ background: toneFor(account.status) }}\n114:                     role=\"img\"\n115:                     aria-label={account.status.replace(/_/g, ' ')}\n116:                   />\n117:                 </li>\n118:               );\n119:             })}\n120:           </ul>\n121:         ) : (\n122:           <p className=\"mt-3 rounded-lg bg-[color-mix(in_srgb,var(--text)_5%,transparent)] px-3.5 py-3 text-[13px] leading-relaxed text-[var(--text-muted)]\">\n123:             {connectors.isLoading ? 'Checking connectors...' : 'No connectors linked yet.'}\n124:           </p>\n125:         )}\n126:       </motion.section>\n127: \n128:       <motion.div {...slideIn(reduced, 0.28)}>\n129:         <button\n130:           type=\"button\"\n131:           onClick={() => navigate('/agent/chat')}\n132:           className=\"btn btn-ghost h-12 w-full\"\n133:         >\n134:           <Plus size={16} strokeWidth={1.5} />\n135:           Ask Vigil for something\n136:           <ArrowUpRight size={14} strokeWidth={1.5} />\n137:         </button>\n138:       </motion.div>\n139:     </aside>\n140:   );\n141: }\n142: \n143: export default WidgetsRail;"}
{"step_index":36,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-10T17:46:45Z","input_tokens":3455,"cache_read_tokens":104018,"output_tokens":12063,"thinking":"Implementation details are now accessible across the frontend and backend. Developing a comprehensive implementation plan artifact is the next step.\n\n\nI'm thinking through how to approach this.\n\n\nInitial focus is on documenting UI component specifications, specifically Proactivity Cards and Verb Action Buttons. This involves defining precise visual attributes such as height, padding, border-radius, font size, weight, and background/border styles for Proactivity Tags, along with the detailed taxonomy of Verb Buttons. Urgent Card behavior and the urgency accent rail are also being documented.\n\n\nFocusing on detailed UI component documentation: the visual layout and parameters of the Inline Approval Card are key. This includes attributes like the \"Security Badge\" and the single-tap verb confirmation interaction.\n\nThe interactive Micro-App showcase with pinned dashboard panels is another area. This involves documenting the header toolbar's features, dual-mode sandboxed iframes, and the structure of the Home Screen Pinned Panels. Finally, detailed documentation of the Live Cloud Browser \"Handoff\" Viewer component is needed, encompassing its screenshot carousel, action log, and the debugger toggle.\n\n\nI'm thinking through how to approach this.\n\nThe focus is now shifting to the \"Secured by Vigil\" API Key Vault cards, along with the one-click MCP server preset gallery. A key aspect is the custom MCP Server Registration modal. This involves integrating a live tool discovery badge list and a per-tool approval level selector.\n\nThe Pluggable MCP Factory Pattern is being considered. The procedural method of tool discovery and calling currently used needs to be replaced with a factory pattern to better manage tool instances and connections. The `MCPTransportClient` is the abstract base class and should define the protocol, with concrete implementations for different transports like `StdioMCPClient`.\n\n\nFocusing on integration of environment variables from the credential vault into MCP servers. This includes supporting SSE/StreamableHTTP transports with bearer header injection. A built-in catalog of one-click MCP presets, such as file system and GitHub, is planned to simplify user setup. Tool instances will be dynamically adapted to Vigil's `Tool` instances with generated Pydantic models.\n\n\n","tool_calls":[{"name":"write_file","args":{"ArtifactMetadata":{"RequestFeedback":true,"Summary":"Comprehensive UI/UX Design Specification and Full-Stack Implementation Plan to transform Vigil into an Open-Source Hark Pro. Includes exact color compositions, typography and sizing scales, squircle geometry, spring physics, verb-driven proactivity cards, inline approval checkpoints, sandboxed micro-app showcase, Groq Whisper STT, Firecrawl browser integration, and a pluggable Factory Pattern architecture for MCP registration and tool bridging.","UserFacing":true},"Content":"# Implementation Plan: Transforming Vigil into an Open-Source Hark Pro\n\n## Overview\n\nThis plan defines the complete visual design system, frontend component architecture, and backend engineering blueprint required to evolve **Vigil** into an open-source counterpart to **Hark Pro**. Every specification below is mapped directly to existing files in `web/src/` and `backend/src/`.\n\n---\n\n## Part I: Hark Pro Design System Specification (UI/UX & Visual Tokens)\n\nHark Pro's industrial design direction (led by former Apple industrial designer Abidur Chowdhury) combines **warm, tactile materiality** with **ambient low-arousal clarity**. It rejects generic AI tropes (neon purple/cyan gradients, cartoon mascots, raw terminal dumps, and chat-bubble clutter) in favor of an **Operating System GUI** built from continuous squircle surfaces, crisp specular borders, and verb-driven interactions.\n\n### 1. Color Composition & Surface Palette (`web/src/styles/tokens.css`)\n\nWe refine Vigil's dual-theme palette into **Obsidian Horizon (Dark)** and **Tactile Alabaster (Light)**, introducing explicit tokens for **Proactivity Tags**, **Verb Pills**, **Approval Surfaces**, and **Specular Rim Highlights**.\n\n#### Dark Theme (`[data-theme='dark']` — \"Obsidian Horizon\")\n| Token | Value | Purpose & Visual Role |\n| :--- | :--- | :--- |\n| `--bg-from` | `#06070A` | Deep obsidian upper canvas ground |\n| `--bg-to` | `#0C0F17` | Midnight slate lower canvas ground |\n| `--surface-solid` | `#11151F` | Opaque modal, sheet, and elevated widget base |\n| `--card` | `rgba(255, 255, 255, 0.045)` | Translucent primary card surface |\n| `--card-hover` | `rgba(255, 255, 255, 0.07)` | Elevated hover state for interactive cards |\n| `--card-strong` | `rgba(255, 255, 255, 0.095)` | Active/expanded card or nested widget tile |\n| `--border` | `rgba(255, 255, 255, 0.08)` | Hairline structural border (`1px solid`) |\n| `--border-strong` | `rgba(255, 255, 255, 0.18)` | Focused, active, or emphasized border |\n| `--rim-highlight` | `inset 0 1px 0 0 rgba(255, 255, 255, 0.12)` | Top-edge Apple-style specular glass catchlight |\n| `--text` | `#F5F7FA` | Primary editorial ink (96% white to prevent halation) |\n| `--text-secondary` | `rgba(245, 247, 250, 0.72)` | Card summaries, secondary descriptions |\n| `--text-muted` | `rgba(245, 247, 250, 0.48)` | Timestamps, metadata, inactive labels |\n| `--btn-primary-bg` | `#F5F7FA` | Primary Verb Button surface |\n| `--btn-primary-ink` | `#080A0F` | Primary Verb Button typography |\n| `--hark-amber` | `#E88449` | Warm dawn accent (`✦` proactivity spark, active beam) |\n| `--hark-amber-soft` | `rgba(232, 132, 73, 0.14)` | Proactivity tag fill & approval card ambient wash |\n| `--hark-amber-border`| `rgba(232, 132, 73, 0.32)` | Proactivity tag & approval checkpoint border |\n| `--status-approve` | `#34D399` | Approved state / verified vault indicator |\n| `--status-urgent` | `#F97316` | Critical/high urgency 3px left rail |\n| `--status-danger` | `#F43F5E` | Destructive action / rejected state |\n| `--cloud-1` | `rgba(232, 132, 73, 0.11)` | Upper-left warm dawn atmospheric drift |\n| `--cloud-2` | `rgba(56, 189, 248, 0.06)` | Upper-right cool stratosphere drift |\n| `--cloud-3` | `rgba(255, 255, 255, 0.03)` | Lower-right subtle ambient glow |\n\n#### Light Theme (`[data-theme='light']` — \"Tactile Alabaster\")\n| Token | Value | Purpose & Visual Role |\n| :--- | :--- | :--- |\n| `--bg-from` | `#FAF8F5` | Warm paper ivory upper canvas |\n| `--bg-to` | `#F0ECE1` | Soft sand/stone lower canvas |\n| `--surface-solid` | `#FFFFFF` | Crisp white elevated sheet and micro-app frame |\n| `--card` | `rgba(255, 255, 255, 0.76)` | Pillowy translucent card surface |\n| `--card-hover` | `rgba(255, 255, 255, 0.92)` | Hover elevation |\n| `--card-strong` | `#FFFFFF` | Expanded card & active panel surface |\n| `--border` | `rgba(24, 24, 27, 0.08)` | Crisp ink hairline border |\n| `--border-strong` | `rgba(24, 24, 27, 0.18)` | Active/focused border |\n| `--rim-highlight` | `inset 0 1px 0 0 rgba(255, 255, 255, 0.85)` | Specular top rim catchlight |\n| `--text` | `#141619` | Deep charcoal ink |\n| `--text-secondary` | `rgba(20, 22, 25, 0.72)` | Secondary body copy |\n| `--text-muted` | `rgba(20, 22, 25, 0.48)` | Metadata, timestamps |\n| `--btn-primary-bg` | `#141619` | Primary Verb Button fill |\n| `--btn-primary-ink` | `#FAF8F5` | Primary Verb Button text |\n| `--hark-amber` | `#C86428` | Warm terracotta proactivity accent |\n| `--hark-amber-soft` | `rgba(200, 100, 40, 0.10)` | Proactivity tag background |\n| `--hark-amber-border`| `rgba(200, 100, 40, 0.25)` | Proactivity tag border |\n\n---\n\n### 2. Typography & Sizing Scale\n\nAll typography uses self-hosted **`Plus Jakarta Sans Variable`** (`--font-sans`) with `font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\"` for geometric legibility, paired with system monospace (`ui-monospace, 'JetBrains Mono', monospace`) for code, diffs, and tool parameters.\n\n| Element / Role | Font Size | Line Height | Weight | Letter Spacing | Usage |\n| :--- | :--- | :--- | :--- | :--- | :--- |\n| **Display Greeting** | `clamp(26px, 3.2vw, 34px)` | `1.15` | `600` | `-0.022em` | Morning Deck header (`BriefingHeader.tsx`) |\n| **Section Heading** | `20px` (`1.25rem`) | `1.25` | `600` | `-0.015em` | Settings titles, Panel modal headers |\n| **Card Title** | `15.5px` (`0.968rem`) | `1.38` | `600` | `-0.012em` | Primary title inside `TaskCard` & `PanelCard` |\n| **Editorial Body** | `15px` (`0.9375rem`) | `1.65` | `400` | `-0.005em` | Unboxed assistant prose in `MessageItem.tsx` |\n| **Card Summary** | `13.5px` (`0.843rem`) | `1.55` | `400` | `0em` | Expanded card context & approval descriptions |\n| **Verb Button** | `13px` (`0.8125rem`) | `1.0` | `600` | `-0.005em` | Action verbs (`[ Draft ]`, `[ Book ]`, `[ Pay ]`) |\n| **Proactivity Tag** | `11.5px` (`0.718rem`) | `1.0` | `600` | `+0.01em` | `✦ Michael wants to book an email` |\n| **Micro Metadata** | `11px` (`0.6875rem`) | `1.2` | `600` | `+0.08em` | Uppercase source labels (`GMAIL · 2M AGO`) |\n| **Code / Diff / JSON**| `12.5px` (`0.781rem`) | `1.6` | `450` | `0em` | Approval parameter tables, bash output |\n\n---\n\n### 3. Spatial Architecture, Radii & Squircle Geometry\n\nHark Pro's tactile feel relies on nested concentric curvature (outer radius = inner radius + padding) and disciplined component heights:\n\n| Surface / Component | Border Radius | Height / Dimensions | Padding | Shadow & Border |\n| :--- | :--- | :--- | :--- | :--- |\n| **Dashboard Panel / Micro-App Frame** | `24px` (`rounded-[24px]`) | Width: `100%`, Height: `380px–560px` | Header `12px 16px`, Body `0px` | `var(--shadow)`, `1px solid var(--border)`, `var(--rim-highlight)` |\n| **Proactivity Task Card** | `20px` (`rounded-[20px]`) | Min-height: `68px` (collapsed) | `16px 20px` | `var(--shadow)`, `1px solid var(--border)`, `var(--rim-highlight)` |\n| **Inline Approval Card** | `18px` (`rounded-[18px]`) | Width: `100%` (`max-w-2xl`) | `16px 18px` | `1px solid var(--hark-amber-border)`, bg `var(--hark-amber-soft)` |\n| **Floating Input Composer (`InputPill`)**| `26px` (`rounded-[26px]`) | Min-height: `54px`, Max-width: `672px` | `10px 14px 10px 18px` | `var(--shadow)`, `1px solid var(--border-strong)` |\n| **Primary & Secondary Verb Buttons** | `9999px` (`rounded-full`) | Height: `34px` (cards) / `38px` (modals) | `0 16px` (gap `6px`) | Primary: solid ink; Secondary: `1px solid var(--border-strong)` |\n| **Proactivity Observation Pill** | `9999px` (`rounded-full`) | Height: `24px` | `0 10px` (gap `5px`) | `1px solid var(--hark-amber-border)`, bg `var(--hark-amber-soft)` |\n| **Source Avatar** | `9999px` (`rounded-full`) | `36px × 36px` | — | `1px solid var(--border)` |\n\n---\n\n### 4. Motion Physics & Spring Constants\n\nCurrently, [`tokens.css:18`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/styles/tokens.css#L18) uses `cubic-bezier(0.25, 1, 0.5, 1)`, which is monotonic and lacks physical overshoot. We replace it with the 17-point CSS `linear()` spring curve specified in `design.md` (stiffness `380`, damping `28`, mass `0.9`, **2.8% overshoot**):\n\n```css\n/* web/src/styles/tokens.css */\n@theme {\n  --ease-spring: linear(\n    0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%,\n    1.017, 1.028 21.8%, 1.018 26%, 1.003 33.2%, 0.999 45%, 1\n  );\n}\n```\n\n---\n\n## Part II: UI Component Specifications & Visual Anatomy\n\n### 1. Decommissioning the Companion Mascot (`<EyeTracker />`)\n\nTo align with Hark Pro's calm, luxury-computing aesthetic, we remove the cartoon eye-tracker toy from active application surfaces:\n- **[`web/src/components/layout/HeaderBrand.tsx`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/components/layout/HeaderBrand.tsx)**:\n  - Remove `<EyeTracker />` import and wrapper.\n  - Render the minimalist `Vigil ✦` lockup: a precision 16px 4-point vector spark (`VigilSpark`) with a subtle 4-second opacity pulse (`0.65 → 1.0`) next to `font-semibold text-[16px] tracking-[-0.02em]`.\n- **[`web/src/routes/LandingRoute.tsx`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/routes/LandingRoute.tsx)**:\n  - Remove `<EyeTracker />` from the navbar and hero.\n  - Replace the hero graphic with an interactive live demo of `HeroMockup.tsx` showcasing a Proactivity Card (`✦ Michael wants to book an email` → `[ Draft ]`), a live Micro-App Panel, and an Inline Approval Checkpoint.\n- **[`web/src/styles/tokens.css`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/styles/tokens.css#L256-L335)**:\n  - Remove lines 256–335 (`.eyt`, `.eyt-ball`, `.eyt-say`, `.eyt-caret`).\n\n---\n\n### 2. Proactivity Tags & Verb-Based Action Cards\n\n```\n╭──────────────────────────────────────────────────────────────────────────╮\n│ ┃  ✦ Michael wants to schedule a Q4 review              GMAIL · 2M AGO   │\n│ ┃                                                                        │\n│ ┃  [✉]  Q4 Financial Sync & Board Deck Preparation                   ⌄   │\n│ ┃       Michael asked for Tuesday or Thursday afternoon availability     │\n│ ┃       and requested the preliminary revenue table.                     │\n│ ┃                                                                        │\n│ ┃       [ ✦ Draft Reply ]   [ Hold Tuesday 2pm ]   [ Dismiss ]  Discuss ↗│\n╰──────────────────────────────────────────────────────────────────────────╯\n  ▲\n  3px Urgency Rail (--status-urgent for high/critical, transparent for low)\n```\n\n#### Backend Changes\n1. **[`backend/src/schemas/triage.py`](file:///home/nasbombz/Documents/Projects/vigil-agent/backend/src/schemas/triage.py) & [`backend/src/modules/cards/data.py`](file:///home/nasbombz/Documents/Projects/vigil-agent/backend/src/modules/cards/data.py)**:\n   - Add `proactivity_tag: str | None = None` to `CardResponse` and `CardCreateDTO` (stored in `CardModel` or synthesized inside `actions` / metadata).\n   - Extend `CardActionSchema`:\n     ```python\n     class CardActionSchema(BaseModel):\n         id: str\n         label: str = Field(..., description=\"Active verb button text, e.g. 'Draft Reply', 'Book Table', 'Pay $120'\")\n         verb: str = Field(default=\"run\", description=\"Canonical verb: 'draft', 'book', 'pay', 'rsvp', 'schedule', 'cancel', 'dismiss'\")\n         action_type: str = Field(..., description=\"'run', 'reply', 'approve', 'dismiss'\")\n         payload: dict[str, Any] = Field(default_factory=dict)\n     ```\n2. **[`backend/src/modules/triage/service.py`](file:///home/nasbombz/Documents/Projects/vigil-agent/backend/src/modules/triage/service.py#L127-L143)**:\n   - Replace hardcoded `\"Quick Reply\"` and `\"Mark Done\"` at lines 127–130 with dynamic verb synthesis based on item classification:\n     - Email inquiry / scheduling request → `proactivity_tag = f\"{sender_name} wants to book an email\"` or contextual observation; Primary action: `label=\"Draft\"`, `verb=\"draft\"`, `action_type=\"reply\"`, `payload={\"seed\": f\"Draft a reply to {sender} regarding {subject}: ...\"}`\n     - Invoice / billing signal → `label=\"Review & Pay\"`, `verb=\"pay\"`, `action_type=\"run\"`\n     - Calendar invite → `label=\"RSVP\"`, `verb=\"rsvp\"`, `action_type=\"run\"`\n\n#### Frontend Changes (`web/src/components/home/TaskCard.tsx` & `web/src/components/ui/NotificationCard.tsx`)\n- **Proactivity Header Pill**: Above the title in `NotificationCard.tsx`, render the `proactivity_tag` pill when present:\n  ```tsx\n  {proactivityTag ? (\n    <div className=\"mb-2 inline-flex h-6 items-center gap-1.5 rounded-full border border-[var(--hark-amber-border)] bg-[var(--hark-amber-soft)] px-2.5 text-[11.5px] font-semibold text-[var(--hark-amber)]\">\n      <VigilSpark size={11} />\n      <span>{proactivityTag}</span>\n    </div>\n  ) : null}\n  ```\n- **Default Open for Actionable Cards**: Cards with `urgency === 'critical' || urgency === 'high' || card.status === 'awaiting_approval'` pass `defaultOpen={true}` to `NotificationCard` so their verb buttons are immediately clickable on the Morning Deck without requiring an extra expand click.\n- **Verb Button Styling**:\n  - Primary Verb Button: `h-[34px] rounded-full bg-[var(--btn-primary-bg)] px-4 text-[13px] font-semibold text-[var(--btn-primary-ink)] shadow-sm transition-transform active:scale-95`\n  - Secondary Verb Button: `h-[34px] rounded-full border border-[var(--border-strong)] bg-transparent px-3.5 text-[13px] font-medium text-[var(--text)] hover:bg-[var(--card-hover)]`\n\n---\n\n### 3. Inline Human-in-the-Loop Approval Checkpoints (`InlineApprovalCard.tsx`)\n\n```\n╭──────────────────────────────────────────────────────────────────────────╮\n│  🔒 APPROVAL REQUIRED · EXTERNAL ACTION                     STEP #4      │\n│  Send Email via Gmail (nasbombz@gmail.com)                               │\n│  ┌────────────────────────────────────────────────────────────────────┐  │\n│  │ To:       michael@acme.corp                                        │  │\n│  │ Subject:  Re: Q4 Financial Sync & Preliminary Figures              │  │\n│  │ Body:     Hi Michael, Tuesday at 2:00 PM PT works well...          │  │\n│  └────────────────────────────────────────────────────────────────────┘  │\n│  [ ✓ Approve & Send ]   [ ✎ Modify in Chat ]   [ ✕ Reject ]              │\n╰──────────────────────────────────────────────────────────────────────────╯\n```\n\n#### Fixing the Broken Approvals Flow\n1. **Create [`web/src/components/chat/InlineApprovalCard.tsx`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/components/chat/InlineApprovalCard.tsx)**:\n   - Consumes `useApprovals('pending')` and `useDecideApproval()` from [`web/src/queries/approvals.ts`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/queries/approvals.ts).\n   - Matches pending approvals to the active `runId` (or renders all pending approvals in `HomeView.tsx` and `ChatRoute.tsx`).\n   - Displays the tool name, human-readable action title, a structured parameter inspection table (`To`, `Subject`, `URL`, `Amount`, or `Command`), and three explicit verb triggers:\n     - **`[ Approve & Execute ]`**: Calls `decideApproval.mutate({ approvalId, body: { decision: 'approved' }, scope })`.\n     - **`[ Modify ]`**: Rejects the current tool call and focuses `InputPill` with a pre-filled correction prompt.\n     - **`[ Reject ]`**: Calls `decideApproval.mutate({ approvalId, body: { decision: 'rejected' }, scope })`.\n2. **Update [`web/src/components/chat/ThinkingCapsule.tsx:996-1002`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/components/chat/ThinkingCapsule.tsx#L996-L1002)**:\n   - Replace the static non-interactive text banner (`\"Waiting on your approval to execute external action\"`) with `<InlineApprovalCard runId={runId} />`.\n3. **Update [`web/src/routes/ChatRoute.tsx:90-100`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/routes/ChatRoute.tsx#L90-L100)**:\n   - Replace the broken `navigate('/agent/approvals')` banner with an inline expandable approval drawer directly above the chat stream.\n\n---\n\n### 4. Sandboxed Micro-App Showcase & Pinned Dashboard Panels\n\nHark Pro allows the agent to build small interactive websites, calculators, and mini-apps in its sandbox and display them live.\n\n```\n╭──────────────────────────────────────────────────────────────────────────╮\n│  ● ● ●   ✦ SaaS Burn Rate & Runway Simulator     [📱][💻][🖥] [📌 Pin] [↗]│\n├──────────────────────────────────────────────────────────────────────────┤\n│                                                                          │\n│   Monthly Recurring Revenue ($): [ $42,500      ] ━━━━━━━━●━━━           │\n│   Monthly Operating Burn ($):    [ $68,000      ] ━━━━━━●━━━━━           │\n│   Cash Balance ($):              [ $540,000     ]                        │\n│                                                                          │\n│   ┌──────────────────┐  ┌──────────────────┐  ┌──────────────────────┐   │\n│   │ Net Burn         │  │ Implied Runway   │  │ Zero-Cash Date       │   │\n│   │ -$25,500 / mo    │  │ 21.2 Months      │  │ August 2028          │   │\n│   └──────────────────┘  └──────────────────┘  └──────────────────────┘   │\n│   [ Interactive SVG Cash Curve Chart ]                                   │\n╰──────────────────────────────────────────────────────────────────────────╯\n```\n\n#### Frontend Implementation (`web/src/components/chat/ArtifactCard.tsx` & `web/src/components/home/WidgetsRail.tsx`)\n1. **Interactive Sandboxed Iframe in `ArtifactCard.tsx`**:\n   - When an artifact has `mime_type === 'text/html'`, `.html` extension, or `kind === 'web_bundle'`:\n   - Default to the **Live Preview** tab instead of raw `<pre>` code view (provide a `[ Preview | Code ]` segmented toggle in the card header).\n   - Render `<iframe sandbox=\"allow-scripts allow-forms\" srcDoc={enhancedHtml} />` (or `src={bundleUrl}` for multi-file bundles).\n   - **Auto-Injected Theme Bridge**: If the generated HTML does not declare a `background-color`, prepend a lightweight base stylesheet matching Vigil's font (`Plus Jakarta Sans`) and smooth scrollbars so agent-generated micro-apps look native out of the box.\n   - **Viewport Switcher**: `375px` (Mobile), `768px` (Tablet), `100%` (Full Width), plus Fullscreen modal toggle.\n   - **`[ 📌 Pin to Home ]` Action**: Saves the artifact reference to pinned panels in local storage / user settings (`pinned_panels`), rendering it inside `HomeView.tsx` / `WidgetsRail.tsx` as a persistent interactive widget.\n2. **Backend Static Site Bundle Hosting (`backend/src/modules/artifacts/router.py` & `backend/src/modules/runs/tools/delivery.py`)**:\n   - Add a `deliver_site` tool in `delivery.py` that packages a directory (e.g., `/workspace/dist` or `/workspace/site`) from the sandbox container into `delivery_dir / site_{uuid}` and registers an artifact.\n   - Add `GET /api/v1/artifacts/{artifact_id}/site/{filepath:path}` in `artifacts/router.py` to serve static HTML/CSS/JS assets with strict isolation headers:\n     `Content-Security-Policy: sandbox allow-scripts allow-forms; default-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net data: blob:;`\n\n---\n\n## Part III: Pluggable MCP Factory Pattern & Dynamic Tool Registry\n\nCurrently, Vigil's MCP implementation has three architectural bottlenecks:\n1. **Procedural Transport Logic**: `backend/src/integrations/mcp/mcp.py` mixes low-level `stdio` subprocess pipes and `sse` HTTP calls in procedural functions without a unified transport abstraction or credential injection.\n2. **No Preset Catalog**: Users must know raw shell commands (`npx -y @modelcontextprotocol/server-...`) to register an MCP server.\n3. **Disconnected from `RunLoop`**: Discovered tools in `ConnectorsService._mcp_tools` are never converted into `src.modules.runs.tools.Tool` objects or injected into `openai_tool_declarations()`, making them invisible to the LLM.\n\n### 1. The MCP Factory Pattern Architecture (`backend/src/integrations/mcp/factory.py`)\n\n```mermaid\nclassDiagram\n    class MCPTransportProtocol {\n        <<interface>>\n        +discover_tools(timeout: float) list~MCPToolDefinition~\n        +call_tool(name: str, arguments: dict, timeout: float) tuple~str, bool~\n        +healthcheck() bool\n    }\n\n    class StdioMCPTransport {\n        -command: str\n        -env: dict~str, str~\n        +discover_tools(timeout: float)\n        +call_tool(name: str, arguments: dict, timeout: float)\n    }\n\n    class SseMCPTransport {\n        -url: str\n        -headers: dict~str, str~\n        +discover_tools(timeout: float)\n        +call_tool(name: str, arguments: dict, timeout: float)\n    }\n\n    class MCPTransportFactory {\n        +register_driver(scheme: str, driver_cls: type)\n        +create(server: MCPServerConfig, vault_secrets: dict) MCPTransportProtocol\n        +create_from_preset(preset_id: str, credentials: dict) MCPServerConfig\n    }\n\n    class MCPToolAdapterFactory {\n        +to_vigil_tool(dto: MCPDiscoveredToolDTO, host: MCPHostProtocol) Tool\n        +to_openai_schema(dto: MCPDiscoveredToolDTO) dict\n    }\n\n    MCPTransportProtocol <|.. StdioMCPTransport\n    MCPTransportProtocol <|.. SseMCPTransport\n    MCPTransportFactory --> MCPTransportProtocol : instantiates\n    MCPToolAdapterFactory --> Tool : wraps dynamic MCP tool\n```\n\n#### Step 1: Transport Strategy & Factory (`backend/src/integrations/mcp/factory.py`)\nCreate `backend/src/integrations/mcp/factory.py` implementing:\n- **`MCPTransportProtocol`**: Uniform async interface (`discover_tools`, `call_tool`, `healthcheck`).\n- **`StdioMCPTransport`**: Wraps `_discover_stdio` and `_call_stdio_tool`, upgraded to accept an `env: dict[str, str]` dictionary merged with `os.environ` so API keys from the encrypted Credential Vault are injected directly into the child process environment without exposing them in the command string!\n- **`SseMCPTransport`**: Wraps `_discover_sse` and `_call_sse_tool`, upgraded to accept `headers: dict[str, str]` (e.g., `Authorization: Bearer <decrypted_token>`).\n- **`MCPPresetCatalog` & `MCPTransportFactory`**:\n  ```python\n  @dataclass(frozen=True)\n  class MCPPresetSpec:\n      preset_id: str\n      display_name: str\n      description: str\n      icon: str\n      transport: Literal[\"stdio\", \"sse\"]\n      command_template: str | None = None\n      url_template: str | None = None\n      required_secrets: tuple[str, ...] = ()\n      default_level: ApprovalLevel = \"external\"\n\n  MCP_PRESETS: dict[str, MCPPresetSpec] = {\n      \"firecrawl\": MCPPresetSpec(\n          preset_id=\"firecrawl\",\n          display_name=\"Firecrawl Web Browser\",\n          description=\"Cloud browser scraping, DOM actions, and structured extraction.\",\n          icon=\"globe\",\n          transport=\"stdio\",\n          command_template=\"npx -y firecrawl-mcp\",\n          required_secrets=(\"FIRECRAWL_API_KEY\",),\n          default_level=\"read\",\n      ),\n      \"github\": MCPPresetSpec(\n          preset_id=\"github\",\n          display_name=\"GitHub Repositories & PRs\",\n          description=\"Manage issues, pull requests, files, and branches.\",\n          icon=\"github\",\n          transport=\"stdio\",\n          command_template=\"npx -y @modelcontextprotocol/server-github\",\n          required_secrets=(\"GITHUB_PERSONAL_ACCESS_TOKEN\",),\n          default_level=\"external\",\n      ),\n      \"filesystem\": MCPPresetSpec(\n          preset_id=\"filesystem\",\n          display_name=\"Workspace Filesystem\",\n          description=\"Local directory read/write operations via MCP.\",\n          icon=\"folder\",\n          transport=\"stdio\",\n          command_template=\"npx -y @modelcontextprotocol/server-filesystem /workspace\",\n          required_secrets=(),\n          default_level=\"local\",\n      ),\n      \"postgres\": MCPPresetSpec(\n          preset_id=\"postgres\",\n          display_name=\"PostgreSQL Inspector\",\n          description=\"Read-only schema inspection and SQL queries.\",\n          icon=\"database\",\n          transport=\"stdio\",\n          command_template=\"npx -y @modelcontextprotocol/server-postgres\",\n          required_secrets=(\"POSTGRES_CONNECTION_STRING\",),\n          default_level=\"read\",\n      ),\n      \"linear\": MCPPresetSpec(\n          preset_id=\"linear\",\n          display_name=\"Linear Project Tracker\",\n          description=\"Search, create, and update Linear issues and cycles.\",\n          icon=\"Kanban\",\n          transport=\"sse\",\n          url_template=\"https://mcp.linear.app/sse\",\n          required_secrets=(\"LINEAR_API_KEY\",),\n          default_level=\"external\",\n      ),\n  }\n  ```\n\n#### Step 2: Dynamic `MCPToolAdapterFactory` (`backend/src/modules/runs/tools/mcp_bridge.py`)\nTo make every discovered MCP tool work seamlessly with `RunLoop`, `PartitionPolicy`, and `openai_tool_declarations`:\n```python\nclass DynamicMCPArgs(BaseModel):\n    \"\"\"Permissive Pydantic model that validates arbitrary JSON-schema arguments.\"\"\"\n    model_config = ConfigDict(extra=\"allow\")\n\nclass MCPToolAdapterFactory:\n    \"\"\"Converts MCPDiscoveredToolDTO objects into executable Vigil Tool instances.\"\"\"\n\n    @staticmethod\n    def create_tool(\n        dto: MCPDiscoveredToolDTO,\n        mcp_host: MCPHostProtocol,\n    ) -> Tool:\n        async def _handler(parsed: BaseModel, context: ToolContext) -> ToolResult:\n            raw_args = parsed.model_dump()\n            res = await mcp_host.execute_tool(\n                connector_id=dto.server_name,\n                tool_name=dto.name,\n                arguments=raw_args,\n            )\n            if res.is_error:\n                return ToolResult.failure(str(res.output))\n            return ToolResult.success(res.output)\n\n        return Tool(\n            name=dto.name,\n            description=f\"[{dto.server_name}] {dto.description}\",\n            level=dto.level,  # 'read', 'local', or 'external' (triggers inline approval!)\n            args_model=DynamicMCPArgs,\n            handler=_handler,\n            input_schema=dto.input_schema or {\"type\": \"object\", \"properties\": {}},\n        )\n```\n\n#### Step 3: Injecting Dynamic Tools into `RunsService.build_loop()`\n- In [`backend/src/modules/runs/service.py:522-535`](file:///home/nasbombz/Documents/Projects/vigil-agent/backend/src/modules/runs/service.py#L522-L535):\n  - Query all registered MCP tools from `ConnectorsService._mcp_tools.values()`.\n  - Build adapted `Tool` objects via `MCPToolAdapterFactory.create_tool(dto, self.mcp_host)`.\n  - Merge their OpenAI function declarations into `tool_schemas` passed to `RunLoop`.\n  - Register their `level` (`external` by default) in `PartitionPolicy` so any state-mutating MCP tool automatically pauses the run and renders the **Inline Approval Card** in the user's chat!\n\n---\n\n## Part IV: Cloud Browser (Firecrawl), Groq Whisper STT, & Vault Backend\n\n### 1. Third-Party Cloud Browser Tool Suite (`backend/src/modules/runs/tools/browser.py`)\n- Create `backend/src/modules/runs/tools/browser.py` with two first-class built-in tools added to `TOOLS` in `backend/src/modules/runs/tools/__init__.py` (updating `TOOL_COUNT` from `12` to `15` including `deliver_site`):\n  1. **`browser_navigate`** (`level=\"read\"` for navigation/scraping, or `\"external\"` when submitting forms):\n     - Calls Firecrawl `/v1/scrape` with `formats=[\"markdown\", \"screenshot\"]` and optional sequential `actions` (`click`, `write`, `wait`, `press`, `scroll`).\n     - Resolves `FIRECRAWL_API_KEY` from the encrypted Credential Vault first, falling back to `settings.FIRECRAWL_API_KEY`.\n     - Saves any returned screenshot to `context.delivery_dir` so it renders inline as a visual preview in the chat stream.\n  2. **`browser_extract`** (`level=\"read\"`):\n     - Calls Firecrawl `/v1/scrape` with `formats=[\"extract\"]` and a structured JSON Schema prompt to extract clean entities (flight prices, table rows, contact details).\n\n### 2. Sub-250ms Voice Transcription via Groq Whisper (`backend/src/modules/voice/`)\n- **Settings (`backend/src/config/settings.py`)**:\n  - Add `GROQ_API_KEY: str = \"\"` and `FIRECRAWL_API_KEY: str = \"\"`.\n- **Voice Module (`backend/src/modules/voice/router.py`)**:\n  - Register `\"voice\"` in `MODULE_FACTORIES` inside [`backend/src/config/router.py`](file:///home/nasbombz/Documents/Projects/vigil-agent/backend/src/config/router.py#L24-L41).\n  - Endpoint `POST /api/v1/voice/transcribe`:\n    - Accepts `UploadFile` (`audio/webm`, `audio/mp4`, `audio/wav`).\n    - Resolves `GROQ_API_KEY` from Vault (`connector_id=\"groq\"`) or `settings.GROQ_API_KEY`.\n    - Proxies multipart upload to `https://api.groq.com/openai/v1/audio/transcriptions` with `model=\"whisper-large-v3-turbo\"`.\n    - Returns `{ \"text\": \"...\" }`.\n- **Frontend Composer (`web/src/components/chat/InputPill.tsx`)**:\n  - Wire `MediaRecorder` in `startCapture()` / `stopCapture()`.\n  - While recording, `HandoffBeam` animates in `'listening'` mode using the live FFT `AnalyserNode`.\n  - When the user clicks Stop, upload the recorded audio Blob to `api.transcribeVoice(blob)` and append the returned text into `draft`.\n\n### 3. Settings > Vault & MCP Studio UI (`web/src/components/settings/sections.tsx`)\nUpgrade `ConnectorsSection` in [`web/src/components/settings/sections.tsx:266-326`](file:///home/nasbombz/Documents/Projects/vigil-agent/web/src/components/settings/sections.tsx#L266-L326) into three structured cards:\n1. **\"Secured by Vigil\" API Key Vault**:\n   - Quick-entry encrypted key cards for **Groq (Whisper STT)**, **Firecrawl (Cloud Browser)**, and **Exa (Semantic Search)**.\n   - Keys are encrypted via `POST /api/v1/connectors/accounts` using AES-256-GCM (`encrypt_secret`) and never returned in plaintext.\n2. **One-Click MCP Preset Gallery**:\n   - Interactive grid of presets (`Firecrawl MCP`, `GitHub`, `Workspace Filesystem`, `PostgreSQL`, `Linear`) powered by `GET /api/v1/connectors/mcp/presets`.\n   - Clicking `[ + Enable ]` prompts for any required secret and registers the MCP server in one click.\n3. **Custom MCP Server Registration & Tool Permission Matrix**:\n   - Form to register custom `stdio` or `sse` MCP servers (`POST /api/v1/connectors/mcp/servers`).\n   - Lists discovered tools per server with a segmented pill to toggle each tool's approval gate (`Read` | `Local` | `Approval Required`).\n\n---\n\n## Part V: File-by-File Modification Matrix & Execution Phases\n\n### Phase 1: Hark Pro Design System, Mascot Removal & Verb Proactivity\n| File | Action | Description |\n| :--- | :--- | :--- |\n| `web/src/styles/tokens.css` | Modify | Update Dark/Light palettes to Obsidian Horizon & Tactile Alabaster; add `--hark-amber*`, `--rim-highlight`, and 17-point `linear()` `--ease-spring`; remove `.eyt*` mascot styles. |\n| `web/src/components/layout/HeaderBrand.tsx` | Modify | Remove `<EyeTracker />`; implement `Vigil ✦` vector spark brand lockup. |\n| `web/src/routes/LandingRoute.tsx` | Modify | Remove `<EyeTracker />`; showcase Hark-style Proactivity Cards and Micro-App preview in hero. |\n| `backend/src/modules/cards/data.py` | Modify | Add `proactivity_tag` and `verb` fields to card action schemas. |\n| `backend/src/modules/triage/service.py` | Modify | Replace hardcoded `\"Quick Reply\"` with intent-aware Proactivity Tags and active verbs (`Draft`, `Book`, `Pay`, `RSVP`). |\n| `web/src/components/ui/NotificationCard.tsx`| Modify | Add `proactivityTag` pill badge, `urgency` 3px left rail, and specular rim highlight. |\n| `web/src/components/home/TaskCard.tsx` | Modify | Render active verb buttons, auto-expand urgent/approval cards, and wire verb execution. |\n\n### Phase 2: Inline Approvals & Micro-App Showcase (Mirroring the VM Farm)\n| File | Action | Description |\n| :--- | :--- | :--- |\n| `web/src/components/chat/InlineApprovalCard.tsx` | Create | Inline approval checkpoint card with parameter diff table and `[ Approve & Execute ]` / `[ Reject ]` verb buttons. |\n| `web/src/components/chat/ThinkingCapsule.tsx` | Modify | Render `<InlineApprovalCard />` when `approval_required` step is active. |\n| `web/src/routes/ChatRoute.tsx` | Modify | Replace broken `/agent/approvals` redirect banner with inline approval resolver. |\n| `backend/src/modules/runs/tools/delivery.py` | Modify | Add `deliver_site` tool for packaging multi-file static web apps from `/workspace`. |\n| `backend/src/modules/artifacts/router.py` | Modify | Add `GET /api/v1/artifacts/{id}/site/{filepath:path}` static asset server with sandboxed CSP. |\n| `web/src/components/chat/ArtifactCard.tsx` | Modify | Replace `<pre>` HTML dump with interactive sandboxed `<iframe>`, `[ Preview | Code ]` toggle, viewport size switcher (`375px`/`768px`/`100%`), and `[ 📌 Pin to Home ]`. |\n| `web/src/components/home/WidgetsRail.tsx` | Modify | Render pinned Micro-App Panels on the Home dashboard. |\n\n### Phase 3: Pluggable MCP Factory, Cloud Browser (Firecrawl), Groq Voice & Vault UI\n| File | Action | Description |\n| :--- | :--- | :--- |\n| `backend/src/integrations/mcp/factory.py` | Create | Implement `MCPTransportProtocol`, `StdioMCPTransport` (with Vault env injection), `SseMCPTransport`, `MCP_PRESETS`, and `MCPTransportFactory`. |\n| `backend/src/modules/runs/tools/mcp_bridge.py`| Create | Implement `MCPToolAdapterFactory` converting `MCPDiscoveredToolDTO` into executable Vigil `Tool` instances. |\n| `backend/src/modules/runs/service.py` | Modify | Inject dynamic MCP tools and their approval levels into `build_loop()` and `PartitionPolicy`. |\n| `backend/src/modules/runs/tools/browser.py` | Create | Implement `browser_navigate` and `browser_extract` using Firecrawl API + screenshot artifacts. |\n| `backend/src/modules/voice/router.py` | Create | Implement `POST /api/v1/voice/transcribe` powered by Groq `whisper-large-v3-turbo`. |\n| `web/src/components/chat/InputPill.tsx` | Modify | Connect `MediaRecorder` chunks to `/api/v1/voice/transcribe` and populate composer draft. |\n| `web/src/components/settings/sections.tsx` | Modify | Build the \"Secured by Vigil\" API Key Vault, 1-Click MCP Preset Gallery, and Custom MCP Server Studio. |\n\n---\n\n## Verification & Acceptance Criteria\n\n1. **Visual & Aesthetic Verification**:\n   - `<EyeTracker />` is completely absent from both `/` and `/agent*`.\n   - Dark and Light themes exhibit Obsidian Horizon (`#06070A`) and Tactile Alabaster (`#FAF8F5`) tokens with `Plus Jakarta Sans` typography and 17-point spring physics.\n2. **Proactivity & Inline Approvals**:\n   - Home feed cards render `✦` proactivity tags and explicit verb buttons (`[ Draft ]`, `[ Pay ]`, `[ RSVP ]`).\n   - Triggering an `external`-level tool pauses the run and renders an interactive `InlineApprovalCard` directly inside the chat thread; clicking `[ Approve & Execute ]` resumes the run to completion (HTTP 202).\n3. **Sandboxed Micro-Apps**:\n   - Asking Vigil to *\"Build an interactive mortgage calculator\"* renders a live, interactive iframe inside `ArtifactCard` with Mobile/Tablet/Desktop viewport toggles and can be pinned to the Home screen.\n4. **MCP Factory & Cloud Browser / Voice**:\n   - Registering an MCP server from a preset or custom config dynamically injects its tools into the LLM's tool declarations and enforces approval levels.\n   - Recording voice in `InputPill` transcribes speech via Groq Whisper in `<250ms` when `GROQ_API_KEY` is configured.\n","Overwrite":true,"Path":"/home/nasbombz/.gemini/antigravity/brain/4c9225c7-9a87-4aee-bca4-891ac270da2a/implementation_plan.md"}}]}
