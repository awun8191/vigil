{"step_index":319,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:10:38Z","content":"Created At: 2026-11-11T10:10:38Z\nCompleted At: 2026-11-11T10:10:38Z\nShowing lines 400-520 of 585\n400:         The summary block comes first, as a system message. Then every kept and\n401:         stubbed unit follows in the order of the source history.\n402:         \"\"\"\n403:         sources = originals or {}\n404:         messages: list[dict[str, Any]] = []\n405:         if plan.summary is not None:\n406:             messages.append(\n407:                 {\n408:                     \"role\": \"system\",\n409:                     \"content\": plan.summary.text,\n410:                     \"id\": SUMMARY_MESSAGE_ID,\n411:                     \"kind\": \"summary\",\n412:                 }\n413:             )\n414: \n415:         order = plan.order or tuple(\n416:             item.unit.unit_id for item in (*plan.kept, *plan.stubbed)\n417:         )\n418:         planned = {item.unit.unit_id: item for item in (*plan.kept, *plan.stubbed)}\n419:         for unit_id in order:\n420:             item = planned.get(unit_id)\n421:             if item is None:\n422:                 continue\n423:             message: dict[str, Any] = {\n424:                 \"role\": item.unit.role,\n425:                 \"content\": item.content,\n426:                 \"id\": unit_id,\n427:             }\n428:             original = sources.get(unit_id)\n429:             if original is not None:\n430:                 for key in PRESERVED_MESSAGE_KEYS:\n431:                     if key in original:\n432:                         message[key] = original[key]\n433:             messages.append(message)\n434:         return messages\n435: \n436:     async def compact(\n437:         self,\n438:         run_id: UUID,\n439:         messages: Sequence[Mapping[str, Any]],\n440:         step_number: int | None = None,\n441:     ) -> CompactedContext:\n442:         \"\"\"Run the three tiers, assemble the history, verify it, and trace it.\n443: \n444:         A failed verification raises `CompactionVerificationError`. Nothing is\n445:         saved in that case, so the run fails before a model call.\n446:         \"\"\"\n447:         units = units_from_messages(messages)\n448:         originals = {unit.unit_id: message for unit, message in zip(units, messages)}\n449: \n450:         plan = await self.plan_compaction(units)\n451:         plan = await self.summarize_plan(plan)\n452:         assembled = self.assemble_context(plan, originals)\n453:         verification = verify_compacted_history(assembled, messages)\n454: \n455:         compacted_tokens = self.token_counter.count_many(\n456:             [str(message.get(\"content\") or \"\") for message in assembled]\n457:         )\n458:         await self.save_compacted_history(run_id, assembled, plan.summary_block)\n459:         step = await self.record_compaction_step(\n460:             run_id=run_id,\n461:             plan=plan,\n462:             verification=verification,\n463:             compacted_tokens=compacted_tokens,\n464:             step_number=step_number,\n465:         )\n466: \n467:         return CompactedContext(\n468:             run_id=run_id,\n469:             messages=assembled,\n470:             plan=plan,\n471:             verification=verification,\n472:             compacted_tokens=compacted_tokens,\n473:             step=step,\n474:         )\n475: \n476:     async def record_compaction_step(\n477:         self,\n478:         run_id: UUID,\n479:         plan: CompactionPlan,\n480:         verification: VerificationReport,\n481:         compacted_tokens: int,\n482:         step_number: int | None = None,\n483:     ) -> RunStepDTO | None:\n484:         \"\"\"Store the summary chain as one `compaction` run step.\n485: \n486:         Returns None when no step recorder is wired, so the pipeline can run\n487:         without the runs repository.\n488:         \"\"\"\n489:         if self.run_steps is None:\n490:             return None\n491: \n492:         if step_number is None:\n493:             step_number = await self.next_step_number(run_id)\n494: \n495:         summary = plan.summary\n496:         payload: dict[str, Any] = {\n497:             \"summary_block\": plan.summary_block,\n498:             \"summary_tokens\": 0 if summary is None else summary.tokens,\n499:             \"summary_budget_tokens\": (\n500:                 DEFAULT_SUMMARY_TOKEN_BUDGET if summary is None else summary.budget_tokens\n501:             ),\n502:             \"summary_model\": self.settings.FAST_LLM_MODEL,\n503:             \"summary_truncated\": False if summary is None else summary.truncated,\n504:             \"summary_sources\": [\n505:                 {\"unit_id\": source.unit_id, \"verdict\": source.verdict, \"tokens\": source.tokens}\n506:                 for source in plan.summary_sources()\n507:             ],\n508:             \"original_tokens\": plan.original_tokens,\n509:             \"compacted_tokens\": compacted_tokens,\n510:             \"units_kept\": len(plan.kept),\n511:             \"units_stubbed\": plan.units_stubbed,\n512:             \"units_dropped\": plan.units_dropped,\n513:             \"jev_calls\": plan.tier1.jev_calls,\n514:             \"verified\": True,\n515:             \"approvals_checked\": list(verification.approval_ids),\n516:             \"tool_calls_checked\": list(verification.tool_call_ids),\n517:         }\n518:         return await self.run_steps.save_run_step(\n519:             RunStepCreateDTO(\n520:                 run_id=run_id,"}
