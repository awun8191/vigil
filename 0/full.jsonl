e approval at step 12 is still pending.\"\n41: )\n42: \n43: \n44: class ScriptedFastLLM:\n45:     \"\"\"Deterministic Fast tier double. It records the tier of every call.\"\"\"\n46: \n47:     def __init__(self) -> None:\n48:         self.calls: list[dict[str, Any]] = []\n49: \n50:     async def complete(\n51:         self,\n52:         messages: list[dict[str, Any]],\n53:         tools: list[dict[str, Any]] | None = None,\n54:         temperature: float = 0.7,\n55:         tier: str = \"reasoning\",\n56:         max_tokens: int | None = None,\n57:     ) -> LLMResponseDTO:\n58:         self.calls.append({\"messages\": messages, \"tier\": tier, \"max_tokens\": max_tokens})\n59:         return LLMResponseDTO(\n60:             content=SUMMARY_ANSWER,"}
