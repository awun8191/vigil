{"step_index":276,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:07:46Z","content":"Created At: 2026-11-11T10:07:46Z\nCompleted At: 2026-11-11T10:07:46Z\nShowing lines 1-60 of 124\n1: import { useState } from 'react';\n2: import { useNavigate } from 'react-router-dom';\n3: import { ArrowRight, Smartphone } from 'lucide-react';\n4: import { api, IS_MOCK } from '@/lib/api';\n5: import { userMessageOf } from '@/lib/errors';\n6: import { formatPairingCode, platformDeviceName } from '@/lib/format';\n7: import { useSession } from '@/store/useSession';\n8: \n9: /**\n10:  * The pairing gate.\n11:  *\n12:  * Renders before the app shell whenever no token is available. Without this route a first-run user\n13:  * has no surface at all: Settings lives behind the dock, and the dock requires auth.\n14:  */\n15: export default function PairRoute() {\n16:   const navigate = useNavigate();\n17:   const signIn = useSession((state) => state.signIn);\n18: \n19:   const [code, setCode] = useState('');\n20:   const [deviceName, setDeviceName] = useState(() => platformDeviceName());\n21:   const [submitting, setSubmitting] = useState(false);\n22:   const [error, setError] = useState<string | null>(null);\n23: \n24:   const canSubmit = code.length >= 6 && deviceName.trim().length > 0 && !submitting;\n25: \n26:   const submit = async (event: React.FormEvent) => {\n27:     event.preventDefault();\n28:     if (!canSubmit) return;\n29: \n30:     setSubmitting(true);\n31:     setError(null);\n32: \n33:     try {\n34:       const pairing = await api.pair(code, deviceName.trim());\n35:       await signIn(pairing, () => api.me());\n36:       navigate('/agent', { replace: true });\n37:     } catch (cause) {\n38:       setError(\n39:         cause instanceof Error && cause.name === 'ApiError' && 'status' in cause && cause.status === 401\n40:           ? 'That code was not recognised. It expires 10 minutes after boot.'\n41:           : userMessageOf(cause),\n42:       );\n43:     } finally {\n44:       setSubmitting(false);\n45:     }\n46:   };\n47: \n48:   return (\n49:     <main className=\"flex min-h-dvh items-center justify-center px-5 py-16\">\n50:       <div className=\"w-full max-w-[420px]\">\n51:         <div className=\"mb-8 flex items-center gap-2\">\n52:           <span className=\"text-[20px] font-bold tracking-[-0.02em]\">Vigil</span>\n53:         </div>\n54: \n55:         <div\n56:           className=\"card rounded-[14px] p-6\"\n57:         >\n58:           <h1 className=\"text-[22px] font-semibold tracking-[-0.015em]\">Pair this device</h1>\n59:           <p className=\"mt-1.5 text-[14px] leading-relaxed text-[var(--text-muted)]\">\n60:             Enter the code printed by the Vigil backend when it started."}
