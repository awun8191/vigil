l: ...\n45:     async def get_or_create_default_user(self, display_name: str = \"Default User\") -> UserDTO: ...\n46:     async def get_user_by_id(self, user_id: UUID) -> UserDTO | None: ...\n47:     async def store_pairing_code(self, pairing: PairingCodeDTO) -> None: ...\n48:     async def validate_and_consume_pairing_code(self, code: str) -> PairingCodeDTO | None: ...\n49: \n50: \n51: class InMemoryAuthStore:\n52:     \"\"\"Module-level dict store, identical semantics to the original service dicts.\"\"\"\n53: \n54:     devices: dict[str, DeviceDTO] = {}\n55:     devices_by_id: dict[UUID, DeviceDTO] = {}\n56:     users: dict[UUID, UserDTO] = {}\n57: \n58:     async def get_device_by_token_hash(self, token_hash: str) -> DeviceDTO | None:\n59:         device = InMemoryAuthStore.devices.get(token_hash)\n60:         if device and device.revoked_at is None:\n61:             return device\n62:         return None\n63: \n64:     async def create_device(self, data: DeviceCreateDTO) -> DeviceDTO:\n65:         now = _now()\n66:         device = DeviceDTO(\n67:             id=uuid4(),\n68:             user_id=data.user_id,\n69:             name=data.name,\n70:             token_hash=data.token_hash,\n71:             push_token=REDACTED,\n72:             last_seen_at=now,\n73:             revoked_at=None,\n74:             created_at=now,\n75:         )\n76:         InMemoryAuthStore.devices[data.token_hash] = device\n77:         InMemoryAuthStore.devices_by_id[device.id] = device\n78:         return device\n79: \n80:     async def update_device_last_seen(self, device_id: UUID, seen_at: datetime) -> None:\n81:         device = InMemoryAuthStore.devices_by_id.get(device_id)\n82:         if device:\n83:             updated = _replace(device, last_seen_at=seen_at)\n84:             InMemoryAuthStore.devices[device.token_hash] = updated\n85:             InMemoryAuthStore.devices_by_id[device_id] = updated\n86: \n87:     async def revoke_device(self, device_id: UUID) -> bool:\n88:         device = InMemoryAuthStore.devices_by_id.get(device_id)\n89:         if not device:\n90:             return False\n91:         revoked = _replace(device, revoked_at=_now())\n92:         InMemoryAuthStore.devices[device.token_hash] = revoked\n93:         InMemoryAuthStore.devices_by_id[device_id] = revoked\n94:         return True\n95: \n96:     async def get_or_create_default_user(self, display_name: str = \"Default User\") -> UserDTO:\n97:         if DEFAULT_USER_ID in InMemoryAuthStore.users:\n98:             return InMemoryAuthStore.users[DEFAULT_USER_ID]\n99:         user = UserDTO(\n100:             id=DEFAULT_USER_ID,\n101:             display_name=display_name,\n102:             settings={},\n103:             created_at=_now(),\n104:             updated_at=_now(),\n105:         )\n106:         InMemoryAuthStore.users[DEFAULT_USER_ID] = user\n107:         return user\n108: \n109:     async def get_user_by_id(self, user_id: UUID) -> UserDTO | None:\n110:         if user_id in InMemoryAuthStore.users:\n111:             return InMemoryAuthStore.users[user_id]\n112:         return None\n113: \n114:     async def store_pairing_code(self, pairing: PairingCodeDTO) -> None:\n115:         PAIRING_CODES[pairing.code] = pairing\n116: \n117:     async def validate_and_consume_pairing_code(self, code: str) -> PairingCodeDTO | None:\n118:         pairing = PAIRING_CODES.pop(code, None)\n119:         if not pairing:\n120:             return None"}
