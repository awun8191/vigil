{"step_index":210,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-11T10:01:20Z","input_tokens":2829,"cache_read_tokens":224758,"output_tokens":865,"tool_calls":[{"name":"write_file","args":{"Content":"import { useEffect, useRef } from 'react';\nimport { Search, X } from 'lucide-react';\nimport { AnimatePresence, motion } from 'framer-motion';\n\ninterface Props {\n  open: boolean;\n  onClose: () => void;\n  onSearch?: (query: string) => void;\n}\n\nexport function HarkSearchModal({ open, onClose, onSearch }: Props) {\n  const inputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    if (open) {\n      setTimeout(() => inputRef.current?.focus(), 50);\n    }\n  }, [open]);\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') onClose();\n      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {\n        e.preventDefault();\n        if (open) onClose();\n      }\n    };\n    window.addEventListener('keydown', handleKeyDown);\n    return () => window.removeEventListener('keydown', handleKeyDown);\n  }, [open, onClose]);\n\n  return (\n    <AnimatePresence>\n      {open ? (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-6\">\n          {/* Heavy Backdrop Blur */}\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            onClick={onClose}\n            className=\"fixed inset-0 bg-black/40 backdrop-blur-2xl\"\n          />\n\n          {/* Centered Floating Search Pill (Screenshot 6) */}\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95, y: -10 }}\n            animate={{ opacity: 1, scale: 1, y: 0 }}\n            exit={{ opacity: 0, scale: 0.95, y: -10 }}\n            transition={{ type: 'spring', stiffness: 500, damping: 35 }}\n            className=\"relative z-10 w-full max-w-lg\"\n          >\n            <div className=\"flex h-12 items-center gap-3 rounded-full bg-[var(--surface-solid)] border border-[var(--border-strong)] px-4 shadow-2xl\">\n              <Search size={18} className=\"text-[var(--text-muted)]\" />\n              <input\n                ref={inputRef}\n                type=\"text\"\n                placeholder=\"Search\"\n                onKeyDown={(e) => {\n                  if (e.key === 'Enter') {\n                    onSearch?.(e.currentTarget.value);\n                    onClose();\n                  }\n                }}\n                className=\"w-full bg-transparent text-[15px] font-normal text-[var(--text)] placeholder-[var(--text-muted)] outline-none\"\n              />\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"rounded-full p-1 text-[var(--text-muted)] hover:text-[var(--text)]\"\n              >\n                <X size={16} />\n              </button>\n            </div>\n          </motion.div>\n        </div>\n      ) : null}\n    </AnimatePresence>\n  );\n}\n\nexport default HarkSearchModal;\n","Overwrite":true,"Path":"/home/nasbombz/Documents/Projects/vigil-agent/web/src/components/hark/HarkSearchModal.tsx"}}]}
