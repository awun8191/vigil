{"step_index":309,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:10:02Z","content":"Created At: 2026-11-11T10:10:02Z\nCompleted At: 2026-11-11T10:10:02Z\nShowing lines 1-100 of 207\n1: \"\"\"Application settings management powered by Pydantic v2 BaseSettings.\"\"\"\n2: from functools import lru_cache\n3: import json\n4: from typing import Literal, Union\n5: from pydantic import Field, field_validator, model_validator\n6: from pydantic_settings import BaseSettings, SettingsConfigDict\n7: \n8: # Public values that must never protect a deployment. The first value is the\n9: # historical default. The second is the placeholder in deploy/.env.example.\n10: DEFAULT_SECRET_KEY = \"REDACTED\"\n11: ENV_EXAMPLE_SECRET_KEY = \"REDACTED\"\n12: UNSAFE_SECRET_KEYS = frozenset({DEFAULT_SECRET_KEY, ENV_EXAMPLE_SECRET_KEY})\n13: \n14: \n15: def is_unsafe_secret_key(value: str) -> bool:\n16:     \"\"\"Return True when a secret key is empty, public, or an example placeholder.\"\"\"\n17:     return not value.strip() or value in UNSAFE_SECRET_KEYS\n18: \n19: \n20: class Settings(BaseSettings):\n21:     \"\"\"Strongly typed application configuration loaded from environment variables and .env file.\"\"\"\n22: \n23:     model_config = SettingsConfigDict(\n24:         env_file=\".env\",\n25:         env_file_encoding=\"utf-8\",\n26:         extra=\"ignore\",\n27:         case_sensitive=True,\n28:     )\n29: \n30:     # --- Application & Server ---\n31:     APP_NAME: str = \"Vigil\"\n32:     APP_ENV: Literal[\"development\", \"staging\", \"production\", \"test\"] = \"development\"\n33:     DEBUG: bool = False\n34:     HOST: str = \"0.0.0.0\"\n35:     PORT: int = 8000\n36:     API_V1_PREFIX: str = \"/api/v1\"\n37: \n38:     # --- Database (PostgreSQL 16 + pgvector) ---\n39:     DATABASE_URL: str = \"REDACTED\"\n40:     DATABASE_POOL_SIZE: int = 20\n41:     DATABASE_MAX_OVERFLOW: int = 10\n42:     DATABASE_ECHO: bool = False\n43: \n44:     # --- Cryptography & Security ---\n45:     SECRET_KEY: str = Field(\n46:         default=DEFAULT_SECRET_KEY,\n47:         description=\"Master secret key for AES-256-GCM credential encryption (32 bytes or 64 hex characters)\",\n48:     )\n49:     PAIRING_CODE_TTL_SECONDS: int = 300\n50:     DEVICE_TOKEN_SECRET: str = \"vigil-device-token-secret-change-in-production\"\n51:     CORS_ORIGINS: Union[list[str], str] = [\"*\"]\n52: \n53:     @field_validator(\"CORS_ORIGINS\", mode=\"after\")\n54:     @classmethod\n55:     def assemble_cors_origins(cls, v: Union[str, list[str]]) -> list[str]:\n56:         \"\"\"Support both JSON-encoded string and comma-separated string for CORS origins.\"\"\"\n57:         if isinstance(v, str):\n58:             v_stripped = v.strip()\n59:             if v_stripped.startswith(\"[\") and v_stripped.endswith(\"]\"):\n60:                 try:\n61:                     parsed = json.loads(v_stripped)\n62:                     if isinstance(parsed, list):\n63:                         return [str(item).strip() for item in parsed if str(item).strip()]\n64:                 except Exception:\n65:                     pass\n66:             return [origin.strip() for origin in v_stripped.split(\",\") if origin.strip()]\n67:         return v\n68: \n69:     @model_validator(mode=\"after\")\n70:     def reject_unsafe_secret_key_in_production(self) -> \"Settings\":\n71:         \"\"\"Refuse a production configuration that keeps a published secret key.\n72: \n73:         The default key and the .env.example placeholder are public. A deployment\n74:         that encrypts credentials with either key protects nothing.\n75:         \"\"\"\n76:         if self.APP_ENV == \"production\" and is_unsafe_secret_key(self.SECRET_KEY):\n77:             raise ValueError(\n78:                 \"SECRET_KEY is the public default or the .env.example placeholder. \"\n79:                 \"Set SECRET_KEY to a unique value before booting in production. \"\n80:                 \"Generate one with: openssl rand -hex 32\"\n81:             )\n82:         return self\n83: \n84:     # --- Tiered Model Architecture ---\n85:     # Tier 1: Jev Decision Classifier\n86:     JEV_BASE_URL: str = \"https://api.typesafe.ai/v1\"\n87:     JEV_API_KEY: str = \"\"\n88:     JEV_MODEL: str = \"jev-classifier-v1\"\n89: \n90:     # Tier 2: Fast LLM (Triage Stage 2 metadata extractor & Compaction summarizer)\n91:     FAST_LLM_BASE_URL: str = \"https://api.openai.com/v1\"\n92:     FAST_LLM_API_KEY: str = \"\"\n93:     FAST_LLM_MODEL: str = \"gpt-4o-mini\"\n94: \n95:     # Tier 3: Reasoning LLM (Agent event loop execution & complex synthesis)\n96:     REASONING_LLM_BASE_URL: str = \"https://api.openai.com/v1\"\n97:     REASONING_LLM_API_KEY: str = \"\"\n98:     REASONING_LLM_MODEL: str = \"muse-spark-1.3-contributor\"\n99: \n100:     # --- Local Embedding Model (bge-small-en-v1.5, int8 ONNX) ---"}
