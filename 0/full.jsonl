{"step_index":325,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:11:25Z","content":"Created At: 2026-11-11T10:11:25Z\nCompleted At: 2026-11-11T10:11:25Z\nShowing lines 1-100 of 434\n1: \"\"\"Tier 0 safety locks and Tier 1 Jev scoring for context compaction.\n2: \n3: Tier 0 is deterministic and has no probability gate. It locks every user\n4: message, the last six conversation turns, every approval and decision, and\n5: the final result of every tool chain. Tier 1 asks the Jev classifier three\n6: calibrated questions per unit and turns each answer into one verdict.\n7: \n8: Token counting uses the provider tokenizer for the configured model. This\n9: module never estimates tokens from character counts.\n10: \"\"\"\n11: from __future__ import annotations\n12: \n13: from dataclasses import dataclass\n14: from enum import Enum\n15: from functools import lru_cache\n16: from typing import Any, Mapping, Sequence\n17: \n18: try:  # pragma: no cover - import guard only\n19:     import tiktoken\n20:     import tiktoken.model as _tiktoken_model\n21: \n22:     _tiktoken_model.MODEL_PREFIX_TO_ENCODING.setdefault(\"muse-spark\", \"o200k_base\")\n23: except ImportError:  # pragma: no cover - tiktoken is a declared dependency\n24:     tiktoken = None  # type: ignore[assignment]\n25: \n26: from src.integrations.repositories import JevClientProtocol\n27: \n28: \n29: # =============================================================================\n30: # Constants fixed by the specification\n31: # =============================================================================\n32: \n33: RECENT_TURN_COUNT = 6\n34: \n35: NEEDED_RETAIN_THRESHOLD = 0.7\n36: USER_FACT_RETAIN_THRESHOLD = 0.7\n37: BULK_STUB_THRESHOLD = 0.6\n38: DROP_BELOW_THRESHOLD = 0.3\n39: \n40: JEV_BATCH_SIZE = 50\n41: MAX_JEV_CALLS = 3\n42: \n43: DEFAULT_ENCODING_NAME = \"o200k_base\"\n44: \n45: \n46: class TokenizerError(RuntimeError):\n47:     \"\"\"Raised when no provider tokenizer is available for the model.\"\"\"\n48: \n49: \n50: # =============================================================================\n51: # History units\n52: # =============================================================================\n53: \n54: class UnitKind(str, Enum):\n55:     \"\"\"Category of one unit of conversation history.\"\"\"\n56: \n57:     USER = \"user\"\n58:     ASSISTANT = \"assistant\"\n59:     TOOL_RESULT = \"tool_result\"\n60:     APPROVAL = \"approval\"\n61:     DECISION = \"decision\"\n62:     SYSTEM = \"system\"\n63: \n64: \n65: class Verdict(str, Enum):\n66:     \"\"\"Outcome of the Tier 1 gate for one unit.\"\"\"\n67: \n68:     RETAIN = \"retain\"\n69:     STUB = \"stub\"\n70:     DROP = \"drop\"\n71: \n72: \n73: _KIND_BY_ROLE: dict[str, UnitKind] = {\n74:     \"user\": UnitKind.USER,\n75:     \"human\": UnitKind.USER,\n76:     \"assistant\": UnitKind.ASSISTANT,\n77:     \"ai\": UnitKind.ASSISTANT,\n78:     \"tool\": UnitKind.TOOL_RESULT,\n79:     \"tool_result\": UnitKind.TOOL_RESULT,\n80:     \"function\": UnitKind.TOOL_RESULT,\n81:     \"approval\": UnitKind.APPROVAL,\n82:     \"decision\": UnitKind.DECISION,\n83:     \"system\": UnitKind.SYSTEM,\n84: }\n85: \n86: _LOCKED_KINDS = frozenset({UnitKind.USER, UnitKind.APPROVAL, UnitKind.DECISION})\n87: \n88: \n89: @dataclass(frozen=True)\n90: class HistoryUnit:\n91:     \"\"\"One addressable unit of conversation history.\n92: \n93:     A unit is one message. Tool units carry the provenance that the artifact\n94:     stub needs: tool name, command, size, exit code, and artifact id.\n95:     \"\"\"\n96: \n97:     unit_id: str\n98:     role: str\n99:     content: str\n100:     kind: UnitKind"}
