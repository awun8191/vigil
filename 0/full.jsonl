{"step_index":25,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:46:03Z","content":"Created At: 2026-11-10T17:46:03Z\nCompleted At: 2026-11-10T17:46:04Z\nShowing lines 250-416 of 416\n250:         command: str | None = None,\n251:         url: str | None = None,\n252:     ) -> MCPServerDTO:\n253:         \"\"\"Handshake with a third party server and store it with its tools.\n254: \n255:         A server that fails the handshake is not stored. The error names\n256:         the reason. Every discovered tool defaults to level ``external``.\n257:         Only the background worker calls this method, never a request handler.\n258:         \"\"\"\n259:         clean_name = (name or \"\").strip()\n260:         if not clean_name:\n261:             raise MCPRegistrationError(\"a server name must not be empty\")\n262:         if transport not in (\"stdio\", \"sse\"):\n263:             raise MCPRegistrationError(\n264:                 f\"unknown transport {transport!r}: use 'stdio' or 'sse'\"\n265:             )\n266:         if transport == \"stdio\" and not (command or \"\").strip():\n267:             raise MCPRegistrationError(\"a stdio server needs a command\")\n268:         if transport == \"sse\" and not (url or \"\").strip():\n269:             raise MCPRegistrationError(\"an SSE server needs a URL\")\n270:         if await self.get_mcp_server(clean_name) is not None:\n271:             raise MCPRegistrationError(\n272:                 f\"an MCP server named {clean_name!r} is already registered\"\n273:             )\n274:         tools = await discover_tools(\n275:             MCPServerConfig(\n276:                 name=clean_name, transport=transport, command=command, url=url\n277:             )\n278:         )\n279:         self._check_tool_collisions(tools)\n280:         server_id = uuid4()\n281:         now = datetime.now(timezone.utc)\n282:         stored = await self.repository.register_server(\n283:             MCPServerDTO(\n284:                 id=server_id,\n285:                 name=clean_name,\n286:                 transport=transport,\n287:                 command=command,\n288:                 url=url,\n289:                 enabled=True,\n290:                 created_at=now,\n291:             )\n292:         )\n293:         self._cache_server(stored)\n294:         for tool in tools:\n295:             key = (server_id, tool.name)\n296:             self._mcp_tools[key] = MCPDiscoveredToolDTO(\n297:                 server_id=server_id,\n298:                 server_name=clean_name,\n299:                 name=tool.name,\n300:                 description=tool.description,\n301:                 input_schema=dict(tool.input_schema),\n302:                 level=\"external\",\n303:             )\n304:         return stored\n305: \n306:     async def list_mcp_servers(self) -> list[MCPServerDTO]:\n307:         \"\"\"Return every registered third party MCP server.\"\"\"\n308:         servers = await self.repository.list_servers()\n309:         live = {server.id for server in servers}\n310:         for server in servers:\n311:             self._cache_server(server)\n312:         for server_id in [sid for sid in self._mcp_servers if sid not in live]:\n313:             self._forget_server(self._mcp_servers[server_id])\n314:         return servers\n315: \n316:     async def get_mcp_server(self, name: str) -> MCPServerDTO | None:\n317:         \"\"\"Return the registered server with this name, or None.\"\"\"\n318:         clean_name = (name or \"\").strip()\n319:         server = await self.repository.get_server(clean_name)\n320:         if server is None:\n321:             cached = self._mcp_servers_by_name.get(clean_name)\n322:             if cached is not None:\n323:                 self._forget_server(cached)\n324:             return None\n325:         self._cache_server(server)\n326:         return server\n327: \n328:     async def list_mcp_tools(self, server_name: str) -> list[MCPDiscoveredToolDTO]:\n329:         \"\"\"Return the discovered tools of one registered server.\"\"\"\n330:         server = await self.get_mcp_server(server_name)\n331:         if server is None:\n332:             return []\n333:         return [\n334:             tool\n335:             for (server_id, _), tool in self._mcp_tools.items()\n336:             if server_id == server.id\n337:         ]\n338: \n339:     async def unregister_mcp_server(self, name: str) -> bool:\n340:         \"\"\"Remove a server and its discovered tools. Return True when removed.\"\"\"\n341:         clean_name = (name or \"\").strip()\n342:         server = await self.repository.get_server(clean_name)\n343:         if server is None:\n344:             cached = self._mcp_servers_by_name.get(clean_name)\n345:             if cached is not None:\n346:                 self._forget_server(cached)\n347:             return False\n348:         removed = await self.repository.delete_server(server.name)\n349:         if removed:\n350:             self._forget_server(server)\n351:         return removed\n352: \n353:     async def refresh_mcp_tools(\n354:         self, server_name: str\n355:     ) -> list[MCPDiscoveredToolDTO]:\n356:         \"\"\"Re-run discovery for a registered server and replace its tools.\n357: \n358:         The worker runs this method inside the ``discover_mcp_tools`` job.\n359:         A failed handshake keeps the stored tools and names the reason.\n360:         \"\"\"\n361:         server = await self.get_mcp_server(server_name)\n362:         if server is None:\n363:             raise MCPRegistrationError(\n364:                 f\"no MCP server named {server_name!r} is registered\"\n365:             )\n366:         tools = await discover_tools(\n367:             MCPServerConfig(\n368:                 name=server.name,\n369:                 transport=server.transport,\n370:                 command=server.command,\n371:                 url=server.url,\n372:             )\n373:         )\n374:         self._check_tool_collisions(tools)\n375:         for key in [key for key in self._mcp_tools if key[0] == server.id]:\n376:             del self._mcp_tools[key]\n377:         refreshed: list[MCPDiscoveredToolDTO] = []\n378:         for tool in tools:\n379:             dto = MCPDiscoveredToolDTO(\n380:                 server_id=server.id,\n381:                 server_name=server.name,\n382:                 name=tool.name,\n383:                 description=tool.description,\n384:                 input_schema=dict(tool.input_schema),\n385:                 level=\"external\",\n386:             )\n387:             self._mcp_tools[(server.id, tool.name)] = dto\n388:             refreshed.append(dto)\n389:         return refreshed\n390: \n391:     async def set_mcp_tool_level(\n392:         self, server_name: str, tool_name: str, level: str\n393:     ) -> MCPDiscoveredToolDTO | None:\n394:         \"\"\"Lower (or reset) a discovered tool approval level as an explicit act.\"\"\"\n395:         if level not in (\"read\", \"local\", \"external\"):\n396:             raise MCPRegistrationError(\n397:                 f\"unknown approval level {level!r}: \"\n398:                 \"use 'read', 'local', or 'external'\"\n399:             )\n400:         server = await self.get_mcp_server(server_name)\n401:         if server is None:\n402:             return None\n403:         key = (server.id, tool_name)\n404:         tool = self._mcp_tools.get(key)\n405:         if tool is None:\n406:             return None\n407:         updated = MCPDiscoveredToolDTO(\n408:             server_id=tool.server_id,\n409:             server_name=tool.server_name,\n410:             name=tool.name,\n411:             description=tool.description,\n412:             input_schema=dict(tool.input_schema),\n413:             level=level,\n414:         )\n415:         self._mcp_tools[key] = updated\n416:         return updated"}
{"step_index":26,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:46:03Z","content":"Created At: 2026-11-10T17:46:03Z\nCompleted At: 2026-11-10T17:46:04Z\nShowing lines 1-269 of 269\n1: \"\"\"Core tool harness: nine stateless tools over the sandbox runner.\n2: \n3: Every tool declares a name, a JSON schema, and an approval level. The level is ``read``,\n4: ``local`` or ``external``. A call validates its arguments against the tool schema first.\n5: Only then does the handler run. The handler calls the sandbox runner protocol or it\n6: writes a file to the delivery directory.\n7: \n8: A call returns a :class:`ToolResult` with ``{ok, content, artifact_ref, error}``. A tool\n9: never raises across this boundary. Approval logic is not here. V-07 owns the approval\n10: gate. ``ask_user`` is the only ``external`` tool. It returns a pending marker and does\n11: not block.\n12: \"\"\"\n13: from __future__ import annotations\n14: \n15: import inspect\n16: from collections.abc import Awaitable, Callable, Mapping, Sequence\n17: from dataclasses import dataclass\n18: from pathlib import Path\n19: from types import MappingProxyType\n20: from typing import Any, Literal\n21: \n22: from pydantic import BaseModel, ConfigDict, Field, ValidationError\n23: \n24: from src.integrations.repositories import SandboxRunnerProtocol\n25: \n26: ApprovalLevel = Literal[\"read\", \"local\", \"external\"]\n27: \n28: #: Every approval level that a tool can declare.\n29: APPROVAL_LEVELS: tuple[ApprovalLevel, ...] = (\"read\", \"local\", \"external\")\n30: \n31: #: The harness exposes built-in tools.\n32: TOOL_COUNT = 12\n33: \n34: \n35: class ToolResult(BaseModel):\n36:     \"\"\"The structured result of one tool call.\n37: \n38:     The object has the four keys of the tool call contract. ``content`` holds the tool\n39:     output. ``artifact_ref`` holds a host path when the tool produced a file. ``error``\n40:     holds a message when ``ok`` is false.\n41:     \"\"\"\n42: \n43:     model_config = ConfigDict(frozen=True)\n44: \n45:     ok: bool = Field(..., description=\"True when the call succeeded.\")\n46:     content: Any = Field(\n47:         default=None,\n48:         description=\"Tool output. A string, a dictionary, or null.\",\n49:     )\n50:     artifact_ref: str | None = Field(\n51:         default=None,\n52:         description=\"Host path of a produced file, or null.\",\n53:     )\n54:     error: str | None = Field(\n55:         default=None,\n56:         description=\"Failure message when ok is false, else null.\",\n57:     )\n58: \n59:     @classmethod\n60:     def success(cls, content: Any = None, *, artifact_ref: str | None = None) -> \"ToolResult\":\n61:         \"\"\"Build a successful result.\"\"\"\n62:         return cls(ok=True, content=content, artifact_ref=artifact_ref, error=None)\n63: \n64:     @classmethod\n65:     def failure(cls, error: str, *, content: Any = None) -> \"ToolResult\":\n66:         \"\"\"Build a failed result.\"\"\"\n67:         return cls(ok=False, content=content, artifact_ref=None, error=error)\n68: \n69: \n70: @dataclass(frozen=True)\n71: class ToolContext:\n72:     \"\"\"The runner and the delivery directory for one tool call.\n73: \n74:     The context holds no state. The caller builds it for each call.\n75:     \"\"\"\n76: \n77:     runner: SandboxRunnerProtocol\n78:     container_id: str\n79:     delivery_dir: Path\n80: \n81: \n82: Handler = Callable[[Any, ToolContext], Awaitable[ToolResult]]\n83: \n84: \n85: @dataclass(frozen=True)\n86: class Tool:\n87:     \"\"\"One tool: a name, a description, a JSON schema, a level, and a handler.\"\"\"\n88: \n89:     name: str\n90:     description: str\n91:     level: ApprovalLevel\n92:     args_model: type[BaseModel]\n93:     handler: Handler\n94:     input_schema: dict[str, Any]\n95: \n96:     @classmethod\n97:     def define(\n98:         cls,\n99:         *,\n100:         name: str,\n101:         description: str,\n102:         level: ApprovalLevel,\n103:         args_model: type[BaseModel],\n104:         handler: Handler,\n105:     ) -> \"Tool\":\n106:         \"\"\"Build a tool and derive its JSON schema from the argument model.\"\"\"\n107:         if not name or not name.strip():\n108:             raise ValueError(\"a tool name must not be empty\")\n109:         if level not in APPROVAL_LEVELS:\n110:             raise ValueError(f\"unknown approval level: {level!r}\")\n111:         if not issubclass(args_model, BaseModel):\n112:             raise TypeError(\"args_model must be a pydantic BaseModel subclass\")\n113:         return cls(\n114:             name=name,\n115:             description=description,\n116:             level=level,\n117:             args_model=args_model,\n118:             handler=handler,\n119:             input_schema=args_model.model_json_schema(),\n120:         )\n121: \n122:     def validate(self, arguments: Mapping[str, Any]) -> BaseModel:\n123:         \"\"\"Validate the arguments against the tool schema.\n124: \n125:         The method raises ``TypeError`` for a non mapping and ``ValidationError`` for a\n126:         bad value. It does not touch the runner.\n127:         \"\"\"\n128:         if not isinstance(arguments, Mapping):\n129:             raise TypeError(\"tool arguments must be a mapping\")\n130:         return self.args_model.model_validate(dict(arguments))\n131: \n132:     async def invoke(self, arguments: Mapping[str, Any], context: ToolContext) -> ToolResult:\n133:         \"\"\"Validate the arguments, then run the handler. It never raises.\"\"\"\n134:         try:\n135:             parsed = self.validate(arguments)\n136:         except (ValidationError, TypeError, ValueError) as exc:\n137:             return ToolResult.failure(f\"invalid arguments for tool {self.name!r}: {exc}\")\n138:         try:\n139:             outcome = self.handler(parsed, context)\n140:             if inspect.isawaitable(outcome):\n141:                 outcome = await outcome\n142:         except Exception as exc:  # noqa: BLE001 - the boundary must not raise\n143:             return ToolResult.failure(\n144:                 f\"tool {self.name!r} failed: {type(exc).__name__}: {exc}\"\n145:             )\n146:         if not isinstance(outcome, ToolResult):\n147:             return ToolResult.failure(\n148:                 f\"tool {self.name!r} returned {type(outcome).__name__}, not ToolResult\"\n149:             )\n150:         return outcome\n151: \n152: \n153: # The tool modules import the shared types above, so they load after the definitions.\n154: from src.modules.runs.tools.delivery import DELIVERY_TOOLS  # noqa: E402\n155: from src.modules.runs.tools.files import FILE_TOOLS  # noqa: E402\n156: from src.modules.runs.tools.human import HUMAN_TOOLS  # noqa: E402\n157: from src.modules.runs.tools.search import EXA_TOOLS  # noqa: E402\n158: from src.modules.runs.tools.shell import SHELL_TOOLS  # noqa: E402\n159: from src.modules.runs.tools.skills import SKILL_TOOLS  # noqa: E402\n160: from src.modules.runs.tools.tasks import TASK_TOOLS  # noqa: E402\n161: \n162: \n163: def build_registry(tools: Sequence[Tool]) -> Mapping[str, Tool]:\n164:     \"\"\"Index tools by name. A duplicate name is an error.\"\"\"\n165:     registry: dict[str, Tool] = {}\n166:     for tool in tools:\n167:         if tool.name in registry:\n168:             raise ValueError(f\"duplicate tool name: {tool.name!r}\")\n169:         registry[tool.name] = tool\n170:     return MappingProxyType(registry)\n171: \n172: \n173: #: The core tools of the harness, indexed by name. It is read only.\n174: TOOLS: Mapping[str, Tool] = build_registry(\n175:     (\n176:         *FILE_TOOLS,\n177:         *SHELL_TOOLS,\n178:         *DELIVERY_TOOLS,\n179:         *HUMAN_TOOLS,\n180:         *TASK_TOOLS,\n181:         *SKILL_TOOLS,\n182:         *EXA_TOOLS,\n183:     )\n184: )\n185: \n186: \n187: def get_tool(name: str) -> Tool:\n188:     \"\"\"Return the tool with this name. A missing name raises ``KeyError``.\"\"\"\n189:     try:\n190:         return TOOLS[name]\n191:     except KeyError:\n192:         raise KeyError(f\"unknown tool: {name!r}\") from None\n193: \n194: \n195: async def invoke_tool(\n196:     name: str,\n197:     arguments: Mapping[str, Any],\n198:     context: ToolContext,\n199: ) -> ToolResult:\n200:     \"\"\"Call a tool by name. An unknown name returns a failed result.\"\"\"\n201:     tool = TOOLS.get(name)\n202:     if tool is None:\n203:         return ToolResult.failure(f\"unknown tool: {name!r}\")\n204:     return await tool.invoke(arguments, context)\n205: \n206: \n207: def openai_tool_declarations(names: Sequence[str] | None = None) -> list[dict[str, Any]]:\n208:     \"\"\"Return tools in the OpenAI `tools` wire shape.\n209: \n210:     The provider expects `{\"type\": \"function\", \"function\": {...}}`. Passing the\n211:     internal declaration shape straight through makes the model believe it has\n212:     no tools at all, and it answers \"I cannot run commands\".\n213: \n214:     Args:\n215:         names: Tool names to include. ``None`` includes the whole registry.\n216: \n217:     Returns:\n218:         One declaration per tool, ready for the request payload.\n219:     \"\"\"\n220:     selected = (\n221:         list(names) if names is not None\n222:         else list(TOOLS.keys())\n223:     )\n224:     declarations: list[dict[str, Any]] = []\n225:     for name in selected:\n226:         tool = TOOLS.get(name)\n227:         if tool is None:\n228:             continue\n229:         declarations.append(\n230:             {\n231:                 \"type\": \"function\",\n232:                 \"function\": {\n233:                     \"name\": tool.name,\n234:                     \"description\": tool.description,\n235:                     \"parameters\": dict(tool.input_schema),\n236:                 },\n237:             }\n238:         )\n239:     return declarations\n240: \n241: \n242: def tool_definitions() -> list[dict[str, Any]]:\n243:     \"\"\"Return the tool declarations for the model prompt.\"\"\"\n244:     return [\n245:         {\n246:             \"name\": tool.name,\n247:             \"description\": tool.description,\n248:             \"parameters\": tool.input_schema,\n249:             \"level\": tool.level,\n250:         }\n251:         for tool in TOOLS.values()\n252:     ]\n253: \n254: \n255: __all__ = [\n256:     \"APPROVAL_LEVELS\",\n257:     \"ApprovalLevel\",\n258:     \"Handler\",\n259:     \"TOOLS\",\n260:     \"TOOL_COUNT\",\n261:     \"Tool\",\n262:     \"ToolContext\",\n263:     \"ToolResult\",\n264:     \"build_registry\",\n265:     \"get_tool\",\n266:     \"openai_tool_declarations\",\n267:     \"invoke_tool\",\n268:     \"tool_definitions\",\n269: ]"}
