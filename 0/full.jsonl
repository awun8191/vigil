null);\n241:       queryClient.setQueryData<StreamMessage[]>(messagesKey(target), (current) => {\n242:         const optimistic: StreamMessage = {\n243:           id: localId,\n244:           session_id: target,\n245:           role: 'user',\n246:           content: trimmed,\n247:           created_at: new Date().toISOString(),\n248:           local_state: 'sending',\n249:         };\n250:         return current ? [...current, optimistic] : [optimistic];\n251:       });\n252: \n253:       void api\n254:         .createRun(\n255:           {\n256:             config_id: configId,\n257:             session_id: target,\n258:             initial_prompt: trimmed,\n259:           },\n260:           `chat:send:${target}:${Date.now()}`,\n261:         )\n262:         .then((run: Run) => {\n263:           setActiveRunId(run.id);\n264:           queryClient.setQueryData(runKey(run.id), run);\n265:           if (optimisticIdRef.current) {\n266:             clearOptimisticFlag(optimisticIdRef.current);\n267:           }\n268:         })\n269:         .catch((cause: unknown) => {\n270:           optimisticIdRef.current = null;\n271:           if (target) {\n272:             const reason = userMessageOf(cause);\n273:             queryClient.setQueryData<StreamMessage[]>(messagesKey(target), (current) =>\n274:               current\n275:                 ? current.map((m) =>\n276:                     m.id === localId\n277:                       ? { ...m, local_state: 'failed', failure_class: 'network', failure_reason: reason }\n278:                       : m,\n279:                   )\n280:                 : current,\n281:             );\n282:           }\n283:           setError(userMessageOf(cause));\n284:         });\n285:     },\n286:     [defaultConfig.data, queryClient, clearOptimisticFlag],\n287:   );\n288: \n289:   const stop = useCallback(() => {\n290:     if (!activeRunId) return;\n291:     cancelRunMutation.mutate({ runId: activeRunId, scope: `run:cancel:${activeRunId}` }