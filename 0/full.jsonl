{"step_index":268,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:07:23Z","content":"Created At: 2026-11-11T10:07:23Z\nCompleted At: 2026-11-11T10:07:23Z\nShowing lines 1-100 of 108\n1: import { Suspense, lazy, useEffect, type ReactNode } from 'react';\n2: import { BrowserRouter, Navigate, Outlet, Route, Routes, useLocation } from 'react-router-dom';\n3: import { QueryClient, QueryClientProvider } from '@tanstack/react-query';\n4: import { AmbientBackground } from '@/components/layout/AmbientBackground';\n5: import { api, IS_MOCK, setAuthFailureHandler } from '@/lib/api';\n6: import LandingRoute from '@/routes/LandingRoute';\n7: import HomeRoute from '@/routes/HomeRoute';\n8: import PairRoute from '@/routes/PairRoute';\n9: import ChatRoute from '@/routes/ChatRoute';\n10: import { useSession } from '@/store/useSession';\n11: \n12: const SettingsRoute = lazy(() => import('@/routes/SettingsRoute'));\n13: \n14: const queryClient = new QueryClient({\n15:   defaultOptions: {\n16:     queries: {\n17:       retry: 1,\n18:       refetchOnWindowFocus: false,\n19:       staleTime: 10_000,\n20:     },\n21:   },\n22: });\n23: \n24: function AppShell() {\n25:   return (\n26:     <div className=\"relative min-h-dvh\">\n27:       <div id=\"main\">\n28:         <Outlet />\n29:       </div>\n30: \n31:       {IS_MOCK ? (\n32:         <div className=\"fixed bottom-0 left-0 right-0 z-50 bg-[var(--accent)] px-3 py-1 text-center text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--accent-ink)]\">\n33:           Simulation mode, no backend\n34:         </div>\n35:       ) : null}\n36:     </div>\n37:   );\n38: }\n39: \n40: /**\n41:  * The shell must never render unauthenticated. A 401 anywhere lands here exactly once, because\n42:  * `setAuthFailureHandler` is debounced per token in `lib/api.ts`. The landing page at `/` stays\n43:  * public: unpaired visitors read it, paired users are sent straight to `/agent`.\n44:  */\n45: function AuthGate({ children }: { children: ReactNode }) {\n46:   const status = useSession((state) => state.status);\n47:   const hydrate = useSession((state) => state.hydrate);\n48:   const expire = useSession((state) => state.expire);\n49:   const location = useLocation();\n50: \n51:   useEffect(() => {\n52:     setAuthFailureHandler(() => expire());\n53:     void hydrate(() => api.me());\n54:     return () => setAuthFailureHandler(null);\n55:   }, [hydrate, expire]);\n56: \n57:   if (status === 'loading') {\n58:     return (\n59:       <div className=\"flex min-h-dvh items-center justify-center\">\n60:         <span className=\"text-[13px] text-[var(--text-muted)]\">Connecting...</span>\n61:       </div>\n62:     );\n63:   }\n64: \n65:   if (status === 'unauthed') {\n66:     if (location.pathname === '/pair' || location.pathname === '/') return <>{children}</>;\n67:     return <Navigate to=\"/pair\" replace state={{ from: location.pathname }} />;\n68:   }\n69: \n70:   if (location.pathname === '/pair') {\n71:     return <Navigate to=\"/agent\" replace />;\n72:   }\n73: \n74:   // The landing stays reachable for everyone, paired or not, so `Log in` can always be linked.\n75:   return <>{children}</>;\n76: }\n77: \n78: export default function App() {\n79:   return (\n80:     <QueryClientProvider client={queryClient}>\n81:       <BrowserRouter>\n82:         <AmbientBackground />\n83:         <AuthGate>\n84:           <Suspense fallback={null}>\n85:             <Routes>\n86:               <Route path=\"/pair\" element={<PairRoute />} />\n87: \n88:               <Route path=\"/\" element={<LandingRoute />} />\n89: \n90:               <Route element={<AppShell />}>\n91:                 <Route path=\"/agent\" element={<HomeRoute />} />\n92:                 <Route path=\"/agent/chat\" element={<ChatRoute />} />\n93:                 <Route path=\"/agent/chat/:sessionId\" element={<ChatRoute />} />\n94:                 <Route\n95:                   path=\"/agent/settings\"\n96:                   element={<Navigate to=\"/agent/settings/appearance\" replace />}\n97:                 />\n98:                 <Route path=\"/agent/settings/:section\" element={<SettingsRoute />} />\n99:               </Route>\n100: "}
