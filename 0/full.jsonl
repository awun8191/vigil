{"step_index":23,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:45:52Z","content":"Created At: 2026-11-10T17:45:52Z\nCompleted At: 2026-11-10T17:45:53Z\nShowing lines 1-250 of 416\n1: \"\"\"Connectors service implementing MCP integration, OAuth encryption, and delta sync.\"\"\"\n2: from __future__ import annotations\n3: \n4: from datetime import datetime, timezone\n5: import json\n6: from dataclasses import dataclass\n7: from typing import ClassVar\n8: from uuid import UUID, uuid4\n9: from sqlalchemy.ext.asyncio import AsyncSession\n10: \n11: from src.config.security import encrypt_secret\n12: from src.config.settings import Settings\n13: from src.integrations.mcp.mcp import (\n14:     MCPHandshakeError,\n15:     MCPServerConfig,\n16:     MCPToolCollisionError,\n17:     MCPToolDefinition,\n18:     discover_tools,\n19: )\n20: from src.integrations.repositories import MCPHostProtocol\n21: from src.modules.audit.repository import AuditRepository\n22: from src.modules.audit.service import (\n23:     ACTION_CONNECTOR_CONNECT,\n24:     AuditService,\n25:     record_event,\n26: )\n27: from src.modules.connectors.data import RegisterConnectorRequest, SyncTriggerResponse\n28: from src.modules.connectors.errors import MCPRegistrationError\n29: from src.modules.connectors.repository import (\n30:     ConnectorAccountCreateDTO,\n31:     ConnectorAccountDTO,\n32:     ItemCreateDTO,\n33:     ItemDTO,\n34:     MCPServerDTO,\n35:     SyncStateDTO,\n36: )\n37: from src.modules.connectors.state import (\n38:     ConnectorStore,\n39:     InMemoryConnectorStore,\n40:     SqlConnectorStore,\n41: )\n42: \n43: # MCPRegistrationError is defined in errors.py so the store can raise it without\n44: # importing this module, and it stays importable from here as it always was.\n45: \n46: \n47: @dataclass(frozen=True)\n48: class MCPDiscoveredToolDTO:\n49:     \"\"\"A tool discovered on a registered third party MCP server.\"\"\"\n50: \n51:     server_id: UUID\n52:     server_name: str\n53:     name: str\n54:     description: str\n55:     input_schema: dict\n56:     level: str  # \"read\", \"local\", or \"external\"\n57: \n58: \n59: class ConnectorsService:\n60:     \"\"\"\n61:     Connectors service satisfying ConnectorsRepository via duck typing.\n62: \n63:     The constructor picks the store: the SQL implementation over\n64:     ``connected_accounts`` and ``mcp_servers`` on a request database session,\n65:     the in-memory one when the service is built without a session (tests, the\n66:     CLI harness). Accounts and MCP servers therefore survive a restart.\n67: \n68:     The ClassVar dicts below are a read-through cache, not the source of\n69:     truth. ``MCPHostClient`` in ``integrations/mcp/mcp.py`` reads\n70:     ``_mcp_servers_by_name`` and ``_mcp_tools`` directly, so every store read\n71:     and write refreshes them.\n72:     \"\"\"\n73: \n74:     _sync_states: ClassVar[dict[UUID, SyncStateDTO]] = {}\n75:     _items: ClassVar[dict[UUID, ItemDTO]] = {}\n76:     _items_by_external: ClassVar[dict[tuple[UUID, str], ItemDTO]] = {}\n77: \n78:     def __init__(\n79:         self,\n80:         session: AsyncSession | None,\n81:         settings: Settings,\n82:         mcp_host: MCPHostProtocol | None = None,\n83:         audit: AuditRepository | None = None,\n84:         repository: ConnectorStore | None = None,\n85:     ) -> None:\n86:         self.session = session\n87:         self.settings = settings\n88:         self.mcp_host = mcp_host\n89:         self.audit = audit or AuditService(session=session, settings=settings)\n90:         if repository is not None:\n91:             self.repository: ConnectorStore = repository\n92:         elif session is not None:\n93:             self.repository = SqlConnectorStore(session)\n94:         else:\n95:             self.repository = InMemoryConnectorStore()\n96: \n97:     async def get_account(self, account_id: UUID) -> ConnectorAccountDTO | None:\n98:         return await self.repository.get_account(account_id)\n99: \n100:     async def list_accounts(self, user_id: UUID) -> list[ConnectorAccountDTO]:\n101:         return await self.repository.list_accounts(user_id)\n102: \n103:     async def save_account(self, data: ConnectorAccountCreateDTO) -> ConnectorAccountDTO:\n104:         return await self.repository.save_account(data)\n105: \n106:     async def update_account_status(\n107:         self,\n108:         account_id: UUID,\n109:         status: str,\n110:     ) -> ConnectorAccountDTO | None:\n111:         return await self.repository.update_account_status(account_id, status)\n112: \n113:     async def get_sync_state(self, account_id: UUID) -> SyncStateDTO | None:\n114:         return self._sync_states.get(account_id)\n115: \n116:     async def save_sync_state(self, state: SyncStateDTO) -> None:\n117:         self._sync_states[state.connector_account_id] = state\n118: \n119:     async def save_items(self, items: list[ItemCreateDTO]) -> list[ItemDTO]:\n120:         persisted: list[ItemDTO] = []\n121:         now = datetime.now(timezone.utc)\n122:         for item_data in items:\n123:             key = (item_data.connector_account_id, item_data.external_id)\n124:             if key in self._items_by_external:\n125:                 persisted.append(self._items_by_external[key])\n126:                 continue\n127:             item_id = uuid4()\n128:             dto = ItemDTO(\n129:                 id=item_id,\n130:                 connector_account_id=item_data.connector_account_id,\n131:                 external_id=item_data.external_id,\n132:                 thread_id=item_data.thread_id,\n133:                 sender=item_data.sender,\n134:                 recipients=item_data.recipients,\n135:                 subject=item_data.subject,\n136:                 body_text=item_data.body_text,\n137:                 received_at=item_data.received_at,\n138:                 labels=item_data.labels,\n139:                 raw_reference=item_data.raw_reference,\n140:                 created_at=now,\n141:             )\n142:             self._items[item_id] = dto\n143:             self._items_by_external[key] = dto\n144:             persisted.append(dto)\n145:         return persisted\n146: \n147:     async def get_item_by_external_id(self, account_id: UUID, external_id: str) -> ItemDTO | None:\n148:         return self._items_by_external.get((account_id, external_id))\n149: \n150:     async def get_item_by_id(self, item_id: UUID) -> ItemDTO | None:\n151:         return self._items.get(item_id)\n152: \n153:     # Domain Orchestration Methods\n154:     async def register_account(\n155:         self,\n156:         user_id: UUID,\n157:         req: RegisterConnectorRequest,\n158:     ) -> ConnectorAccountDTO:\n159:         \"\"\"Encrypt OAuth tokens using AES-256-GCM and persist account.\"\"\"\n160:         serialized_creds = json.dumps(req.raw_credentials)\n161:         encrypted = encrypt_secret(serialized_creds, self.settings.SECRET_KEY)\n162:         dto = ConnectorAccountCreateDTO(\n163:             user_id=user_id,\n164:             connector_id=req.connector_id,\n165:             account_label=req.account_label,\n166:             encrypted_credentials=encrypted,\n167:             scopes=req.scopes,\n168:         )\n169:         account = await self.save_account(dto)\n170: \n171:         # The account is saved now. The audit row names the account and the\n172:         # connector. It never carries the credentials or the ciphertext.\n173:         # record_event logs a failure and returns, so the connect still succeeds.\n174:         await record_event(\n175:             self.audit,\n176:             actor=\"user\",\n177:             action=ACTION_CONNECTOR_CONNECT,\n178:             subject=str(account.id),\n179:             details={\n180:                 \"user_id\": str(user_id),\n181:                 \"connector_id\": req.connector_id,\n182:                 \"account_label\": req.account_label,\n183:                 \"scopes\": list(req.scopes),\n184:             },\n185:         )\n186:         return account\n187: \n188:     async def trigger_sync(self, account_id: UUID) -> SyncTriggerResponse:\n189:         \"\"\"Enqueue delta sync background job for connector.\"\"\"\n190:         job_id = uuid4()\n191:         return SyncTriggerResponse(\n192:             account_id=account_id,\n193:             job_id=job_id,\n194:             status=\"queued\",\n195:         )\n196: \n197:     # External MCP server registry --------------------------------------\n198: \n199:     _mcp_servers: ClassVar[dict[UUID, MCPServerDTO]] = {}\n200:     _mcp_servers_by_name: ClassVar[dict[str, MCPServerDTO]] = {}\n201:     _mcp_tools: ClassVar[dict[tuple[UUID, str], MCPDiscoveredToolDTO]] = {}\n202: \n203:     @classmethod\n204:     def _cache_server(cls, server: MCPServerDTO) -> None:\n205:         \"\"\"Publish one stored server into the read-through cache mcp.py reads.\"\"\"\n206:         cls._mcp_servers[server.id] = server\n207:         cls._mcp_servers_by_name[server.name] = server\n208: \n209:     @classmethod\n210:     def _forget_server(cls, server: MCPServerDTO) -> None:\n211:         \"\"\"Drop one server and its cached tools from the read-through cache.\"\"\"\n212:         cls._mcp_servers.pop(server.id, None)\n213:         cls._mcp_servers_by_name.pop(server.name, None)\n214:         for key in [key for key in cls._mcp_tools if key[0] == server.id]:\n215:             del cls._mcp_tools[key]\n216: \n217:     @classmethod\n218:     def reset_mcp_cache(cls) -> None:\n219:         \"\"\"Empty the read-through cache mcp.py reads.\n220: \n221:         The cache is process-local, so a test that simulates a restart, or one\n222:         that needs a clean slate, empties it through this call rather than by\n223:         poking three class attributes.\n224:         \"\"\"\n225:         cls._mcp_servers.clear()\n226:         cls._mcp_servers_by_name.clear()\n227:         cls._mcp_tools.clear()\n228: \n229:     @staticmethod\n230:     def _builtin_tool_names() -> set[str]:\n231:         \"\"\"Return built-in tool names from the tool registry, not a fixed list.\"\"\"\n232:         from src.modules.runs.tools import TOOLS\n233: \n234:         return set(TOOLS)\n235: \n236:     @classmethod\n237:     def _check_tool_collisions(cls, tools: list[MCPToolDefinition]) -> None:\n238:         \"\"\"Reject a discovered tool that collides with a built-in tool.\"\"\"\n239:         builtin = cls._builtin_tool_names()\n240:         for tool in tools:\n241:             if tool.name in builtin:\n242:                 raise MCPToolCollisionError(\n243:                     f\"tool {tool.name!r} collides with a built-in tool\"\n244:                 )\n245: \n246:     async def register_mcp_server(\n247:         self,\n248:         name: str,\n249:         transport: str,\n250:         command: str | None = None,"}
