{"step_index":28,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T17:46:16Z","content":"Created At: 2026-11-10T17:46:16Z\nCompleted At: 2026-11-10T17:46:16Z\nShowing lines 300-757 of 757\n300: \n301: \n302: async def _join_drain(\n303:     stderr_task: asyncio.Task[None],\n304:     timeout: float = STDERR_DRAIN_JOIN_SECONDS,\n305: ) -> None:\n306:     \"\"\"Wait a short bounded time for the stderr drain to reach EOF.\n307: \n308:     The tail is read right after this call, so a drain that is still running\n309:     must not be racing the read. A server that is still alive never reaches EOF,\n310:     so the wait is bounded: it gives up and leaves the drain running for\n311:     ``_stop_stdio`` to cancel.\n312:     \"\"\"\n313:     if stderr_task.done():\n314:         return\n315:     try:\n316:         await asyncio.wait_for(asyncio.shield(stderr_task), timeout)\n317:     except TimeoutError:\n318:         return\n319: \n320: \n321: async def _terminate(proc: asyncio.subprocess.Process) -> None:\n322:     \"\"\"Terminate a server, kill it when it ignores SIGTERM, then reap it.\n323: \n324:     Both waits are shielded: a cancellation raises out of this coroutine but\n325:     never cancels the wait itself, so the child is still reaped.\n326:     \"\"\"\n327:     if proc.returncode is not None:\n328:         return\n329:     try:\n330:         proc.terminate()\n331:     except ProcessLookupError:\n332:         return\n333:     try:\n334:         await asyncio.wait_for(asyncio.shield(proc.wait()), STOP_TIMEOUT_SECONDS)\n335:         return\n336:     except TimeoutError:\n337:         pass\n338:     try:\n339:         proc.kill()\n340:     except ProcessLookupError:\n341:         return\n342:     with contextlib.suppress(TimeoutError):\n343:         await asyncio.wait_for(asyncio.shield(proc.wait()), STOP_TIMEOUT_SECONDS)\n344: \n345: \n346: async def _stop_stdio(\n347:     proc: asyncio.subprocess.Process,\n348:     stderr_task: asyncio.Task[None],\n349: ) -> None:\n350:     \"\"\"Stop the stderr drain first, then terminate the server and reap it.\n351: \n352:     The drain goes first: a cancellation that arrives during worker shutdown\n353:     would otherwise escape on the terminate wait and leave the drain task\n354:     running against a dead pipe. A cancellation during the terminate still\n355:     kills the child before it propagates, so no process leaks.\n356:     \"\"\"\n357:     stderr_task.cancel()\n358:     try:\n359:         await _terminate(proc)\n360:     except asyncio.CancelledError:\n361:         with contextlib.suppress(ProcessLookupError):\n362:             proc.kill()\n363:         raise\n364:     finally:\n365:         # The drain is already cancelled, so this join cannot block.\n366:         if not stderr_task.done():\n367:             with contextlib.suppress(asyncio.CancelledError, RuntimeError):\n368:                 await stderr_task\n369: \n370: \n371: async def _discover_stdio(command: str, timeout: float) -> list[dict[str, Any]]:\n372:     \"\"\"Run the handshake against a stdio server command and return raw tools.\"\"\"\n373:     proc, tail, stderr_task = await _spawn_stdio(command)\n374:     try:\n375:         await _handshake(proc, timeout)\n376:         result = await _exchange(\n377:             proc,\n378:             {\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"tools/list\", \"params\": {}},\n379:             timeout,\n380:             \"tools/list\",\n381:         )\n382:         return _normalize_tools(result.get(\"tools\"))\n383:     except MCPHandshakeError as exc:\n384:         # Let the drain finish reading what the server already wrote before\n385:         # the tail is read, or the message loses the server's own words.\n386:         await _join_drain(stderr_task)\n387:         detail = tail.text()\n388:         if not detail:\n389:             raise\n390:         raise MCPHandshakeError(f\"{exc} (server stderr: {detail})\") from exc\n391:     finally:\n392:         await _stop_stdio(proc, stderr_task)\n393: \n394: \n395: async def _discover_sse(server_url: str, timeout: float) -> list[dict[str, Any]]:\n396:     \"\"\"Run the handshake against an SSE / StreamMCP server URL and return raw tools.\"\"\"\n397:     # First attempt: modern HTTP StreamMCP / SSE POST tools/list\n398:     try:\n399:         async with httpx.AsyncClient(timeout=timeout) as client:\n400:             post_resp = await client.post(\n401:                 server_url,\n402:                 json={\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\", \"params\": {}},\n403:                 headers={\n404:                     \"Content-Type\": \"application/json\",\n405:                     \"Accept\": \"application/json, text/event-stream\",\n406:                     \"User-Agent\": \"vigil/1.0\",\n407:                 },\n408:             )\n409:             if post_resp.status_code == 200:\n410:                 body = post_resp.text\n411:                 for line in body.splitlines():\n412:                     trimmed = line.strip()\n413:                     if trimmed.startswith(\"data:\"):\n414:                         try:\n415:                             payload = json.loads(trimmed[len(\"data:\"):].strip())\n416:                             if isinstance(payload, dict) and \"result\" in payload and \"tools\" in payload[\"result\"]:\n417:                                 return _normalize_tools(payload[\"result\"][\"tools\"])\n418:                         except ValueError:\n419:                             pass\n420:                 try:\n421:                     payload = post_resp.json()\n422:                     if isinstance(payload, dict) and \"result\" in payload and \"tools\" in payload[\"result\"]:\n423:                         return _normalize_tools(payload[\"result\"][\"tools\"])\n424:                 except ValueError:\n425:                     pass\n426:     except (httpx.HTTPError, OSError):\n427:         pass\n428: \n429:     # Fallback attempt: classic GET event-stream handshake\n430:     try:\n431:         async with httpx.AsyncClient(timeout=timeout) as client:\n432:             async with client.stream(\n433:                 \"GET\", server_url, headers={\"Accept\": \"text/event-stream\"}\n434:             ) as response:\n435:                 if response.status_code != 200:\n436:                     raise MCPHandshakeError(\n437:                         \"SSE handshake failed: \"\n438:                         f\"GET {server_url} returned status {response.status_code}\"\n439:                     )\n440:                 async for line in response.aiter_lines():\n441:                     text = line.strip()\n442:                     if not text.startswith(\"data:\"):\n443:                         continue\n444:                     try:\n445:                         payload = json.loads(text[len(\"data:\"):].strip())\n446:                     except ValueError as exc:\n447:                         raise MCPHandshakeError(\n448:                             \"SSE handshake failed: invalid JSON event\"\n449:                         ) from exc\n450:                     if isinstance(payload, dict) and \"tools\" in payload:\n451:                         return _normalize_tools(payload.get(\"tools\"))\n452:                     if isinstance(payload, dict) and \"result\" in payload and \"tools\" in payload[\"result\"]:\n453:                         return _normalize_tools(payload[\"result\"][\"tools\"])\n454:                 raise MCPHandshakeError(\n455:                     \"SSE handshake failed: \"\n456:                     \"the stream closed without a tools event\"\n457:                 )\n458:     except MCPHandshakeError:\n459:         raise\n460:     except (httpx.HTTPError, OSError) as exc:\n461:         raise MCPHandshakeError(\n462:             f\"SSE handshake failed: cannot reach {server_url}: {exc}\"\n463:         ) from exc\n464: \n465: \n466: async def discover_tools(\n467:     config: MCPServerConfig,\n468:     timeout: float = HANDSHAKE_TIMEOUT_SECONDS,\n469: ) -> list[MCPToolDefinition]:\n470:     \"\"\"Handshake with a third party MCP server and return its tools.\n471: \n472:     Every discovered tool defaults to approval level ``external``. A caller\n473:     lowers the level through an explicit act, never here.\n474: \n475:     Raises:\n476:         MCPHandshakeError: The server failed the handshake. The message\n477:             names the reason, and the caller must not store the server.\n478:     \"\"\"\n479:     if config.transport == \"stdio\":\n480:         if not config.command or not config.command.strip():\n481:             raise MCPHandshakeError(\n482:                 \"stdio handshake failed: a stdio server needs a command\"\n483:             )\n484:         raw_tools = await _discover_stdio(config.command, timeout)\n485:     elif config.transport == \"sse\":\n486:         if not config.url or not config.url.strip():\n487:             raise MCPHandshakeError(\n488:                 \"SSE handshake failed: an SSE server needs a URL\"\n489:             )\n490:         raw_tools = await _discover_sse(config.url, SSE_TIMEOUT_SECONDS)\n491:     else:\n492:         raise MCPHandshakeError(\n493:             f\"handshake failed: unknown transport {config.transport!r}\"\n494:         )\n495:     return [\n496:         MCPToolDefinition(\n497:             name=tool[\"name\"],\n498:             description=tool[\"description\"]\n499:             if isinstance(tool[\"description\"], str)\n500:             else \"\",\n501:             input_schema=tool[\"input_schema\"]\n502:             if isinstance(tool[\"input_schema\"], dict)\n503:             else {},\n504:             level=\"external\",\n505:         )\n506:         for tool in raw_tools\n507:     ]\n508: \n509: \n510: async def _call_stdio_tool(\n511:     command: str,\n512:     tool_name: str,\n513:     arguments: dict[str, Any],\n514:     timeout: float = HANDSHAKE_TIMEOUT_SECONDS,\n515: ) -> tuple[str, bool]:\n516:     \"\"\"Invoke tools/call on a stdio MCP server and return (output, is_error).\"\"\"\n517:     proc, tail, stderr_task = await _spawn_stdio(command)\n518:     try:\n519:         await _handshake(proc, timeout)\n520:         result = await _exchange(\n521:             proc,\n522:             {\n523:                 \"jsonrpc\": \"2.0\",\n524:                 \"id\": 2,\n525:                 \"method\": \"tools/call\",\n526:                 \"params\": {\"name\": tool_name, \"arguments\": arguments},\n527:             },\n528:             timeout,\n529:             \"tools/call\",\n530:         )\n531:         is_error = bool(result.get(\"isError\", False))\n532:         content = result.get(\"content\")\n533:         if isinstance(content, list):\n534:             parts = [\n535:                 str(item.get(\"text\", item)) if isinstance(item, dict) else str(item)\n536:                 for item in content\n537:             ]\n538:             return \"\\n\".join(parts), is_error\n539:         if isinstance(content, str):\n540:             return content, is_error\n541:         return json.dumps(result), is_error\n542:     except MCPHandshakeError as exc:\n543:         # Let the drain finish reading what the server already wrote before\n544:         # the tail is read, or the message loses the server's own words.\n545:         await _join_drain(stderr_task)\n546:         detail = tail.text()\n547:         if not detail:\n548:             raise\n549:         raise MCPHandshakeError(f\"{exc} (server stderr: {detail})\") from exc\n550:     finally:\n551:         await _stop_stdio(proc, stderr_task)\n552: \n553: \n554: async def _call_sse_tool(\n555:     server_url: str,\n556:     tool_name: str,\n557:     arguments: dict[str, Any],\n558:     timeout: float = HANDSHAKE_TIMEOUT_SECONDS,\n559: ) -> tuple[str, bool]:\n560:     \"\"\"Invoke tools/call on an SSE / StreamMCP server URL and return (output, is_error).\n561: \n562:     The method fails closed. A reply it cannot parse, and a reply that carries\n563:     no ``result`` object, both return ``is_error=True``: neither proves the\n564:     server ran the tool, and a success would hand the model an invented result.\n565:     \"\"\"\n566:     payload = {\n567:         \"jsonrpc\": \"2.0\",\n568:         \"id\": 1,\n569:         \"method\": \"tools/call\",\n570:         \"params\": {\"name\": tool_name, \"arguments\": arguments},\n571:     }\n572:     async with httpx.AsyncClient(timeout=timeout) as client:\n573:         resp = await client.post(\n574:             server_url,\n575:             json=payload,\n576:             headers={\n577:                 \"Content-Type\": \"application/json\",\n578:                 \"Accept\": \"application/json, text/event-stream\",\n579:                 \"User-Agent\": \"vigil/1.0\",\n580:             },\n581:         )\n582:         if resp.status_code != 200:\n583:             return f\"HTTP error {resp.status_code}: {resp.text[:300]}\", True\n584:         body = resp.text\n585:         data: dict[str, Any] | None = None\n586:         for line in body.splitlines():\n587:             trimmed = line.strip()\n588:             if trimmed.startswith(\"data:\"):\n589:                 try:\n590:                     data = json.loads(trimmed[len(\"data:\"):].strip())\n591:                     break\n592:                 except ValueError:\n593:                     pass\n594:         if data is None:\n595:             try:\n596:                 data = resp.json()\n597:             except ValueError:\n598:                 return (\n599:                     \"SSE tools/call failed: the reply body is neither a JSON \"\n600:                     f\"object nor an SSE event; tool {tool_name!r} was not run: \"\n601:                     f\"{body[:300]!r}\",\n602:                     True,\n603:                 )\n604:         if not isinstance(data, dict):\n605:             return (\n606:                 f\"SSE tools/call failed: the reply is not a JSON object; \"\n607:                 f\"tool {tool_name!r} was not run\",\n608:                 True,\n609:             )\n610:         if \"error\" in data:\n611:             return f\"MCP server error: {data['error']}\", True\n612:         result = data.get(\"result\")\n613:         if not isinstance(result, dict):\n614:             return (\n615:                 f\"SSE tools/call failed: the reply carries no result object; \"\n616:                 f\"tool {tool_name!r} was not run\",\n617:                 True,\n618:             )\n619:         is_error = bool(result.get(\"isError\", False))\n620:         content = result.get(\"content\")\n621:         if isinstance(content, list):\n622:             parts = [\n623:                 str(item.get(\"text\", item)) if isinstance(item, dict) else str(item)\n624:                 for item in content\n625:             ]\n626:             return \"\\n\".join(parts), is_error\n627:         if isinstance(content, str):\n628:             return content, is_error\n629:         return json.dumps(result), is_error\n630: \n631: \n632: class MCPHostClient:\n633:     \"\"\"Host client satisfying MCPHostProtocol for registered MCP servers.\"\"\"\n634: \n635:     def __init__(self, settings: Any) -> None:\n636:         self.settings = settings\n637: \n638:     async def list_tools(self, connector_id: str) -> list[Any]:\n639:         from src.integrations.repositories import MCPToolDefinitionDTO\n640:         from src.modules.connectors.service import ConnectorsService\n641: \n642:         server = ConnectorsService._mcp_servers_by_name.get(connector_id)\n643:         if server is None:\n644:             return []\n645:         return [\n646:             MCPToolDefinitionDTO(\n647:                 name=tool.name,\n648:                 description=tool.description,\n649:                 input_schema=tool.input_schema,\n650:             )\n651:             for (sid, _), tool in ConnectorsService._mcp_tools.items()\n652:             if sid == server.id\n653:         ]\n654: \n655:     async def execute_tool(\n656:         self,\n657:         connector_id: str,\n658:         tool_name: str,\n659:         arguments: dict[str, Any],\n660:         tool_call_id: str = \"\",\n661:     ) -> Any:\n662:         from src.integrations.repositories import MCPToolResultDTO\n663:         from src.modules.connectors.service import ConnectorsService\n664: \n665:         server = ConnectorsService._mcp_servers_by_name.get(connector_id)\n666:         if server is None:\n667:             # No server carries ``connector_id`` as its name, and the builder\n668:             # never sets a real one: the tool name is the only remaining handle.\n669:             # Resolve by name only when exactly one registered server owns it,\n670:             # because a call addressed to one server must never run on another.\n671:             owners = sorted(\n672:                 {\n673:                     sid\n674:                     for (sid, tname) in ConnectorsService._mcp_tools\n675:                     if tname == tool_name\n676:                 }\n677:             )\n678:             if len(owners) > 1:\n679:                 names = sorted(\n680:                     ConnectorsService._mcp_servers[sid].name\n681:                     if sid in ConnectorsService._mcp_servers\n682:                     else str(sid)\n683:                     for sid in owners\n684:                 )\n685:                 return MCPToolResultDTO(\n686:                     tool_call_id=tool_call_id,\n687:                     output=(\n688:                         f\"MCP tool {tool_name!r} is ambiguous: servers \"\n689:                         f\"{', '.join(repr(name) for name in names)} all expose it \"\n690:                         f\"and connector {connector_id!r} names none of them; \"\n691:                         \"the tool was not run\"\n692:                     ),\n693:                     is_error=True,\n694:                 )\n695:             if len(owners) == 1:\n696:                 server = ConnectorsService._mcp_servers.get(owners[0])\n697:         if server is None:\n698:             # Never report success for a tool that was not run: an invented\n699:             # result would be fed back to the model as a real tool result.\n700:             return MCPToolResultDTO(\n701:                 tool_call_id=tool_call_id,\n702:                 output=(\n703:                     f\"MCP server {connector_id!r} is not registered or has no \"\n704:                     f\"transport; tool {tool_name!r} was not run\"\n705:                 ),\n706:                 is_error=True,\n707:             )\n708:         if server.transport == \"stdio\" and server.command:\n709:             try:\n710:                 output, is_error = await _call_stdio_tool(\n711:                     server.command, tool_name, dict(arguments)\n712:                 )\n713:                 return MCPToolResultDTO(\n714:                     tool_call_id=tool_call_id, output=output, is_error=is_error\n715:                 )\n716:             except Exception as exc:  # noqa: BLE001\n717:                 return MCPToolResultDTO(\n718:                     tool_call_id=tool_call_id, output=str(exc), is_error=True\n719:                 )\n720:         if server.transport == \"sse\" and server.url:\n721:             try:\n722:                 output, is_error = await _call_sse_tool(\n723:                     server.url, tool_name, dict(arguments)\n724:                 )\n725:                 return MCPToolResultDTO(\n726:                     tool_call_id=tool_call_id, output=output, is_error=is_error\n727:                 )\n728:             except Exception as exc:  # noqa: BLE001\n729:                 return MCPToolResultDTO(\n730:                     tool_call_id=tool_call_id, output=str(exc), is_error=True\n731:                 )\n732:         return MCPToolResultDTO(\n733:             tool_call_id=tool_call_id,\n734:             output=(\n735:                 f\"MCP server {server.name!r} has no usable transport \"\n736:                 f\"(transport={server.transport!r}); tool {tool_name!r} was not run\"\n737:             ),\n738:             is_error=True,\n739:         )\n740: \n741:     async def get_tool_approval_policy(\n742:         self,\n743:         connector_id: str,\n744:         tool_name: str,\n745:     ) -> str:\n746:         from src.modules.connectors.service import ConnectorsService\n747: \n748:         server = ConnectorsService._mcp_servers_by_name.get(connector_id)\n749:         if server is not None:\n750:             tool = ConnectorsService._mcp_tools.get((server.id, tool_name))\n751:             if tool is not None:\n752:                 return tool.level\n753:         return \"external\"\n754: \n755:     async def is_healthy(self) -> bool:\n756:         return True\n757: "}
