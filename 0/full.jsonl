{"step_index":216,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-11T10:01:59Z","input_tokens":3070,"cache_read_tokens":228917,"output_tokens":1137,"tool_calls":[{"name":"write_file","args":{"Content":"import { AlertCircle, Check, Maximize2 } from 'lucide-react';\nimport { useState } from 'react';\n\ninterface Props {\n  url?: string;\n  screenshotUrl?: string;\n  status?: 'active' | 'error' | 'success';\n  statusText?: string;\n  assistantNote?: string;\n  savedLabel?: string;\n}\n\nexport function HarkLiveBrowserCard({\n  url = 'https://dash.cloudflare.com/login',\n  screenshotUrl,\n  status = 'error',\n  statusText = 'Error',\n  assistantNote = \"On it. I'm signing in to Cloudflare to take down just the storefront. The data Worker and backend stay untouched.\",\n  savedLabel = 'Cloudflare login saved',\n}: Props) {\n  const [fullscreen, setFullscreen] = useState(false);\n\n  return (\n    <div className=\"my-3 max-w-2xl\">\n      {/* Browser Frame */}\n      <div className=\"relative overflow-hidden rounded-[22px] bg-white border border-[var(--border)] shadow-[var(--shadow)]\">\n        <div className=\"flex h-8 items-center gap-1.5 border-b border-gray-100 bg-gray-50/80 px-3 text-[11px] text-gray-400\">\n          <div className=\"flex gap-1\">\n            <span className=\"h-2 w-2 rounded-full bg-gray-300\" />\n            <span className=\"h-2 w-2 rounded-full bg-gray-300\" />\n            <span className=\"h-2 w-2 rounded-full bg-gray-300\" />\n          </div>\n          <span className=\"ml-2 truncate text-gray-500\">{url}</span>\n        </div>\n\n        {/* Browser viewport simulation */}\n        <div className=\"relative flex h-[280px] w-full items-center justify-center bg-gray-50 p-4\">\n          {screenshotUrl ? (\n            <img src={screenshotUrl} alt=\"Live browser preview\" className=\"h-full w-full object-contain\" />\n          ) : (\n            <div className=\"flex flex-col items-center justify-center rounded-xl border border-gray-200 bg-white p-6 shadow-sm\">\n              <div className=\"text-[14px] font-semibold text-gray-800\">Sign in with Google</div>\n              <div className=\"mt-1 text-[12px] text-gray-500\">Choose an account to continue to Cloudflare</div>\n            </div>\n          )}\n\n          {/* Bottom Right Floating Badge & Expand Button */}\n          <div className=\"absolute bottom-3 right-3 flex items-center gap-1.5\">\n            <div\n              className={`flex h-6 items-center gap-1.5 rounded-full px-2.5 text-[11px] font-semibold text-white ${\n                status === 'error' ? 'bg-[#DC2626]' : 'bg-[#10B981]'\n              }`}\n            >\n              {status === 'error' ? <AlertCircle size={12} /> : null}\n              <span>{statusText}</span>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => setFullscreen((v) => !v)}\n              className=\"flex h-6 w-6 items-center justify-center rounded-full bg-black/80 text-white hover:bg-black\"\n            >\n              <Maximize2 size={11} />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Accompanying Assistant Telemetry */}\n      {assistantNote ? (\n        <div className=\"mt-2.5 rounded-xl bg-[var(--card)] border border-[var(--border)] px-4 py-3 text-[13.5px] leading-relaxed text-[var(--text)]\">\n          {assistantNote}\n        </div>\n      ) : null}\n\n      {savedLabel ? (\n        <div className=\"mt-2 flex items-center gap-1.5 text-[12px] font-medium text-[var(--text-secondary)]\">\n          <Check size={13} className=\"text-[var(--text)]\" />\n          <span>{savedLabel}</span>\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nexport default HarkLiveBrowserCard;\n","Overwrite":true,"Path":"/home/nasbombz/Documents/Projects/vigil-agent/web/src/components/hark/HarkLiveBrowserCard.tsx"}}]}
