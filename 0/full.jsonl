{"step_index":696,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:49:36Z","content":"Created At: 2026-11-11T10:49:36Z\nCompleted At: 2026-11-11T10:49:36Z\nShowing lines 1-100 of 203\n1: import { create } from 'zustand';\n2: import type { AuthMe, PairingResponse } from '@/types';\n3: import { getBearerToken, IS_MOCK, setBearerToken } from '@/lib/api';\n4: import { AuthError } from '@/lib/errors';\n5: \n6: /**\n7:  * Session state.\n8:  *\n9:  * The bearer token is held in memory for the session and persisted in IndexedDB so a reload does\n10:  * not force re-pairing. Never localStorage (readable by any script on the origin), never a query\n11:  * string (lands in access logs and Referer), never a cookie in v1 (needs CSRF handling).\n12:  */\n13: \n14: const DB_NAME = 'vigil';\n15: const STORE = 'auth';\n16: const RECORD_KEY = 'device';\n17: \n18: interface StoredSession {\n19:   token: string;\n20:   deviceId: string;\n21:   deviceName: string;\n22: }\n23: \n24: function openDb(): Promise<IDBDatabase> {\n25:   return new Promise((resolve, reject) => {\n26:     const request = indexedDB.open(DB_NAME, 1);\n27:     request.onupgradeneeded = () => {\n28:       const db = request.result;\n29:       if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE);\n30:     };\n31:     request.onsuccess = () => resolve(request.result);\n32:     request.onerror = () => reject(request.error ?? new Error('IndexedDB unavailable'));\n33:   });\n34: }\n35: \n36: async function readStoredSession(): Promise<StoredSession | null> {\n37:   try {\n38:     const db = await openDb();\n39:     return await new Promise<StoredSession | null>((resolve, reject) => {\n40:       const tx = db.transaction(STORE, 'readonly');\n41:       const request = tx.objectStore(STORE).get(RECORD_KEY);\n42:       request.onsuccess = () => resolve((request.result as StoredSession | undefined) ?? null);\n43:       request.onerror = () => reject(request.error);\n44:     });\n45:   } catch {\n46:     return null;\n47:   }\n48: }\n49: \n50: async function writeStoredSession(value: StoredSession): Promise<void> {\n51:   try {\n52:     const db = await openDb();\n53:     await new Promise<void>((resolve, reject) => {\n54:       const tx = db.transaction(STORE, 'readwrite');\n55:       tx.objectStore(STORE).put(value, RECORD_KEY);\n56:       tx.oncomplete = () => resolve();\n57:       tx.onerror = () => reject(tx.error);\n58:     });\n59:   } catch {\n60:     // Storage is a convenience. A failure here only costs a re-pair on reload.\n61:   }\n62: }\n63: \n64: async function clearStoredSession(): Promise<void> {\n65:   try {\n66:     const db = await openDb();\n67:     await new Promise<void>((resolve) => {\n68:       const tx = db.transaction(STORE, 'readwrite');\n69:       tx.objectStore(STORE).delete(RECORD_KEY);\n70:       tx.oncomplete = () => resolve();\n71:       tx.onerror = () => resolve();\n72:     });\n73:   } catch {\n74:     // Nothing to clean up.\n75:   }\n76: }\n77: \n78: export type SessionStatus = 'loading' | 'unauthed' | 'authed';\n79: \n80: /**\n81:  * A simulation build has no server to pair with, so a pairing gate would be a dead end that can\n82:  * never be satisfied. Fixture builds are signed in from the first frame.\n83:  *\n84:  * This is still a compile-time decision: `IS_MOCK` is resolved by Vite's define step from\n85:  * VITE_VIGIL_MOCK. Nothing here inspects the network at runtime.\n86:  */\n87: const MOCK_DEVICE: AuthMe = {\n88:   device_id: 'mock-device',\n89:   device_name: 'Simulation device',\n90:   user_id: 'mock-user',\n91:   user_display_name: 'Simulation',\n92:   created_at: '2026-01-01T00:00:00Z',\n93:   last_seen_at: '2026-01-01T00:00:00Z',\n94: };\n95: \n96: interface SessionState {\n97:   status: SessionStatus;\n98:   device: AuthMe | null;\n99:   hydrate: (me: () => Promise<AuthMe>) => Promise<void>;\n100:   signIn: (pairing: PairingResponse, me: () => Promise<AuthMe>) => Promise<void>;"}
