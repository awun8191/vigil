t check passed.\n237:     assert context.summary is not None\n238:     assert context.summary_block.strip()\n239:     assert context.verification.summary_present is True\n240:     assert str(approval.id) in context.verification.approval_ids\n241: \n242:     # The approval is still in the compacted context, with its identity and status.\n243:     survivors = [\n244:         message\n245:         for message in context.messages\n246:         if message.get(\"approval_id\") == str(approval.id)\n247:         or message.get(\"id\") == str(approval.id)\n248:     ]\n249:     assert len(survivors) == 1\n250:     assert survivors[0][\"status\"] == \"pending\"\n251:     assert str(survivors[0][\"approval_id\"]) == str(approval.id)\n252: \n253:     # The compaction trace is on the run.\n254:     assert context.step is not None\n255:     assert context.step.event_type == \"compaction\"\n256:     assert context.step.payload[\"verified\"] is True\n257:     assert str(approval.id) in context.step.payload[\"approvals_checked\"]\n258: \n259:     # The approval row itself is unchanged.\n260:     stored = await approval_service.get_approval_by_id(approval.id)"}
