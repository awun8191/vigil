26, 0.12);\n112:   --horizon: rgba(234, 244, 251, 0.38);\n113:   --grain-opacity: 0.025;\n114:   --sky-accent: #397ca8;\n115:   --sun-accent: #b96836;\n116:   --focus-ring: #2f6f9c;\n117:   color-scheme: light;\n118: }\n119: \n120: html,\n121: body,\n122: #root {\n123:   height: 100%;\n124: }\n125: \n126: body {\n127:   margin: 0;\n128:   font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;\n129:   background: linear-gradient(155deg, var(--bg-from), var(--bg-to));\n130:   background-attachment: fixed;\n131:   color: var(--text);\n132:   -webkit-font-smoothing: antialiased;\n133:   text-rendering: optimizeLegibility;\n134:   transition:\n135:     background 0.5s cubic-bezier(0.25, 1, 0.5, 1),\n136:     color 0.4s;\n137: }\n138: \n139: ::selection {\n140:   background: color-mix(in srgb, var(--sky-accent) 24%, transparent);\n141: }\n142: \n143: :where(button, a):focus-visible {\n144:   outline: 2px solid var(--focus-ring);\n145:   outline-offset: 3px;\n146: }\n147: \n148: .glass {\n149:   background: var(--glass);\n150:   -webkit-backdrop-filter: blur(40px) saturate(140%);\n151:   backdrop-filter: blur(40px) saturate(140%);\n152:   border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n153:   box-shadow: var(--shadow);\n154: }\n155: \n156: .card {\n157:   background: var(--card);\n158:   border: 1px solid var(--border);\n159:   box-shadow: var(--shadow);\n160:   -webkit-backdrop-filter: blur(30px) saturate(140%);\n161:   backdrop-filter: blur(30px) saturate(140%);\n162:   transition: background 0.4s cubic-bezier(0.25, 1, 0.5, 1);\n163: }\n164: .card:hover {\n165:   background: var(--card-hover);\n166: }\n167: \n168: /* Softer surface for chat bubbles and small tiles */\n169: .bubble {\n170:   background: var(--card);\n171:   border: 1px solid var(--border);\n172:   -webkit-backdrop-filter: blur(24px) saturate(140%);\n173:   backdrop-filter: blur(24px) saturate(140%);\n174: }\n175: \n176: /* Button system: 