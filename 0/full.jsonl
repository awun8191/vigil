{"step_index":337,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:12:28Z","content":"Created At: 2026-11-11T10:12:28Z\nCompleted At: 2026-11-11T10:12:28Z\nShowing lines 340-390 of 1130\n340: # ---------------------------------------------------------------------------\n341: # The loop\n342: # ---------------------------------------------------------------------------\n343: \n344: \n345: class RunLoop:\n346:     \"\"\"Run the six stages over one run until it stops or waits.\"\"\"\n347: \n348:     def __init__(\n349:         self,\n350:         *,\n351:         journal: RunJournal,\n352:         model: LLMClientProtocol | None = None,\n353:         tools: ToolExecutor | None = None,\n354:         policy: PartitionPolicy | None = None,\n355:         compactor: CompactionProvider | None = None,\n356:         observer: StageObserver | None = None,\n357:         tool_schemas: Sequence[Mapping[str, Any]] | None = None,\n358:         cost: Any | None = None,\n359:         max_iterations: int = 40,\n360:         context_token_limit: int = 100_000,\n361:         compact_ratio: float = 0.7,\n362:     ) -> None:\n363:         self.journal = journal\n364:         self.model = model\n365:         self.tools = tools\n366:         self.policy = policy\n367:         self.compactor = compactor\n368:         self.observer = observer or NullObserver()\n369:         self.cost = cost\n370:         self.tool_schemas: list[dict[str, Any]] | None = (\n371:             [dict(schema) for schema in tool_schemas] if tool_schemas else None\n372:         )\n373:         self.max_iterations = max_iterations\n374:         self.context_token_limit = context_token_limit\n375:         self.compact_ratio = compact_ratio\n376:         # The chat session of the run under work. Every row that the loop\n377:         # writes carries it, so the memory indexer sees the whole session.\n378:         self._session_id: UUID | None = None\n379: \n380:     # -- public API -------------------------------------------------------\n381: \n382:     async def run(self, run_id: UUID) -> RunDTO:\n383:         \"\"\"\n384:         Drive the run until it completes, fails, or waits for another actor.\n385: \n386:         Args:\n387:             run_id: The run to drive.\n388: \n389:         Returns:\n390:             The final run row of this call."}
