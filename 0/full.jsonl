{"step_index":311,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:10:07Z","content":"Created At: 2026-11-11T10:10:07Z\nCompleted At: 2026-11-11T10:10:07Z\nShowing lines 101-207 of 207\n101:     # The embedding path is local and offline. No embedding API is called.\n102:     EMBEDDING_BASE_URL: str = \"\"\n103:     EMBEDDING_API_KEY: str = \"\"\n104:     EMBEDDING_MODEL: str = \"bge-small-en-v1.5\"\n105:     EMBEDDING_DIMENSIONS: int = 384\n106:     EMBEDDING_ARTIFACT_REPO: str = \"Xenova/bge-small-en-v1.5\"\n107:     EMBEDDING_ARTIFACT_REVISION: str = \"ea104dacec62c0de699686887e3f920caeb4f3e3\"\n108:     EMBEDDING_ARTIFACT_FILE: str = \"onnx/model_int8.onnx\"\n109:     EMBEDDING_ARTIFACT_SHA256: str = (\n110:         \"bf64d05457cb391fa88d045faf5927a15ea36d96228ddf23ea970087afdc1197\"\n111:     )\n112:     EMBEDDING_TOKENIZER_FILE: str = \"tokenizer.json\"\n113:     EMBEDDING_MODEL_DIR: str = \"~/.cache/virgil/embedding\"\n114:     EMBEDDING_MAX_TOKENS: int = 512\n115:     EMBEDDING_DOCUMENT_PREFIX: str = \"\"\n116:     EMBEDDING_QUERY_PREFIX: str = \"Represent this sentence for searching relevant passages: \"\n117:     EMBEDDING_IDLE_UNLOAD_SECONDS: int = 300\n118:     EMBEDDING_INTRA_OP_THREADS: int = 2\n119:     # ONNX Runtime keeps the attention buffers of one run. A 200-message index\n120:     # job makes 50 windows, so one run holds at most four windows and at most\n121:     # 1024 tokens. The peak resident set then stays under 350 MB.\n122:     EMBEDDING_MAX_BATCH: int = 4\n123:     EMBEDDING_MAX_BATCH_TOKENS: int = 1024\n124:     # A child process holds the ONNX session and exits after the run, so the\n125:     # pages of the run go back to the operating system and the worker keeps\n126:     # only the tokenizer. The protocol stays the same: LocalEmbeddingModel\n127:     # still satisfies EmbeddingModel.\n128:     EMBEDDING_ENCODE_SUBPROCESS: bool = True\n129: \n130:     # --- Memory Retrieval (cosine similarity with exponential time decay) ---\n131:     # The override threshold is measured on the local model: correct answers score\n132:     # 0.679 to 0.801, the best wrong answers 0.561 to 0.615.\n133:     MEMORY_RETRIEVAL_HALF_LIFE_DAYS: float = 30.0\n134:     MEMORY_RETRIEVAL_FLOOR: float = 0.35\n135:     MEMORY_RETRIEVAL_OVERRIDE_THRESHOLD: float = 0.65\n136:     MEMORY_RETRIEVAL_MIN_SIMILARITY: float = 0.25\n137:     MEMORY_RETRIEVAL_CANDIDATE_K: int = 50\n138:     MEMORY_RETRIEVAL_TOP_N: int = 8\n139:     MEMORY_RETRIEVAL_EF_SEARCH: int = 200\n140:     MEMORY_RETRIEVAL_ITERATIVE_SCAN: Literal[\n141:         \"off\", \"relaxed_order\", \"strict_order\"\n142:     ] = \"relaxed_order\"\n143:     # The measured crossover between the exact scan and the tenant graph. The\n144:     # exact scan answers up to and including this tenant row count. Section 3.5\n145:     # of docs/BENCHMARKS.md records the measurement that set this value: the\n146:     # exact scan is faster at 5,000 and 10,000 rows, and the tenant graph is\n147:     # faster at 20,000 and 50,000 rows.\n148:     MEMORY_RETRIEVAL_EXACT_SCAN_MAX_ROWS: int = 20000\n149:     # The measured width of the tenant graph. At 50,000 rows the graph reaches\n150:     # recall@50 of 0.6216 at 200 and 0.9796 at 1000, which is the maximum that\n151:     # pgvector accepts.\n152:     MEMORY_RETRIEVAL_TENANT_GRAPH_EF_SEARCH: int = 1000\n153: \n154:     # --- Docker Sandbox Runner ---\n155:     DOCKER_HOST: str = \"unix:///var/run/docker.sock\"\n156:     SANDBOX_IMAGE: str = \"vigil-sandbox:latest\"\n157:     WORKSPACE_BASE_PATH: str = \"/var/vigil/workspaces\"\n158: \n159:     # --- Skills Registry ---\n160:     # An install is extracted below this root. ``skill_load`` resolves a name\n161:     # against this root and copies the directory into the sandbox workspace.\n162:     SKILLS_ROOT: str = \"/var/vigil/skills\"\n163:     # --- Sub-agent runs (Phase 6) ---\n164:     # A child run nests at most this deep. A run at this depth cannot spawn\n165:     # a child. The value is a setting so a test can lower it.\n166:     MAX_RUN_DEPTH: int = 2\n167:     # Key in ``agent_configs.limits`` that holds the budget in micro-USD.\n168:     RUN_BUDGET_LIMIT_KEY: str = \"max_cost_micros\"\n169:     # --- Logging Configuration ---\n170:     LOG_LEVEL: Literal[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"] = \"INFO\"\n171:     LOG_FORMAT: Literal[\"json\", \"console\"] = \"json\"\n172: \n173:     # --- Idempotency Configuration ---\n174:     IDEMPOTENCY_TTL_SECONDS: int = 86400\n175:     IDEMPOTENCY_HEADER_NAME: str = \"Idempotency-Key\"\n176: \n177:     # --- Background Jobs & Worker ---\n178:     JOB_POLL_INTERVAL_SECONDS: int = 5\n179:     JOB_LOCK_TIMEOUT_SECONDS: int = 300\n180:     # Start the job poller inside the API process. Off by default: the deploy\n181:     # runs one worker process with the Docker socket, and a second poller in\n182:     # the API cannot create sandbox containers, so every run it claims fails.\n183:     # Set true only for single-process local development.\n184:     EMBED_WORKER: bool = False\n185: \n186:     # --- Notifications Subsystem ---\n187:     NTFY_BASE_URL: str = \"https://ntfy.sh\"\n188:     NTFY_TOPIC: str = \"vigil-notifications\"\n189:     NTFY_AUTH_TOKEN: str = \"\"\n190: \n191:     # --- Exa Web Search MCP ---\n192:     EXA_MCP_URL: str = \"https://mcp.exa.ai/mcp\"\n193:     EXA_API_KEY: str = \"\"\n194: \n195:     # --- Firecrawl Web Scraper ---\n196:     FIRECRAWL_API_KEY: str | None = None\n197:     FIRECRAWL_BASE_URL: str = \"https://api.firecrawl.dev\"\n198: \n199:     # --- Groq Whisper STT ---\n200:     GROQ_API_KEY: str | None = None\n201:     GROQ_BASE_URL: str = \"https://api.groq.com/openai/v1\"\n202: \n203: \n204: @lru_cache\n205: def get_settings() -> Settings:\n206:     \"\"\"Return cached singleton instance of application settings.\"\"\"\n207:     return Settings()"}
