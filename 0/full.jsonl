{"step_index":321,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:10:44Z","content":"Created At: 2026-11-11T10:10:44Z\nCompleted At: 2026-11-11T10:10:44Z\nShowing lines 300-380 of 585\n300:             max_calls=max_calls,\n301:         )\n302:         verdicts = resolve_verdicts(units, tier1, tier0)\n303: \n304:         kept: list[PlannedUnit] = []\n305:         stubbed: list[PlannedUnit] = []\n306:         dropped: list[PlannedUnit] = []\n307:         original_tokens = 0\n308:         compacted_tokens = 0\n309: \n310:         for unit in units:\n311:             original = self.token_counter.count(unit.content)\n312:             original_tokens += original\n313:             verdict = verdicts[unit.unit_id]\n314:             if unit.kind is UnitKind.SYSTEM:\n315:                 # The system prompt is not history. Tier 2 must never summarize it.\n316:                 verdict = Verdict.RETAIN\n317: \n318:             if verdict is Verdict.DROP:\n319:                 dropped.append(\n320:                     PlannedUnit(\n321:                         unit=unit,\n322:                         verdict=verdict,\n323:                         content=\"\",\n324:                         tokens=0,\n325:                         source_tokens=original,\n326:                     )\n327:                 )\n328:                 continue\n329: \n330:             if verdict is Verdict.STUB:\n331:                 if not unit.artifact_id:\n332:                     # A stub must point at an artifact. Without one the unit\n333:                     # stays in full, because a lost pointer is worse than bulk.\n334:                     compacted_tokens += original\n335:                     kept.append(\n336:                         PlannedUnit(\n337:                             unit=unit,\n338:                             verdict=Verdict.RETAIN,\n339:                             content=unit.content,\n340:                             tokens=original,\n341:                             source_tokens=original,\n342:                         )\n343:                     )\n344:                     continue\n345:                 stub_text = ArtifactStub.from_unit(unit).render()\n346:                 stub_tokens = self.token_counter.count(stub_text)\n347:                 compacted_tokens += stub_tokens\n348:                 stubbed.append(\n349:                     PlannedUnit(\n350:                         unit=unit,\n351:                         verdict=verdict,\n352:                         content=stub_text,\n353:                         tokens=stub_tokens,\n354:                         source_tokens=original,\n355:                     )\n356:                 )\n357:                 continue\n358: \n359:             compacted_tokens += original\n360:             kept.append(\n361:                 PlannedUnit(\n362:                     unit=unit,\n363:                     verdict=verdict,\n364:                     content=unit.content,\n365:                     tokens=original,\n366:                     source_tokens=original,\n367:                 )\n368:             )\n369: \n370:         return CompactionPlan(\n371:             kept=tuple(kept),\n372:             stubbed=tuple(stubbed),\n373:             dropped=tuple(dropped),\n374:             tier0=tier0,\n375:             tier1=tier1,\n376:             original_tokens=original_tokens,\n377:             compacted_tokens=compacted_tokens,\n378:             order=tuple(unit.unit_id for unit in units),\n379:         )\n380: "}
