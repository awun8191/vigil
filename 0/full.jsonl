{"step_index":574,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:41:28Z","content":"Created At: 2026-11-11T10:41:28Z\nCompleted At: 2026-11-11T10:41:28Z\nShowing lines 1-100 of 310\n1: import { useCallback, useEffect, useMemo, useRef, useState } from 'react';\n2: import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\n3: import { api } from '@/lib/api';\n4: import { userMessageOf } from '@/lib/errors';\n5: import { releaseIdempotencyKey } from '@/lib/idempotency';\n6: import type { ChatSession, Run, RunStepEvent, StreamMessage, StreamState } from '@/types';\n7: import { runKey, useCancelRun, useDefaultAgentConfig, useRun } from './runs';\n8: \n9: export const SESSIONS_KEY = ['chat', 'sessions'] as const;\n10: export const messagesKey = (sessionId: string) =>\n11:   ['chat', 'sessions', sessionId, 'messages'] as const;\n12: \n13: export function useSessions() {\n14:   return useQuery<ChatSession[]>({\n15:     queryKey: SESSIONS_KEY,\n16:     queryFn: () => api.listSessions(),\n17:   });\n18: }\n19: \n20: export function useCreateSession() {\n21:   const queryClient = useQueryClient();\n22: \n23:   return useMutation({\n24:     mutationFn: ({ title, scope }: { title: string | undefined; scope: string }) =>\n25:       api.createSession(title, scope),\n26:     onSettled: (_data, _error, variables) => {\n27:       releaseIdempotencyKey(variables.scope);\n28:       void queryClient.invalidateQueries({ queryKey: SESSIONS_KEY });\n29:     },\n30:   });\n31: }\n32: \n33: export function useMessages(sessionId: string | null) {\n34:   return useQuery<StreamMessage[]>({\n35:     queryKey: messagesKey(sessionId ?? 'none'),\n36:     queryFn: () => api.listMessages(sessionId as string),\n37:     enabled: Boolean(sessionId),\n38:     staleTime: 5_000,\n39:   });\n40: }\n41: \n42: /* -------------------------------------------------------------------------------------------\n43:    The chat transport. A sent message IS one agent