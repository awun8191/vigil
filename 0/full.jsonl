{"step_index":256,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-11T10:05:37Z","input_tokens":2515,"cache_read_tokens":247477,"output_tokens":2600,"tool_calls":[{"name":"write_file","args":{"Content":"import { useEffect, useState } from 'react';\nimport { Calendar, Compass, FolderPlus, Plus, Sparkles } from 'lucide-react';\nimport { AnimatePresence, motion } from 'framer-motion';\n\ninterface Props {\n  mode: 'widgets' | 'clock' | 'collapsed';\n  activeTab: 'chat' | 'projects';\n  onNewPanelClick?: () => void;\n  onUpgradeClick?: () => void;\n  onProjectClick?: (name: string) => void;\n}\n\nexport function HarkLeftRail({\n  mode,\n  activeTab,\n  onNewPanelClick,\n  onUpgradeClick,\n  onProjectClick,\n}: Props) {\n  // Live clock state for the typographic clock view\n  const [time, setTime] = useState(new Date());\n\n  useEffect(() => {\n    const timer = setInterval(() => setTime(new Date()), 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const dayOfWeek = time.toLocaleDateString('en-US', { weekday: 'short' });\n  const monthDay = time.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });\n  const timeString = time.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });\n\n  if (mode === 'collapsed') {\n    return null;\n  }\n\n  return (\n    <aside\n      aria-label=\"Sidebar Rail\"\n      className=\"fixed left-6 top-20 z-30 flex w-[280px] max-w-[calc(100vw-3rem)] flex-col gap-3.5 select-none\"\n    >\n      <AnimatePresence mode=\"wait\">\n        {/* Projects View: Shown when activeTab is 'projects' */}\n        {activeTab === 'projects' ? (\n          <motion.div\n            key=\"projects-view\"\n            initial={{ opacity: 0, x: -16 }}\n            animate={{ opacity: 1, x: 0 }}\n            exit={{ opacity: 0, x: -16 }}\n            transition={{ type: 'spring', stiffness: 450, damping: 30 }}\n            className=\"flex flex-col gap-3\"\n          >\n            <button\n              type=\"button\"\n              className=\"flex items-center gap-2 rounded-xl bg-[var(--card)] border border-[var(--border)] px-4 py-3 text-[13.5px] font-medium text-[var(--text)] shadow-[var(--shadow)] backdrop-blur-xl transition-all hover:bg-[var(--card-hover)]\"\n            >\n              <FolderPlus size={16} strokeWidth={1.5} className=\"text-[var(--text-muted)]\" />\n              <span>New project</span>\n            </button>\n\n            <div className=\"rounded-[20px] bg-[var(--card)] border border-[var(--border)] p-4 shadow-[var(--shadow)] backdrop-blur-xl\">\n              <div className=\"mb-2 text-[14px] font-semibold text-[var(--text)]\">FYP</div>\n              <ul className=\"space-y-1 text-[13px] text-[var(--text-secondary)]\">\n                <li\n                  onClick={() => onProjectClick?.('PROJECT IDEAS')}\n                  className=\"cursor-pointer rounded-lg px-2 py-1.5 transition-colors hover:bg-[var(--card-hover)] hover:text-[var(--text)]\"\n                >\n                  • PROJECT IDEAS\n                </li>\n                <li\n                  onClick={() => onProjectClick?.('Software Developer Interview Prep')}\n                  className=\"cursor-pointer rounded-lg px-2 py-1.5 transition-colors hover:bg-[var(--card-hover)] hover:text-[var(--text)]\"\n                >\n                  • Software Developer Interview Prep\n                </li>\n              </ul>\n              <div\n                onClick={() => onProjectClick?.('Awun')}\n                className=\"mt-3 cursor-pointer rounded-lg px-2 py-1 text-[13.5px] font-medium text-[var(--text)] transition-colors hover:bg-[var(--card-hover)]\"\n              >\n                Awun\n              </div>\n            </div>\n          </motion.div>\n        ) : mode === 'clock' ? (\n          /* Typographic Clock View (Screenshot 10) */\n          <motion.div\n            key=\"clock-view\"\n            initial={{ opacity: 0, y: 12 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -12 }}\n            transition={{ type: 'spring', stiffness: 450, damping: 30 }}\n            className=\"pt-6\"\n          >\n            <div className=\"font-sans text-[36px] font-light leading-[1.12] tracking-[-0.03em] text-[var(--text)] drop-shadow-sm\">\n              <div>{dayOfWeek}</div>\n              <div>{monthDay}</div>\n              <div className=\"mt-1 font-normal\">{timeString}</div>\n            </div>\n          </motion.div>\n        ) : (\n          /* Widgets / Panels View (Screenshots 1, 2, 4, 9) */\n          <motion.div\n            key=\"widgets-view\"\n            initial={{ opacity: 0, x: -16 }}\n            animate={{ opacity: 1, x: 0 }}\n            exit={{ opacity: 0, x: -16 }}\n            transition={{ type: 'spring', stiffness: 450, damping: 30 }}\n            className=\"flex flex-col gap-3\"\n          >\n            {/* Panel 1: Location & Weather Widget */}\n            <div className=\"rounded-[20px] bg-[var(--card)] border border-[var(--border)] p-4 shadow-[var(--shadow)] backdrop-blur-xl\">\n              <div className=\"flex items-center gap-1.5 text-[11.5px] font-medium text-[var(--text-muted)]\">\n                <Compass size={13} strokeWidth={1.5} />\n                <span>Ojota, NG</span>\n              </div>\n\n              <div className=\"mt-2.5 grid grid-cols-3 gap-2\">\n                <div>\n                  <div className=\"text-[11px] text-[var(--text-muted)]\">Overcast Clouds</div>\n                  <div className=\"text-[17px] font-semibold text-[var(--text)]\">27°C</div>\n                </div>\n                <div>\n                  <div className=\"text-[11px] text-[var(--text-muted)]\">Feels like</div>\n                  <div className=\"text-[17px] font-semibold text-[var(--text)]\">30°</div>\n                </div>\n                <div>\n                  <div className=\"text-[11px] text-[var(--text-muted)]\">Sunset</div>\n                  <div className=\"text-[17px] font-semibold text-[var(--text)]\">5:25 PM</div>\n                </div>\n              </div>\n\n              <div className=\"mt-3 flex items-center justify-between\">\n                <span className=\"text-[10.5px] text-[var(--text-muted)]\">Based on approximate location.</span>\n              </div>\n              <button\n                type=\"button\"\n                className=\"mt-2.5 w-full rounded-full bg-[color-mix(in_srgb,var(--text)_7%,transparent)] py-1.5 text-center text-[12px] font-medium text-[var(--text)] transition-colors hover:bg-[color-mix(in_srgb,var(--text)_12%,transparent)]\"\n              >\n                Share your location\n              </button>\n            </div>\n\n            {/* Panel 2: Usage / Plan Limit Panel */}\n            <div className=\"rounded-[20px] bg-[var(--card)] border border-[var(--border)] p-4 shadow-[var(--shadow)] backdrop-blur-xl\">\n              <div className=\"flex items-center gap-2 text-[12px] font-semibold text-[var(--text)]\">\n                <Sparkles size={14} className=\"text-[var(--hark-amber)]\" />\n                <span>Hark Usage</span>\n              </div>\n\n              <div className=\"mt-3 rounded-xl bg-[color-mix(in_srgb,var(--text)_4%,transparent)] p-3 text-center\">\n                <p className=\"text-[12px] text-[var(--text-secondary)]\">You've reached your plan's limit.</p>\n                <button\n                  type=\"button\"\n                  onClick={onUpgradeClick}\n                  className=\"mt-2.5 w-full rounded-full bg-[var(--btn-primary-bg)] py-1.5 text-center text-[12px] font-semibold text-[var(--btn-primary-ink)] transition-transform active:scale-95\"\n                >\n                  Upgrade\n                </button>\n              </div>\n            </div>\n\n            {/* Panel 3: Calendar Panel */}\n            <div className=\"rounded-[20px] bg-[var(--card)] border border-[var(--border)] p-4 shadow-[var(--shadow)] backdrop-blur-xl\">\n              <div className=\"flex items-center gap-2 text-[12px] font-semibold text-[var(--text)]\">\n                <Calendar size={14} className=\"text-[var(--text-muted)]\" />\n                <span>Calendar</span>\n              </div>\n\n              <div className=\"mt-3 rounded-xl bg-[color-mix(in_srgb,var(--text)_4%,transparent)] p-3 text-center\">\n                <p className=\"text-[12px] text-[var(--text-secondary)]\">You've reached your plan's limit.</p>\n                <button\n                  type=\"button\"\n                  onClick={onUpgradeClick}\n                  className=\"mt-2.5 w-full rounded-full bg-[var(--btn-primary-bg)] py-1.5 text-center text-[12px] font-semibold text-[var(--btn-primary-ink)] transition-transform active:scale-95\"\n                >\n                  Upgrade\n                </button>\n              </div>\n            </div>\n\n            {/* Panel Action: + Create a new panel */}\n            <button\n              type=\"button\"\n              onClick={onNewPanelClick}\n              className=\"flex items-center justify-center gap-2 rounded-full bg-[var(--card)] border border-[var(--border)] py-2.5 text-[12.5px] font-medium text-[var(--text-secondary)] shadow-[var(--shadow)] backdrop-blur-xl transition-all hover:bg-[var(--card-hover)] hover:text-[var(--text)]\"\n            >\n              <Plus size={14} strokeWidth={2} />\n              <span>Create a new panel</span>\n            </button>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </aside>\n  );\n}\n\nexport default HarkLeftRail;\n","Overwrite":true,"Path":"/home/nasbombz/Documents/Projects/vigil-agent/web/src/components/hark/HarkLeftRail.tsx"}}]}
