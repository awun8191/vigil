  local tag=\"$1\"\n47:     local color=\"$2\"\n48:     awk -v tag=\"$tag\" -v color=\"$color\" -v reset=\"$C_RESET\" '{ print color \"[\" tag \"]\" reset \" \" $0; fflush() }'\n49: }\n50: \n51: # ------------------------------------------------------------------------------\n52: # Root resolution\n53: # ------------------------------------------------------------------------------\n54: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n55: if [[ -f \"$SCRIPT_DIR/backend/pyproject.toml\" && -f \"$SCRIPT_DIR/web/package.json\" ]]; then\n56:     PROJECT_ROOT=\"$SCRIPT_DIR\"\n57: elif [[ -f \"$SCRIPT_DIR/../backend/pyproject.toml\" && -f \"$SCRIPT_DIR/../web/package.json\" ]]; then\n58:     PROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n59: else\n60:     log_error \"Cannot locate Vigil repository root from $SCRIPT_DIR\"\n61:     exit 1\n62: fi\n63: \n64: # ------------------------------------------------------------------------------\n65: # Configuration & Defaults\n66: # ------------------------------------------------------------------------------\n67: ENABLE_API=true\n68: ENABLE_WEB=true\n69: ENABLE_WORKER=true\n70: EMBED_WORKER=false\n71: RUN_MIGRATIONS=true\n72: MOCK_MODE=false\n73: RAW_LOGS=false\n74: API_HOST=\"127.0.0.1\"\n75: API_PORT=\"8000\"\n76: WEB_PORT=\"5173\"\n77: \n78: # Read defaults from .env if present\n79: if [[ -f \"$PROJECT_ROOT/backend/.env\" ]]; then\n80:     ENV_PORT=$(grep -E '^[[:space:]]*PORT=' \"$PROJECT_ROOT/backend/.env\" | cut -d '=' -f2- | tr -d ' \"\\r\\n' || true)\n81:     ENV_HOST=$(grep -E '^[[:space:]]*HOST=' \"$PROJECT_ROOT/backend/.env\" | cut -d '=' -f2- | tr -d ' \"\\r\\n' || true)\n82:     ENV_EMBED=$(grep -E '^[[:space:]]*EMBED_WORKER=' \"$PROJECT_ROOT/backend/.env\" | cut -d '=' -f2- | tr -d ' \"\\r\\n' || true)\n83:     [[ -n \"$ENV_PORT\" ]] && API_PORT=\"$ENV_PORT\"\n84:     [[ -n \"$ENV_HOST\" ]] && API_HOST=\"$ENV_HOST\"\n85:     if [[ \"$ENV_EMBED\" == \"true\" ]]; then\n86:         EMBED_WORKER=true