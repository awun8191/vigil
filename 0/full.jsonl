248:     scroll-behavior: auto !important;\n249:   }\n250: }\n251: \n252: @utility tabular {\n253:   font-variant-numeric: tabular-nums;\n254: }\n255: \n256: /* ══ Eye tracker ═══════════════════════════════════════════\n257:    From Bencho (MIT, bencho.dev/licence). The frame holds the\n258:    largest ball the Size knob allows, so the wall never\n259:    rescales it. */\n260: .eyt {\n261:   width: 200px;\n262:   height: 200px;\n263:   display: grid;\n264:   place-items: center;}\n265: \n266: .eyt-ball {\n267:   width: var(--eyt-size, 100px);\n268:   height: var(--eyt-size, 100px);\n269:   overflow: visible;}\n270: \n271: /* Token mapping, Vigil side (nothing added as globals): the ball\n272:    is the ink itself and the eyes the ground it sits on, so the\n273:    mark inverts with the theme exactly like the rest of the UI.\n274:    --fill-slab → var(--text), --fill-on → var(--bg-from),\n275:    --font-ui → inherited app font, --ink/--bg unused (they only\n276:    fed Bencho's site-chrome rules, not copied here). */\n277: .eyt-body { fill: var(--text); }\n278: \n279: .eyt-eye { fill: var(--bg-from); }\n280: \n281: /* a press on the toy opens a chat bubble off its lower right: the\n282:    pet's bubble, its square corner pointing back at the face */\n283: .eyt { position: relative; }\n284: \n285: /* a press gives a little under the finger and springs back out */\n286: .eyt-ball[data-poke] {\n287:   cursor: pointer;\n288:   transform-origin: center;\n289:   transition: scale 420ms cubic-bezier(0.24, 1.34, 0.38, 1);\n290:   -webkit-tap-highlight-color: transparent;}\n291: \n292: .eyt-ball[data-poke]:active { scale: 0.96; transition-duration: 160ms; transition-timing-function: ease; }\n293: \n294: .eyt-say {\n295:   position: absolute;\n296:   left: calc(50% + var(--eyt-size, 100px) * 0.36);\n297:   top: calc(50% + var(--eyt-size, 100px) * 0.3);\n298:   display: inline-flex;\n299:   align-items: center;\n300:   gap: 2px;\n301:   min-height: 34px;\n302:   padding: 0 16px;\n303:   border-radius: 6px 14px 14px 14px;\n304:   /* monochrome: ink slab, ground lettering, no colour tints */\n305:   background: var(--text);\n306:   color: var(--bg-from);\n307:   box-shadow: inset 0 -1.5px 0 rgba(0, 0, 0, 0.1);\n308:   font-family: var(--font-ui, inherit);\n309:   font-size: 13px;\n310:   font-weight: 400;\n311:   white-space: nowrap;\n312:   transform-origin: top left;\n313:   opacity: 0;\n314:   scale: 0.85;\n315:   pointer-events: none;\n316:   transition: opacity 160ms ease, scale 220ms cubic-bezier(0.24, 1.34, 0.38, 1), background-color 220ms ease;\n317:   letter-spacing: 0em;}\n318: \n319: .eyt-say[data-on] { opacity: 1; scale: 1; }\n320: \n321: .eyt-caret {\n322:   width: 1.5px;\n323:   height: 13px;\n324:   border-radius: 1px;\n325:   background: var(--bg-from);\n326:   animation: pet-caret 1s steps(1) infinite;}\n327: \n328: @keyframes pet-caret {\n329:   50% { opacity: 0; }}\n330: \n331: /* Inline duty (the navbar mark): drop the 200px bench frame and\n332:    let the ball take its own size inside the logo row. */\n333: .eyt-inline .eyt {\n334:   width: auto;\n335:   height: auto;}\n336: \n337: /* ══ KaTeX & Markdown Overflow Protection ════════════════════\n338:    Ensure display math equations scroll horizontally inside their\n339:    own container and never blow out the chat column width. */\n340: .katex-display {\n341:   overflow-x: auto;\n342:   overflow-y: hidden;\n343:   max-width: 100%;\n344:   margin: 0.85em 0 !important;\n345:   padding: 0.5rem 0.75rem;\n346:   border-radius: 10px;\n347:   background: color-mix(in srgb, var(--text) 3.5%, transparent);\n348:   border: 1px solid var(--border);\n349:   scrollbar-width: thin;\n350: }"}
