{"step_index":447,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-11T10:20:40Z","input_tokens":2365,"cache_read_tokens":145738,"output_tokens":820,"thinking":"Unit tests now complete successfully. Proceeding to write a new unit test to validate the token dropping and context summarization behavior of the compaction process when handling history with unlocked items. The test will simulate a scenario with 15 turns containing intermediate tool calls and thoughts, verifying that the `compact` function: 1) removes unlocked intermediate tool outputs, 2) stubs bulk outputs, and 3) triggers summarization for the dropped/stubbed content.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"Test that compaction effectively reduces tokens and generates summaries.\"\"\"\nimport pytest\nfrom uuid import uuid4\nfrom src.config.settings import Settings\nfrom src.dependencies import get_compaction_service\nfrom src.integrations.repositories import LLMResponseDTO\n\n\nclass MockFastLLM:\n    def __init__(self) -> None:\n        self.called = False\n\n    async def complete(\n        self,\n        messages: list[dict],\n        tools: list[dict] | None = None,\n        temperature: float = 0.7,\n        tier: str = \"fast\",\n        max_tokens: int | None = None,\n    ) -> LLMResponseDTO:\n        self.called = True\n        return LLMResponseDTO(\n            content=\"Summary: Previous steps performed multiple checks and tasks.\",\n            tool_calls=[],\n            prompt_tokens=50,\n            completion_tokens=15,\n            total_tokens=65,\n            finish_reason=\"stop\",\n            model=\"fast-llm\",\n        )\n\n\n@pytest.mark.asyncio\nasync def test_compaction_effectively_reduces_history_tokens():\n    settings = Settings(APP_ENV=\"test\")\n    compaction = get_compaction_service(session=None, settings=settings)\n    mock_fast = MockFastLLM()\n    compaction.fast_llm = mock_fast\n\n    run_id = uuid4()\n    # Build 14 messages with user messages, thoughts, and large tool outputs\n    history = []\n    for i in range(14):\n        if i % 3 == 0:\n            history.append({\"id\": f\"m-{i}\", \"role\": \"user\", \"content\": f\"User query {i}\"})\n        elif i % 3 == 1:\n            history.append({\"id\": f\"m-{i}\", \"role\": \"assistant\", \"content\": f\"Assistant response {i} with intermediate thinking\"})\n        else:\n            history.append({\n                \"id\": f\"m-{i}\",\n                \"role\": \"tool\",\n                \"tool_name\": \"bash\",\n                \"content\": \"output log \" * 60,\n                \"artifact_id\": f\"art-{i}\",\n            })\n\n    context = await compaction.compact(run_id, history)\n\n    # Verify that units were dropped or stubbed and that summarizer ran\n    assert context.units_dropped > 0 or context.units_stubbed > 0\n    assert context.compacted_tokens < context.original_tokens\n    assert mock_fast.called is True\n    assert \"Summary:\" in context.summary_block\n","Path":"/home/nasbombz/Documents/Projects/vigil-agent/backend/tests/unit/test_compaction_effectiveness.py"}}]}
