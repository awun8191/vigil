{"step_index":519,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-11T10:27:25Z","input_tokens":2117,"cache_read_tokens":187959,"output_tokens":2858,"tool_calls":[{"name":"write_file","args":{"Content":"import { useCallback, useEffect, useRef, useState } from 'react';\nimport { useLocation, useNavigate, useParams } from 'react-router-dom';\nimport { FileText, FolderPlus, MessageSquare } from 'lucide-react';\n\nimport { HarkTopChrome } from './HarkTopChrome';\nimport { HarkLeftRail } from './HarkLeftRail';\nimport { HarkSearchModal } from './HarkSearchModal';\nimport { HarkProfileSheet } from './HarkProfileSheet';\nimport { HarkProactivityPill } from './HarkProactivityPill';\n\nimport { MessageStream } from '@/components/chat/MessageStream';\nimport { InputPill } from '@/components/chat/InputPill';\nimport { ThinkingCapsule } from '@/components/chat/ThinkingCapsule';\nimport { useAgentChat, useCreateSession, useMessages, useSessions } from '@/queries/chat';\n\ninterface LocationState {\n  seed?: string;\n  cardId?: string;\n}\n\nexport function HarkUnifiedApp() {\n  const { sessionId: routeSessionId } = useParams<{ sessionId: string }>();\n  const location = useLocation();\n  const navigate = useNavigate();\n\n  // Layout states mirroring Hark Pro\n  const [activeTab, setActiveTab] = useState<'chat' | 'projects'>('chat');\n  const [leftRailMode, setLeftRailMode] = useState<'widgets' | 'clock' | 'collapsed'>('widgets');\n  const [searchOpen, setSearchOpen] = useState(false);\n  const [profileOpen, setProfileOpen] = useState(false);\n\n  // Chat queries & sessions\n  const state = (location.state ?? {}) as LocationState;\n  const [seed, setSeed] = useState<string | undefined>(state.seed);\n  const [createdSessionId, setCreatedSessionId] = useState<string | null>(null);\n\n  const sessions = useSessions();\n  const createSession = useCreateSession();\n  const creatingRef = useRef(false);\n\n  const activeSessionId =\n    routeSessionId ?? createdSessionId ?? sessions.data?.[0]?.session_id ?? null;\n\n  const messagesQuery = useMessages(activeSessionId);\n  const chat = useAgentChat(activeSessionId);\n\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  // Auto-create a session if none exists\n  useEffect(() => {\n    if (routeSessionId || createdSessionId) return;\n    if (!sessions.data || sessions.data.length > 0) return;\n    if (creatingRef.current) return;\n\n    creatingRef.current = true;\n    createSession.mutate(\n      { title: undefined, scope: 'chat:create-session' },\n      { onSuccess: (session) => setCreatedSessionId(session.session_id) },\n    );\n  }, [routeSessionId, createdSessionId, sessions.data, createSession]);\n\n  const handleSeedConsumed = useCallback(() => {\n    setSeed(undefined);\n    if (state.cardId) navigate('/agent', { replace: true, state: null });\n  }, [navigate, state.cardId]);\n\n  // Scroll to bottom as new messages arrive\n  useEffect(() => {\n    if (scrollRef.current) {\n      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n    }\n  }, [messagesQuery.data?.length, chat.streamedText, chat.streaming]);\n\n  // Cycle the left rail through: widgets -> clock -> collapsed\n  const handleHomeClick = () => {\n    setLeftRailMode((prev) => {\n      if (prev === 'widgets') return 'clock';\n      if (prev === 'clock') return 'collapsed';\n      return 'widgets';\n    });\n  };\n\n  const handleCreateNewProject = () => {\n    createSession.mutate(\n      { title: 'New Project', scope: 'chat:create-session' },\n      {\n        onSuccess: (session) => {\n          navigate(`/agent/chat/${session.session_id}`);\n          setActiveTab('chat');\n        },\n      },\n    );\n  };\n\n  const messages = messagesQuery.data ?? [];\n  const showThinking = chat.streaming;\n\n  return (\n    <div className=\"relative h-dvh w-full overflow-hidden flex flex-col\">\n      {/* 1. Floating Top Chrome */}\n      <HarkTopChrome\n        activeTab={activeTab}\n        onTabChange={setActiveTab}\n        onHomeClick={handleHomeClick}\n        onSearchClick={() => setSearchOpen(true)}\n        onProfileClick={() => setProfileOpen(true)}\n        leftRailMode={leftRailMode}\n      />\n\n      {/* 2. Adaptive Left Rail (Widgets / Clock / Projects / Collapsed) */}\n      <HarkLeftRail\n        mode={leftRailMode}\n        activeTab={activeTab}\n        onUpgradeClick={() => setProfileOpen(true)}\n        onNewPanelClick={() => {}}\n      />\n\n      {/* 3. Central Living Workspace & Scroll Container */}\n      <div\n        ref={scrollRef}\n        className={`relative flex-1 overflow-y-auto px-4 pt-20 pb-32 transition-all duration-300 ${\n          leftRailMode === 'collapsed'\n            ? 'mx-auto w-full max-w-2xl'\n            : 'w-full md:pl-[320px] md:pr-10'\n        }`}\n      >\n        <div className=\"mx-auto w-full max-w-2xl min-h-full flex flex-col justify-end\">\n          {activeTab === 'chat' ? (\n            /* CHAT MODE WORKSPACE */\n            <div className=\"w-full space-y-4\">\n              {messages.length > 0 ? (\n                /* Real Message Stream */\n                <MessageStream\n                  messages={messages}\n                  streamedText={chat.streamedText}\n                  streaming={chat.streaming}\n                  emptyHint={<div />}\n                  trailing={showThinking ? <ThinkingCapsule active /> : null}\n                />\n              ) : (\n                /* Authentic Hark Pro Empty Canvas Greeting & Quick Actions */\n                <div className=\"py-12 space-y-6\">\n                  <div className=\"space-y-2\">\n                    <h1 className=\"font-serif text-[28px] font-normal tracking-tight text-[var(--text)] sm:text-[34px]\">\n                      How can I help you today?\n                    </h1>\n                    <p className=\"text-[14px] text-[var(--text-secondary)]\">\n                      Ask a question, analyze a repository, inspect live web pages, or build an interactive prototype.\n                    </p>\n                  </div>\n\n                  {/* Real Quick-Action Verb Pills */}\n                  <div className=\"flex flex-col gap-2 pt-2\">\n                    <HarkProactivityPill\n                      verb=\"Draft\"\n                      summary=\"a technical briefing on the latest repository changes\"\n                      onVerbClick={() => chat.send(\"Draft a technical briefing on the latest changes and status\")}\n                      onPillClick={() => setSeed(\"Draft a technical briefing on the latest changes and status\")}\n                    />\n\n                    <HarkProactivityPill\n                      verb=\"Build\"\n                      summary=\"an interactive dashboard prototype with live components\"\n                      onVerbClick={() => chat.send(\"Build an interactive prototype dashboard\")}\n                      onPillClick={() => setSeed(\"Build an interactive prototype dashboard with real live preview\")}\n                    />\n\n                    <HarkProactivityPill\n                      verb=\"Browse\"\n                      summary=\"inspect and analyze documentation using live cloud browser\"\n                      onVerbClick={() => chat.send(\"Use the browser to inspect documentation\")}\n                      onPillClick={() => setSeed(\"Browse and inspect documentation using the cloud browser\")}\n                    />\n                  </div>\n                </div>\n              )}\n            </div>\n          ) : (\n            /* PROJECTS MODE WORKSPACE */\n            <div className=\"w-full space-y-4 py-8\">\n              <div className=\"flex items-center justify-between pb-2\">\n                <h2 className=\"text-[18px] font-semibold tracking-tight text-[var(--text)]\">Projects & Sessions</h2>\n                <button\n                  type=\"button\"\n                  onClick={handleCreateNewProject}\n                  className=\"flex items-center gap-1.5 rounded-full bg-[var(--accent)] px-3.5 py-1.5 text-[12px] font-semibold text-[var(--accent-ink)] transition-transform hover:scale-105 active:scale-95\"\n                >\n                  <FolderPlus size={14} />\n                  New Project\n                </button>\n              </div>\n\n              <div className=\"space-y-2\">\n                {(sessions.data ?? []).map((session) => (\n                  <div\n                    key={session.session_id}\n                    onClick={() => {\n                      navigate(`/agent/chat/${session.session_id}`);\n                      setActiveTab('chat');\n                    }}\n                    className={`flex cursor-pointer items-center justify-between rounded-[16px] border p-3.5 shadow-sm transition-all hover:border-[var(--border-strong)] ${\n                      session.session_id === activeSessionId\n                        ? 'border-[var(--accent)] bg-[color-mix(in_srgb,var(--card)_90%,var(--accent)_10%)]'\n                        : 'border-[var(--border)] bg-[var(--card)]'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-3 min-w-0\">\n                      <div className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--text)_8%,transparent)] text-[var(--text)]\">\n                        <MessageSquare size={16} />\n                      </div>\n                      <div className=\"min-w-0\">\n                        <div className=\"truncate text-[13.5px] font-medium text-[var(--text)]\">\n                          {session.title || 'Untitled Session'}\n                        </div>\n                        <div className=\"text-[11px] text-[var(--text-muted)]\">\n                          {new Date(session.updated_at).toLocaleDateString(undefined, {\n                            month: 'short',\n                            day: 'numeric',\n                            hour: 'numeric',\n                            minute: '2-digit',\n                          })}\n                        </div>\n                      </div>\n                    </div>\n                    <span className=\"text-[12px] text-[var(--text-muted)]\">Open ⌝</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* 4. Guaranteed Visible Floating Composer (Pinned at Bottom Center) */}\n      <div\n        className={`fixed bottom-6 z-40 flex justify-center px-4 pointer-events-none transition-all duration-300 ${\n          leftRailMode === 'collapsed'\n            ? 'inset-x-0'\n            : 'left-0 right-0 md:left-[300px]'\n        }`}\n      >\n        <div className=\"pointer-events-auto w-full max-w-2xl\">\n          <InputPill\n            onSend={(text) => chat.send(text)}\n            onStop={() => chat.stop()}\n            streaming={chat.streaming}\n            seed={seed}\n            onSeedConsumed={handleSeedConsumed}\n          />\n        </div>\n      </div>\n\n      {/* 5. Search Overlay Modal */}\n      <HarkSearchModal\n        open={searchOpen}\n        onClose={() => setSearchOpen(false)}\n        onSearch={(query) => {\n          chat.send(`Search query: ${query}`);\n          setSearchOpen(false);\n        }}\n      />\n\n      {/* 6. Profile & Settings Sheet Modal */}\n      <HarkProfileSheet\n        open={profileOpen}\n        onClose={() => setProfileOpen(false)}\n        onNavigate={(section) => {\n          setProfileOpen(false);\n          navigate(`/agent/settings/${section}`);\n        }}\n        onSignOut={() => navigate('/pair')}\n      />\n    </div>\n  );\n}\n\nexport default HarkUnifiedApp;\n","Overwrite":true,"Path":"/home/nasbombz/Documents/Projects/vigil-agent/web/src/components/hark/HarkUnifiedApp.tsx"}}]}
