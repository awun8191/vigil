ette. This will be implemented using a CSS-only solution featuring blurred, overlapping radial gradient discs, resulting in a cloudscape effect. The implementation will focus on performance by avoiding image assets.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import { Home, Search } from 'lucide-react';\nimport { motion } from 'framer-motion';\n\ninterface Props {\n  activeTab: 'chat' | 'projects';\n  onTabChange: (tab: 'chat' | 'projects') => void;\n  onHomeClick: () => void;\n  onSearchClick: () => void;\n  onProfileClick: () => void;\n  leftRailMode: 'widgets' | 'clock' | 'collapsed';\n}\n\nexport function HarkTopChrome({\n  activeTab,\n  onTabChange,\n  onHomeClick,\n  onSearchClick,\n  onProfileClick,\n  leftRailMode,\n}: Props) {\n  return (\n    <header className=\"pointer-events-none fixed inset-x-0 top-0 z-40 flex items-center justify-between px-6 py-4\">\n      {/* Top Left: Home squircle button */}\n      <div className=\"pointer-events-auto flex items-center gap-3\">\n        <button\n          type=\"button\"\n          onClick={onHomeClick}\n          aria-label=\"Toggle widget rail\"\n          title={`View: ${leftRailMode}`}\n          className=\"group relative flex h-10 w-10 items-center justify-center rounded-[14px] bg-[var(--card)] border border-[var(--border)] shadow-[var(--shadow)] backdrop-blur-xl transition-all duration-200 hover:scale-105 active:scale-95\"\n        >\n          <Home\n            size={18}\n            strokeWidth={1.75}\n            className=\"text-[var(--text)] transition-transform duration-200 group-hover:scale-110\"\n          />\n          {leftRailMode !== 'collapsed' ? (\n            <span className=\"absolute -bottom-1 -right-1 h-2 w-2 rounded-full bg-[var(--hark-amber)] ring-2 ring-[var(--surface-solid)]\" />\n          ) : null}\n        </button>\n      </div>\n\n      {/* Top Center: Segmented Pill Switch [ Chat | Projects ] */}\n      <div className=\"pointer-events-auto\">\n        <div className=\"relative flex items-center rounded-full bg-[var(--card)] border border-[var(--border)] p-1 shadow-[var(--shadow)] backdrop-blur-xl\">\n          <button\n            type=\"button\"\n            onClick={() => onTabChange('chat')}\n            className={`relative z-10 flex h-8 items-center rounded-full px-5 text-[13px] font-semibold transition-colors duration-200 ${\n              activeTab === 'chat'\n                ? 'text-[var(--btn-primary-ink)]'\n                : 'text-[var(--text-muted)] hover:text-[var(--text)]'\n            }`}\n          >\n            {activeTab === 'chat' ? (\n              <motion.div\n                layoutId=\"hark-active-tab\"\n                transition={{ type: 'spring', stiffness: 500, damping: 35 }}\n                className=\"absolute inset-0 rounded-full bg-[var(--btn-primary-bg)] shadow-sm\"\n              />\n            ) : null}\n            <span className=\"relative z-10\">Chat</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => onTabChange('projects')}\n            className={`relative z-10 flex h-8 items-center rounded-full px-5 text-[13px] font-semibold transition-colors duration-200 ${\n              activeTab === 'projects'\n                ? 'text-[var(--btn-primary-ink)]'\n                : 'text-[var(--text-muted)] hover:text-[var(--text)]'\n            }`}\n          >\n            {activeTab === 'projects' ? (\n              <motion.div\n                layoutId=\"hark-active-tab\"\n                transition={{ type: 'spring', stiffness: 500, damping: 35 }}\n                className=\"absolute inset-0 rounded-full bg-[var(--btn-primary-bg)] shadow-sm\"\n              />\n            ) : null}\n            <span className=\"relative z-10\">Projects</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Top Right: Search Pill + Circular Avatar */}\n      <div className=\"pointer-events-auto flex items-center gap-3\">\n        <button\n          type=\"button\"\n          onClick={onSearchClick}\n          className=\"flex h-9 items-center gap-2 rounded-full bg-[var(--card)] border border-[var(--border)] px-4 text-[13px] font-medium text-[var(--text-muted)] shadow-[var(--shadow)] backdrop-blur-xl transition-all duration-200 hover:text-[var(--text)] hover:scale-105 active:scale-95\"\n        >\n          <Search size={14} strokeWidth={1.75} />\n          <span>Search</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={onProfileClick}\n          aria-label=\"User Profile & Settings\"\n          className=\"flex h-9 w-9 items-center justify-center rounded-full bg-[var(--card)] border border-[var(--border)] overflow-hidden shadow-[var(--shadow)] backdrop-blur-xl transition-all duration-200 hover:scale-105 active:scale-95\"\n        >\n          <div className=\"flex h-full w-full items-center justify-center bg-[color-mix(in_srgb,var(--text)_12%,transparent)] text-[13px] font-bold text-[var(--text)]\">\n            N\n          </div>\n        </button>\n      </div>\n    </header>\n  );\n}\n\nexport default HarkTopChrome;\n","Overwrite":true,"Path":"/home/nasbombz/Documents/Projects/vigil-agent/web/src/components/hark/HarkTopChrome.tsx"}}]}
