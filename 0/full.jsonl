elp to see available options.\"\n207:             exit 1\n208:             ;;\n209:     esac\n210: done\n211: \n212: # ------------------------------------------------------------------------------\n213: # Process Management & Cleanup\n214: # ------------------------------------------------------------------------------\n215: PIDS=()\n216: CLEANING_UP=false\n217: \n218: kill_recursive() {\n219:     local parent=\"$1\"\n220:     local children\n221:     children=$(pgrep -P \"$parent\" 2>/dev/null || true)\n222:     for child in $children; do\n223:         kill_recursive \"$child\"\n224:     done\n225:     if kill -0 \"$parent\" 2>/dev/null; then\n226:         kill -TERM \"$parent\" 2>/dev/null || true\n227:     fi\n228: }\n229: \n230: cleanup() {\n231:     # Guard against multiple executions\n232:     if [[ \"$CLEANING_UP\" == true ]]; then\n233:         return\n234:     fi\n235:     CLEANING_UP=true\n236:     trap - SIGINT SIGTERM EXIT\n237: \n238:     echo \"\"\n239:     log_info \"Shutting down Vigil services...\"\n240: \n241:     # Gracefully stop all recorded processes and their children\n242:     for pid in \"${PIDS[@]}\"; do\n243:         kill_recursive \"$pid\"\n244:     done\n245: \n246:     # Allow up to 2 seconds for graceful shutdown\n247:     local waited=0\n248:     while [[ $waited -lt 4 ]]; do\n249:         local any_running=false\n250:         for pid in \"${PIDS[@]}\"; do"}
