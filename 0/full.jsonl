{"step_index":193,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T09:59:27Z","content":"Created At: 2026-11-11T09:59:27Z\nCompleted At: 2026-11-11T09:59:27Z\nShowing lines 20-80 of 113\n20:       refetchOnWindowFocus: false,\n21:       staleTime: 10_000,\n22:     },\n23:   },\n24: });\n25: \n26: function AppShell() {\n27:   return (\n28:     <div className=\"relative min-h-dvh\">\n29:       <HeaderBrand />\n30:       <FloatingDock />\n31: \n32:       <div id=\"main\">\n33:         <Outlet />\n34:       </div>\n35: \n36:       {IS_MOCK ? (\n37:         <div className=\"fixed bottom-0 left-0 right-0 z-50 bg-[var(--accent)] px-3 py-1 text-center text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--accent-ink)]\">\n38:           Simulation mode, no backend\n39:         </div>\n40:       ) : null}\n41:     </div>\n42:   );\n43: }\n44: \n45: /**\n46:  * The shell must never render unauthenticated. A 401 anywhere lands here exactly once, because\n47:  * `setAuthFailureHandler` is debounced per token in `lib/api.ts`. The landing page at `/` stays\n48:  * public: unpaired visitors read it, paired users are sent straight to `/agent`.\n49:  */\n50: function AuthGate({ children }: { children: ReactNode }) {\n51:   const status = useSession((state) => state.status);\n52:   const hydrate = useSession((state) => state.hydrate);\n53:   const expire = useSession((state) => state.expire);\n54:   const location = useLocation();\n55: \n56:   useEffect(() => {\n57:     setAuthFailureHandler(() => expire());\n58:     void hydrate(() => api.me());\n59:     return () => setAuthFailureHandler(null);\n60:   }, [hydrate, expire]);\n61: \n62:   if (status === 'loading') {\n63:     return (\n64:       <div className=\"flex min-h-dvh items-center justify-center\">\n65:         <span className=\"text-[13px] text-[var(--text-muted)]\">Connecting...</span>\n66:       </div>\n67:     );\n68:   }\n69: \n70:   if (status === 'unauthed') {\n71:     if (location.pathname === '/pair' || location.pathname === '/') return <>{children}</>;\n72:     return <Navigate to=\"/pair\" replace state={{ from: location.pathname }} />;\n73:   }\n74: \n75:   if (location.pathname === '/pair') {\n76:     return <Navigate to=\"/agent\" replace />;\n77:   }\n78: \n79:   // The landing stays reachable for everyone, paired or not, so `Log in` can always be linked.\n80:   return <>{children}</>;"}
