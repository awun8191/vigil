{"step_index":373,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:14:29Z","content":"Created At: 2026-11-11T10:14:29Z\nCompleted At: 2026-11-11T10:14:29Z\nShowing lines 180-272 of 272\n180:         *HUMAN_TOOLS,\n181:         *TASK_TOOLS,\n182:         *SKILL_TOOLS,\n183:         *EXA_TOOLS,\n184:         *BROWSER_TOOLS,\n185:     )\n186: )\n187: \n188: \n189: \n190: def get_tool(name: str) -> Tool:\n191:     \"\"\"Return the tool with this name. A missing name raises ``KeyError``.\"\"\"\n192:     try:\n193:         return TOOLS[name]\n194:     except KeyError:\n195:         raise KeyError(f\"unknown tool: {name!r}\") from None\n196: \n197: \n198: async def invoke_tool(\n199:     name: str,\n200:     arguments: Mapping[str, Any],\n201:     context: ToolContext,\n202: ) -> ToolResult:\n203:     \"\"\"Call a tool by name. An unknown name returns a failed result.\"\"\"\n204:     tool = TOOLS.get(name)\n205:     if tool is None:\n206:         return ToolResult.failure(f\"unknown tool: {name!r}\")\n207:     return await tool.invoke(arguments, context)\n208: \n209: \n210: def openai_tool_declarations(names: Sequence[str] | None = None) -> list[dict[str, Any]]:\n211:     \"\"\"Return tools in the OpenAI `tools` wire shape.\n212: \n213:     The provider expects `{\"type\": \"function\", \"function\": {...}}`. Passing the\n214:     internal declaration shape straight through makes the model believe it has\n215:     no tools at all, and it answers \"I cannot run commands\".\n216: \n217:     Args:\n218:         names: Tool names to include. ``None`` includes the whole registry.\n219: \n220:     Returns:\n221:         One declaration per tool, ready for the request payload.\n222:     \"\"\"\n223:     selected = (\n224:         list(names) if names is not None\n225:         else list(TOOLS.keys())\n226:     )\n227:     declarations: list[dict[str, Any]] = []\n228:     for name in selected:\n229:         tool = TOOLS.get(name)\n230:         if tool is None:\n231:             continue\n232:         declarations.append(\n233:             {\n234:                 \"type\": \"function\",\n235:                 \"function\": {\n236:                     \"name\": tool.name,\n237:                     \"description\": tool.description,\n238:                     \"parameters\": dict(tool.input_schema),\n239:                 },\n240:             }\n241:         )\n242:     return declarations\n243: \n244: \n245: def tool_definitions() -> list[dict[str, Any]]:\n246:     \"\"\"Return the tool declarations for the model prompt.\"\"\"\n247:     return [\n248:         {\n249:             \"name\": tool.name,\n250:             \"description\": tool.description,\n251:             \"parameters\": tool.input_schema,\n252:             \"level\": tool.level,\n253:         }\n254:         for tool in TOOLS.values()\n255:     ]\n256: \n257: \n258: __all__ = [\n259:     \"APPROVAL_LEVELS\",\n260:     \"ApprovalLevel\",\n261:     \"Handler\",\n262:     \"TOOLS\",\n263:     \"TOOL_COUNT\",\n264:     \"Tool\",\n265:     \"ToolContext\",\n266:     \"ToolResult\",\n267:     \"build_registry\",\n268:     \"get_tool\",\n269:     \"openai_tool_declarations\",\n270:     \"invoke_tool\",\n271:     \"tool_definitions\",\n272: ]"}
