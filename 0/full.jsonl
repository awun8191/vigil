)\n47:     async def get_me(\n48:         device: DeviceDTO = Depends(get_current_device),\n49:         user: UserDTO = Depends(get_current_user),\n50:     ) -> AuthMeResponse:\n51:         return AuthMeResponse(\n52:             device_id=device.id,\n53:             device_name=device.name,\n54:             user_id=user.id,\n55:             user_display_name=user.display_name,\n56:             created_at=user.created_at,\n57:             last_seen_at=device.last_seen_at,\n58:         )\n59: \n60:     @router.post(\n61:         \"/revoke\",\n62:         response_model=RevokeDeviceResponse,\n63:         status_code=status.HTTP_200_OK,\n64:         summary=\"Revoke Device Token\",\n65:         description=\"Revoke an existing device token to permanently disable its access.\",\n66:     )\n67:     async def revoke_device(\n68:         payload: RevokeDeviceRequest,\n69:         service: AuthRepository = Depends(get_auth_service),\n70:         _device: DeviceDTO = Depends(get_current_device),\n71:     ) -> RevokeDeviceResponse:\n72:         await service.revoke_device(payload.device_id)\n73:         return RevokeDeviceResponse(\n74:             device_id=payload.device_id,\n75:             revoked=True,\n76:             revoked_at=datetime.now(timezone.utc),\n77:         )\n78: \n79:     return router"}
