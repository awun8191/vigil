{"step_index":606,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T10:43:09Z","content":"Created At: 2026-11-11T10:43:09Z\nCompleted At: 2026-11-11T10:43:09Z\nShowing lines 45-75 of 159\n45:     settings: Settings = app.state.settings\n46:     logger = get_logger(\"vigil.lifespan\")\n47:     logger.info(\"Starting Vigil application\", app_env=settings.APP_ENV, port=settings.PORT)\n48: \n49:     # Output startup ASCII QR code and device pairing code in development/production\n50:     if settings.APP_ENV != \"test\":\n51:         try:\n52:             from src.modules.auth.service import AuthService\n53:             auth_service = AuthService(session=None, settings=settings)  # type: ignore[arg-type]\n54:             pairing_code = await auth_service.generate_startup_pairing_code()\n55:             pair_url = f\"vigil://pair?code={pairing_code}&server=http://localhost:{settings.PORT}\"\n56: \n57:             import io\n58:             import qrcode\n59:             qr = qrcode.QRCode()\n60:             qr.add_data(pair_url)\n61:             qr.make()\n62:             buf = io.StringIO()\n63:             qr.print_ascii(out=buf)\n64:             qr_ascii = buf.getvalue()\n65: \n66:             logger.info(\"============================================================\")\n67:             logger.info(\"VIGIL DEVICE PAIRING READY\")\n68:             logger.info(f\"Temporary Pairing Code: {pairing_code}\")\n69:             logger.info(f\"Pairing URL: {pair_url}\")\n70:             logger.info(f\"\\n{qr_ascii}\")\n71:             logger.info(\"Scan QR code or enter pairing code in mobile app to pair.\")\n72:             logger.info(\"============================================================\")\n73:         except Exception as exc:\n74:             logger.warning(\"Failed to render startup pairing QR code\", error=str(exc))\n75: "}
