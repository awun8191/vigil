\n145:     }\n146:   }, [sessionId]);\n147: \n148:   const clearOptimisticFlag = useCallback(\n149:     (id: string) => {\n150:       const target = sessionIdRef.current;\n151:       if (!target) return;\n152:       queryClient.setQueryData<StreamMessage[]>(messagesKey(target), (current) =>\n153:         current ? current.map((m) => (m.id === id ? { ...m, local_state: undefined } : m)) : current,\n154:       );\n155:     },\n156:     [queryClient],\n157:   );\n158: \n159:   // The reply lands here: the run_completed frame payload carries the final text directly\n160:   // (loop.py `{\"content\": final}`), falling back to the last thought text. A failed or\n161:   // cancelled run marks the optimistic user message instead of inventing a reply.\n162:   useEffect(() => {\n163:     if (!activeRunId || finalisedRunId === activeRunId) return;\n164:     const terminal = [...steps]\n165:       .reverse()\n166:       .find((s) => s.event_type === 'run_completed' || s.event_type === 'run_failed');\n167:     if (!run || !terminal || !['completed', 'failed'].includes(run.status)) return;\n168: \n169:     setFinalisedRunId(activeRunId);\n170:     const target = sessionIdRef.current;\n171:     const optimisticId = optimisticIdRef.current;\n172: \n173:     const appendAnswer = (patch: Partial<StreamMessage>) => {\n174:       if (!target) return;\n175:       const answer: StreamMessage = {\n176:         id: `local-run-${activeRunId}`,\n177:         session_id: target,\n178:         role: 'assistant',\n179:         content: '',\n180:         created_at: new Date().toISOString(),\n181:         run_id: activeRunId,\n182:         ...patch,\n183:       };\n184:       if (!answer.content && !answer.local_state) return;\n185:       queryClient.setQueryData<StreamMessage[]>(messagesKey(target), (current) =>\n186:         current ? [...current, answer] : [answer],\n187:       );\n188:     };\n189: \n190:     if (run.status === 'completed') {\n191:       const finalContent =\n192:         typeof terminal.payload['content'] === 'string' && terminal.payload['content'].length > 0\n193:           ? (terminal.payload['content'] as string)\n194:           : (([...steps]\n195:               .reverse()\n196:               .find(\n197:                 (s) =>\n198:                   s.event_type === 'thought' &&\n199:                   typeof s.payload['content'] === 'string' &&\n200:                   s.payload['content'].length > 0,"}
