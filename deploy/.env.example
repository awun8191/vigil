# =============================================================================
# Virgil Proactive Assistant & Execution Harness - Environment Configuration
# Copy this file to .env and customize secrets before starting deployment.
# =============================================================================

# --- Application & Server ---
APP_NAME=Virgil
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 16 with pgvector extension) ---
POSTGRES_DB=virgil
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/virgil
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Cryptography & Security ---
# Master secret key for AES-256-GCM credential encryption (must be 32 bytes or 64 hex characters)
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PAIRING_CODE_TTL_SECONDS=300
DEVICE_TOKEN_SECRET=virgil-device-token-secret-change-in-production
CORS_ORIGINS=["*"]

# --- Tiered Model Architecture ---
# Tier 1: Jev Fast Decision Classifier (binary signal: IGNORE vs TRIAGE)
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-classifier-v1

# Tier 2: Fast LLM (Triage Stage 2 metadata extractor & Compaction summarizer)
FAST_LLM_BASE_URL=https://api.openai.com/v1
FAST_LLM_API_KEY=
FAST_LLM_MODEL=gpt-4o-mini

# Tier 3: Reasoning LLM (Agent event loop execution & complex multi-step synthesis)
REASONING_LLM_BASE_URL=https://api.openai.com/v1
REASONING_LLM_API_KEY=
REASONING_LLM_MODEL=gpt-4o

# Local Embedding Model (bge-small-en-v1.5, int8 ONNX, offline at inference time)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL_DIR=~/.cache/virgil/embedding

# --- Docker Execution Sandbox ---
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=virgil-sandbox:latest
WORKSPACE_BASE_PATH=/var/virgil/workspaces

# --- Structured Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Idempotency & Concurrency ---
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_HEADER_NAME=Idempotency-Key

# --- Background Worker & Job Queue ---
JOB_POLL_INTERVAL_SECONDS=5
JOB_LOCK_TIMEOUT_SECONDS=300

# --- Notifications Subsystem (Unified Push / ntfy) ---
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=virgil-notifications
NTFY_AUTH_TOKEN=
